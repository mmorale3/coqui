namespace methods {
  namespace solvers {

    /*
     * Direct (hamiltonian-route) static build: V_H and/or exact-exchange K
     * from the current density matrix via hamilt::Vhartree / hamilt::Vexchange
     *
     * Contract identical to the THC/Cholesky overloads: sF_skij is
     * zero-initialized and receives ONLY the requested static terms; K is
     * SIGNED (F = H0 + V_H + K); the gygi finite-size correction is the
     * shared, route-free HF_K_correction (notes/static_route_gygi_note.md).
     * Dm_skij is the same array the ERI overloads consume — route
     * equivalence holds for identical input by I7.
     */
    template<nda::MemoryArray AF_t>
    void hf_t::evaluate(sArray_t<AF_t> &sF_skij, const nda::MemoryArrayOfRank<4> auto &Dm_skij,
                        Hamilt_ERI auto &&heval, const nda::MemoryArrayOfRank<4> auto &S_skij,
                        bool hartree, bool exchange) {
      auto MF = heval.MF();
      auto mpi = heval.mpi();
      auto& comm = mpi->comm;

      long ns = MF->nspin();
      long nkpts_ibz = MF->nkpts_ibz();
      long nbnd = MF->nbnd();
      utils::check(Dm_skij.extent(0) == ns and Dm_skij.extent(1) == nkpts_ibz and
                   Dm_skij.extent(2) == nbnd and Dm_skij.extent(3) == nbnd,
                   "hamilt-hf: Shape mismatch: Dm_skij");
      utils::check(sF_skij.shape()[1] == nkpts_ibz, "hamilt-hf: Shape mismatch: sF_skij");
      utils::check(S_skij.extent(1) == nkpts_ibz, "hamilt-hf: Shape mismatch: S_skij");
      utils::check(MF->npol() == 1, "hamilt-hf: only npol == 1 is supported.");

      sF_skij.set_zero();
      if (not hartree and not exchange) return;

      app_log(2, "Evaluation of J/K matrix (direct hamiltonian route)\n");

      _Timer.start("TOTAL");
      auto* psp = heval.psp();
      auto& psi = heval.psi(comm);
      nda::range k_rng(nkpts_ibz), b_rng(nbnd);

      // Normalize the density matrix to a concrete owning array: the
      // pseudopot::add_Hartree/add_exchange member templates are explicitly
      // instantiated (pseudopot.cpp) for the owning-array density type, not
      // for every shm-view flavor reaching this overload. One O(ns·nk·nbnd²)
      // copy per call — negligible next to the FFT work.
      nda::array<ComplexType,4> Dm_copy(Dm_skij);

      // Accumulate a distributed (s,k,i,j) result into sF_skij: the disjoint
      // local blocks land in a zeroed temp shm window (disjoint also within a
      // node), the windows are summed across nodes, and node roots add into
      // sF — mirroring the scf_loop hartree/exchange slot composition.
      auto add_dist = [&](auto const& dV) {
        auto sT = math::shm::make_shared_array<AF_t>(
            *sF_skij.communicator(), *sF_skij.internode_comm(),
            *sF_skij.node_comm(), sF_skij.shape());
        sT.set_zero();
        sT.win().fence();
        auto loc = sT.local();
        loc(dV.local_range(0), dV.local_range(1), dV.local_range(2), dV.local_range(3))
            += dV.local();
        sT.win().fence();
        sT.all_reduce();
        if (sF_skij.node_comm()->root())
          sF_skij.local() += sT.local();
        sF_skij.communicator()->barrier();
      };

      if (hartree) {
        _Timer.start("HARTREE");
        auto dJ = hamilt::Vhartree<HOST_MEMORY>(*MF, comm, psp, psi, Dm_copy,
                                                k_rng, b_rng);
        add_dist(dJ);
        _Timer.stop("HARTREE");
      }
      if (exchange) {
        _Timer.start("EXCHANGE");
        auto dK = hamilt::Vexchange<HOST_MEMORY>(*MF, comm, psp, psi, Dm_copy,
                                                 k_rng, b_rng);
        add_dist(dK);   // K is SIGNED: F = H0 + V_H + K
        HF_K_correction(sF_skij, Dm_skij, S_skij, MF->madelung());
        _Timer.stop("EXCHANGE");
      }
      _Timer.stop("TOTAL");
    }

  } // solvers
} // methods
