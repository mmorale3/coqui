#ifndef COQUI_VERTEX_DYNBSE_ICC
#define COQUI_VERTEX_DYNBSE_ICC

/**
 * scGW-tilde Tier 2, FULL FREQUENCY: the resummed DYNAMIC-rung BSE polarization in the ladder's
 * pair space (notes/dynbse_plan.md D0.1; the algebra in dynbse.hpp, increment D1; this file is
 * increment D2: the production driver, its THC rung operator and the gates).
 *
 * THE OBJECT (plan section 1), per external (q, inu), pair r = (a nc + b), a on the k line, b on
 * the k+q line, D = nc^2 nk, one right-hand side per secondary aux index N:
 *
 *   Gamma_N(k,iw) = d_N(k) + sum_{k'} (1/beta) sum_{iw'} K_s+d(k' <- k; iw - iw') L0(k',iw') Gamma_N(k',iw')
 *   P_MN(q,inu)   = (spin/nk) sum_k conj(d_M(k))^T [ (1/beta) sum_iw L0(k,iw) Gamma_N(k,iw) ]
 *
 * with the rung split K = K_s + K_d: K_s = sign_ks * Kbig / nk the STATIC (W0bar) rung of
 * pair_space_ladder in exactly its twist-packed orientation (Kbig[(k'),(k)] maps the L0-output
 * pair (p1'p3) at k to the L0-input pair (p1 p3') at k'), K_d(inu') = the same THC contraction
 * with W_dyn(inu') - W_dyn(0) (the cache _Wb_qwmm) in place of W0bar, applied in tau
 * (plan section 4). sign_ks = -1 is the DERIVED sign (memory l2-resolvent-sign-finding: the
 * house bubble +spin/nk D^dag Cb D and the anchor -spin/nk^2 D^dag Cb K Cb D force the rung -W);
 * sign_ks = +1 reproduces the as-implemented L2 resolvent up to an overall sign of the rung part.
 *
 * The static part is resummed exactly (one dense LU per unit, T_s = K_s (1 - Cb K_s)^-1, the L2
 * solve) and the dynamic remainder is solved by GMRES(m) / Neumann on
 * (1 - K_d L_s) y = K_d L_s d (dynbse.hpp). Output columns (rungs >= 1, i.e. minus the bubble):
 * static (the sign-corrected L2), the one bare dynamic rung D^dag L0 K_d L0 D (the Pi^C anchor's
 * dynamic part), Gamma_1 (one dynamic rung dressed by static ladders) and the resummed vertex.
 *
 * NOSYM full mesh only at D2 (the external and transfer meshes coincide); the (s, q) units are
 * round-robined over (rank, nproc) and every (jn, iq) cell is written by exactly one rank, so the
 * caller's zeros-elsewhere all_reduce reproduces the replicated result (the pair_space_ladder
 * contract). The k-sum of the rung is the direct gemm form at D2 (the FFT is the D2b' optimization;
 * the gemm path stays as its machine-precision cross-check).
 */

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <map>
#include <memory>
#include <optional>
#include <random>
#include <string>

#include "methods/vertex/dynbse.hpp"
#include "utilities/omp_threads.hpp"
#include <mpi.h>
#if defined(ENABLE_FFTW)
#include "numerics/fft/fftw.h"
#include "methods/vertex/vertex_sigma_dyn.icc"   // LFF-Sigma L-7: the Sigma hook of the dynamic-rung solver
#endif

namespace methods {
namespace solvers {

  namespace vertex_dynbse_detail {

    using cplx = ComplexType;
    namespace db = dynbse;

    struct dyn_opts {
      double tol = 1e-8;          // relative residual on the dynamic remainder
      long maxit = 30;            // operator applications
      long gmres_m = 6;           // 0 = plain Neumann
      bool one_rung_only = false; // T_s = 0 and one application: the pure one dynamic rung
      bool gamma1_only = false;   // stop at the first iterate (Gamma_1); skip the resummation GMRES
      double sign_ks = -1.0;      // K = sign_ks * (THC rung) / nk  (-1 = the derived sign)
      bool static_only = false;   // no dynamic solve: the static column only (gate G-A)
      bool union_nodes = false;   // G's residues on the half-spacing-SHIFTED grid (no node coincides
                                  // with a vertex node: no confluent product, no re-expansion table;
                                  // D2e finding) -- false = the shared aux grid with Dsq/Dcb (inu = 0 only)
      double readout_tol = 0.0;   // GMRES: stop when the physical readout D^dag Gsum moves by less than this
                                  // per cycle (0 = off); the criterion blind to readout-invisible modes
      long rhs_block = 0;         // solve the Nm right-hand-side columns in blocks of this width (0 = all at
                                  // once): the Krylov basis (m + 1 tf_vectors of width nR) is the memory
                                  // driver; each block converges to tol independently (differences at tol)
      std::string dump_prefix;    // when non-empty: every finished unit's four (Nm x Nm) blocks are appended to
                                  // "<dump_prefix>.r<rank>.bin" and units found in ANY such file at entry are
                                  // loaded instead of solved (a restart after a walltime kill loses nothing)
      MPI_Comm sched_comm = MPI_COMM_NULL;           // when set: DYNAMIC scheduling of the (s, q, nu) units through
                                                     // a shared task counter (one-sided MPI on rank 0), longest
                                                     // units first; MPI_COMM_NULL = static round-robin
      nda::array<double, 2> const *kcrys = nullptr;  // (nk, 3) crystal coordinates of the k mesh: when given
                                                     // (and ksum_ft), the rung's k-sum runs through kmesh_ft
      bool ksum_ft = true;
      double vmask_lo = 0.0, vmask_hi = 0.0;   // the in-gap vertex-node mask (pol_vertex_dyn_vmask), active when hi > lo
      bool wannier_pairs = false; // W-int-0/1: the outputs are the Wannier-PAIR polarization Pi_loc(q) (nout = nc^2)
                                  // instead of the aux frame (Nm). The inputs G_CC / Xb are then ALREADY in the MLWF
                                  // frame (ladder_inputs: G_bar = U^dag G U; the rotated secondary collocation X_bar
                                  // = X U, nc = M), so the external legs are the IDENTITY on the (a, b) pair labels --
                                  // the mesh-independent frame for coarse->fine interpolation
                                  // (notes/wannier_coarse_vertex_plan.md). W-int-0 put U on the legs of band-frame
                                  // inputs, which mixed frames for any non-degenerate U (W-int-1 finding).
      double tfold = 0.0;         // the small-nu fold ratio (pol_vertex_dyn_tfold): T_a with |eps_a| >= tfold |nu| folded into U
      int table_mode = 0;         // inu != 0 twisted-pair tables: 0 = fitted on the dense tau grid (default), 1 = the
                                  // exact partial fractions through Dsq (1/nu-amplified; the diagnostic route)
      long union_stride = 1;      // union grid: keep every union_stride-th shifted G node (plus the last); the
                                  // inu != 0 L0 cost scales as ng (1 + 2 (np_fit + ng)) -> stride 2 is ~5x cheaper
                                  // IF G still fits (node_pole_fit error reported as the G fit; gate it)
      bool dense_rung = true;     // the DENSE per-tau rung (2026-09-13): K_d(s) = build_kbig(W_d(s)) on the PH-sym
                                  // half of the tau nodes (nt/2 x D x D per unit, 5.4 GB at Si 4^3/8) and every
                                  // application = nt (D x D)(D x nR) gemms (compute-bound) instead of the THC
                                  // pair-space streaming (memory-bound: ~180 GB of traffic per application on Si)
      std::vector<long> const *q_subset = nullptr;   // evaluate only these transfers (all q when null);
                                                     // the outputs keep the full q axis (zeros elsewhere)
      // LFF-Sigma L-7 (vertex_sigma_dyn.icc): when non-null, every unit also contracts its amputated vertex
      // A = K_s Gsum + y into the self-energy accumulators of the hook (the solvers then keep their y iterates)
      sigma_dyn_hook *sigma = nullptr;
      double gap_mask = 0.0;      // union scheme: DROP the G nodes with |eps| < gap_mask (Ha, relative to
                                  // mu = 0 of the pole variable). A gapped G has no spectral weight there;
                                  // the DLR fit's O(1) in-gap residues (T15 lesson) otherwise feed a loop
                                  // through the near-confluent double-pole products at inu != 0 (gain
                                  // ~1/gap: measured Ritz 2.6 on lih222 at the first node). 0 = no mask.
      // LFF-aux L-0 (notes/lff_aux_plan.md): the WINDOW BUBBLE column. When Pi_bub is non-null every unit also writes
      // Pi_bub(jn, iq, M, N) = (spin/nk) [D^dag Cb D](M, N) -- the C-window pair bubble in the output frame, the object
      // the dumped "rungs >= 1" columns are corrections TO (the reference of the multiplicative local-field factor).
      // bubble_only = true evaluates ONLY that column: no rung (no Kbig / K_d(s) / resolvent), no solve, no unit dump;
      // the other outputs stay zero. ~1 s per unit.
      nda::array<cplx, 4> *Pi_bub = nullptr;
      bool bubble_only = false;
    };


    /**
     * D2f: a VERTEX-LOCAL imaginary-axis grid for the dynamic pair algebra. The loop's DLR precision
     * ("low" = 1e-6 on the Si runs) is what the small-nu twisted algebra inherits: at beta = 1000 the
     * union scheme at the first bosonic node converges to the dense oracle (2e-6, 25 applications) at
     * prec "high" and stalls at a 3e-2 residual floor at prec "low" (dynbse_small_nu_1000). With prec
     * non-empty the pair algebra runs on IAFT(beta, wmax, dlr, prec): G_CC is interpolated onto the
     * finer tau grid through the loop's DLR (exact to the loop's class), W(inu) keeps the LOOP's
     * bosonic labels (the cut's nodes) and reaches the vertex tau nodes through Ttw_v = T Ttw_loop,
     * the pair bubbles come back to the loop's inu through Twt_v = Twt_loop R. Empty prec = the loop.
     */
    struct dyn_tools_holder {
      std::unique_ptr<imag_axes_ft::IAFT> ftv;
      std::unique_ptr<vertex_pi::iaft_tools> tools;
    };
    inline dyn_tools_holder make_dyn_tools(imag_axes_ft::IAFT const &ft, std::string const &prec,
                                           nda::array<ComplexType, 5> &G_CC) {
      dyn_tools_holder h;
      if (prec.empty()) {
        h.tools = std::make_unique<vertex_pi::iaft_tools>(ft);
        return h;
      }
      h.ftv = std::make_unique<imag_axes_ft::IAFT>(ft.beta(), ft.wmax(), imag_axes_ft::dlr_basis, prec);
      vertex_pi::iaft_tools tl(ft);
      h.tools = std::make_unique<vertex_pi::iaft_tools>(*h.ftv);
      auto &tv = *h.tools;
      const long nt_l = tl.nt_f, nt_v = tv.nt_f;
      nda::array<ComplexType, 2> T(nt_v, nt_l), R(nt_l, nt_v);
      T() = ft.construct_tau_interpolate_matrix(h.ftv->tau_mesh());     // values(tau_loop) -> values(tau_v)
      R() = h.ftv->construct_tau_interpolate_matrix(ft.tau_mesh());     // values(tau_v)    -> values(tau_loop)
      {
        const long ns = G_CC.shape(1), nk = G_CC.shape(2), nc = G_CC.shape(3);
        utils::check(G_CC.shape(0) == nt_l, "make_dyn_tools: G_CC tau extent {} != loop nt {}.", G_CC.shape(0), nt_l);
        auto G2 = nda::reshape(G_CC, std::array<long, 2>{nt_l, ns * nk * nc * nc});
        nda::array<ComplexType, 2> Gv2(nt_v, ns * nk * nc * nc);
        nda::blas::gemm(T, G2, Gv2);
        nda::array<ComplexType, 5> Gv(nt_v, ns, nk, nc, nc);
        Gv() = nda::reshape(Gv2, std::array<long, 5>{nt_v, ns, nk, nc, nc});
        G_CC = std::move(Gv);
      }
      tv.nw_b = tl.nw_b;
      tv.wn_b = tl.wn_b;
      tv.m0 = tl.m0;
      tv.w_mirror_b = tl.w_mirror_b;
      nda::array<ComplexType, 2> Ttw(nt_v, tl.nw_b), Twt(tl.nw_b, nt_v);
      nda::blas::gemm(T, tl.Ttw_bb, Ttw);
      nda::blas::gemm(tl.Twt_bb, R, Twt);
      tv.Ttw_bb = std::move(Ttw);
      tv.Twt_bb = std::move(Twt);
      app_log(1, "  [dynbse] vertex-local imaginary-axis grid: prec \"{}\" (loop \"{}\"): tau nodes {} -> {}, "
                 "bosonic labels kept from the loop ({} nodes)", prec, ft.prec(), nt_l, nt_v, tl.nw_b);
      return h;
    }

    struct dyn_meter {
      double fit_err_G = 0.0, rr_G = 0.0;     // aux-grid pole fits of G
      double dsq_err = 0.0;                   // the confluent re-expansion tables
      double refit_err_max = 0.0;             // tau refit inside K_d
      double wtau_sym = 0.0;                  // max |W_d(s) - W_d(beta - s)| / max |W_d|
      double ritz_max = 0.0;                  // watchdog: max over units of |Ritz(K_d L_s)| / contraction
      long it_max = 0, it_sum = 0, nunits = 0, nconv = 0;
      double t_setup = 0.0, t_kbig = 0.0, t_cb = 0.0, t_lu = 0.0, t_solve = 0.0, t_read = 0.0;
      double t_rung = 0.0, t_refit = 0.0;   // inside the solve: the rung applications (all tau nodes), the tau refits
      double t_l0 = 0.0, t_ts = 0.0, t_orth = 0.0;   // the L0 pole algebra, the static-resolvent gemms, the Arnoldi dots
      long n_apps = 0;                      // K_d applications (all units, all blocks)
      double rss_max_gb = 0.0;
      bool ksum_ft = false;         // the rung's k-sum ran through the mesh Fourier transform
      nda::array<double, 2> unit_diag;   // per unit (nunits_all x 12): is iq m apps conv stag rconv |Ritz| refit shift-fit
                                         // shift-cond last-readout-step; zeros for units restored from the dump
      void reduce(boost::mpi3::communicator &comm) {
        if (unit_diag.size() > 0) comm.all_reduce_in_place_n(unit_diag.data(), unit_diag.size(), std::plus<>{});
        auto mx = [&](double &v) { v = comm.all_reduce_value(v, boost::mpi3::max<>{}); };
        auto sm = [&](long &v) { v = comm.all_reduce_value(v, std::plus<>{}); };
        mx(fit_err_G); mx(rr_G); mx(dsq_err); mx(refit_err_max); mx(wtau_sym); mx(ritz_max);
        it_max = comm.all_reduce_value(it_max, boost::mpi3::max<>{});
        sm(it_sum); sm(nunits); sm(nconv);
        mx(t_setup); mx(t_kbig); mx(t_cb); mx(t_lu); mx(t_solve); mx(t_read); mx(rss_max_gb);
        mx(t_rung); mx(t_refit); sm(n_apps); mx(t_l0); mx(t_ts); mx(t_orth);
      }
    };

    /**
     * The THC rung applied to a pair-space block F (nk, nc2, nR) at fixed (is, iq):
     *   out(k', (p1 p3'), N) = (scale) sum_k sum_PQ X(k',P,p1) conj(X(k'+q,Q,p3')) W_PQ(qx_of(k,k'))
     *                           sum_{p1' p3} conj(X(k,P,p1')) F(k,(p1'p3),N) X(k+q,Q,p3)
     * with W(q') supplied by `Wq(iq')` -> a (Nm x Nm) view. Exactly pair_space_ladder's Kbig
     * orientation (row k', column k; the rung read at qx_of(k, k')). Direct k-sum by gemms
     * (per (P,Q) a (nk x nk)(nk x nb) product after a gather through qx_of); N in blocks of nb.
     */
    template<class WqFn>
    inline void thc_rung_apply(nda::array<cplx, 4> const &Xb, long is, long iq,
                               nda::array<long, 2> const &kpq, nda::array<long, 2> const &qx_of,
                               WqFn &&Wq, cplx scale, nda::MemoryArrayOfRank<3> auto const &F,
                               nda::MemoryArrayOfRank<3> auto &&out, long nb) {
      decltype(nda::range::all) all;
      const long nk = F.shape(0), nc2 = F.shape(1), nR = F.shape(2), Nm = Xb.shape(2);
      const long nc = Xb.shape(3);
      utils::check(nc * nc == nc2, "thc_rung_apply: pair dimension mismatch.");
      nb = std::max(1l, std::min(nb, nR));
      out() = cplx(0.0);
      nda::array<cplx, 2> Xc(Nm, nc), Xkq(Nm, nc), XkT(nc, Nm), Xcq(Nm, nc);
      nda::array<cplx, 2> Fk(nc, nc * nb);           // (p1', (p3 N))
      nda::array<cplx, 2> A(Nm, nc * nb);            // (P, (p3 N))
      nda::array<cplx, 2> A2(Nm * nb, nc);           // ((P N), p3)
      nda::array<cplx, 2> Y2(Nm * nb, Nm);           // ((P N), Q)
      nda::array<cplx, 4> Y(Nm, Nm, nk, nb), Z(Nm, Nm, nk, nb);
      nda::array<cplx, 2> Wm(nk, nk), Zk(Nm, Nm * nb), B(nc, Nm * nb), B2(nc * nb, Nm), O2(nc * nb, nc);
      for (long n0 = 0; n0 < nR; n0 += nb) {
        const long nbl = std::min(nb, nR - n0);
        // ---- legs in: Y(P, Q, k, N) ----------------------------------------------------------
        for (long k = 0; k < nk; ++k) {
          const long kq = kpq(iq, k);
          for (long P = 0; P < Nm; ++P)
            for (long a = 0; a < nc; ++a) {
              Xc(P, a) = std::conj(Xb(is, k, P, a));
              Xkq(P, a) = Xb(is, kq, P, a);
            }
          for (long p1p = 0; p1p < nc; ++p1p)
            for (long p3 = 0; p3 < nc; ++p3)
              for (long n = 0; n < nbl; ++n) Fk(p1p, p3 * nb + n) = F(k, p1p * nc + p3, n0 + n);
          if (nbl < nb)
            for (long p1p = 0; p1p < nc; ++p1p)
              for (long p3 = 0; p3 < nc; ++p3)
                for (long n = nbl; n < nb; ++n) Fk(p1p, p3 * nb + n) = cplx(0.0);
          nda::blas::gemm(Xc, Fk, A);                                    // (P, (p3 N))
          for (long P = 0; P < Nm; ++P)
            for (long n = 0; n < nb; ++n)
              for (long p3 = 0; p3 < nc; ++p3) A2(P * nb + n, p3) = A(P, p3 * nb + n);
          nda::blas::gemm(A2, nda::transpose(Xkq), Y2);                  // ((P N), Q)
          for (long P = 0; P < Nm; ++P)
            for (long Q = 0; Q < Nm; ++Q)
              for (long n = 0; n < nb; ++n) Y(P, Q, k, n) = Y2(P * nb + n, Q);
        }
        // ---- the k-sum with the rung: Z(P, Q, k', N) = sum_k W_PQ(qx_of(k, k')) Y(P, Q, k, N) ----
        for (long P = 0; P < Nm; ++P)
          for (long Q = 0; Q < Nm; ++Q) {
            for (long kp = 0; kp < nk; ++kp)
              for (long k = 0; k < nk; ++k) Wm(kp, k) = Wq(qx_of(k, kp))(P, Q);
            nda::blas::gemm(Wm, Y(P, Q, all, all), Z(P, Q, all, all));
          }
        // ---- legs out: out(k', (p1 p3'), N) = scale sum_PQ X(k',P,p1) Z(P,Q,k',N) conj(X(k'+q,Q,p3')) --
        for (long kp = 0; kp < nk; ++kp) {
          const long kq = kpq(iq, kp);
          for (long P = 0; P < Nm; ++P)
            for (long a = 0; a < nc; ++a) {
              XkT(a, P) = Xb(is, kp, P, a);
              Xcq(P, a) = std::conj(Xb(is, kq, P, a));
            }
          for (long P = 0; P < Nm; ++P)
            for (long Q = 0; Q < Nm; ++Q)
              for (long n = 0; n < nb; ++n) Zk(P, Q * nb + n) = Z(P, Q, kp, n);
          nda::blas::gemm(XkT, Zk, B);                                   // (p1, (Q N))
          for (long p1 = 0; p1 < nc; ++p1)
            for (long n = 0; n < nb; ++n)
              for (long Q = 0; Q < Nm; ++Q) B2(p1 * nb + n, Q) = B(p1, Q * nb + n);
          nda::blas::gemm(B2, Xcq, O2);                                  // ((p1 N), p3')
          for (long p1 = 0; p1 < nc; ++p1)
            for (long p3p = 0; p3p < nc; ++p3p)
              for (long n = 0; n < nbl; ++n) out(kp, p1 * nc + p3p, n0 + n) = scale * O2(p1 * nb + n, p3p);
        }
      }
    }

    /**
     * The k-mesh Fourier transform of the rung's k-sum (2026-09-12). On the full nosym mesh the k-sum
     *   Z(k') = sum_k W(k - k') Y(k)
     * is a circular convolution on the abelian group of the mesh, so with the characters
     *   U(R, k) = exp(-2 pi i m_k . m_R / n)   (m = integer mesh coordinates, R labeled by the same set)
     * it is Z = U^-1 [ A (.) (U Y) ],  A(R) = sum_q exp(+2 pi i m_q . m_R / n) W(q),  U^-1 = conj(U)/nk.
     * Two dense (nk x nk) gemms on (nk x Nm^2 nb) blocks replace the Nm^2 tiny (nk x nk)(nk x nb) gemms
     * and their gathers of thc_rung_apply (nk^2 -> nk log nk is not the point at nk = 64: the point is
     * ONE gemm-efficient contraction instead of Nm^2 overhead-bound ones). The mesh dimensions are
     * inferred from the crystal coordinates; build() verifies unitarity and the convolution identity
     * against the direct sum on random data (1e-10) and reports `ok` -- the driver falls back to the
     * direct sum otherwise.
     */
    struct kmesh_ft {
      long nk = 0;
      nda::array<cplx, 2> U;        // (R, k): forward, unnormalized
      nda::array<cplx, 2> Uinv;     // (k, R): conj(U)^T / nk
      nda::array<cplx, 2> Uq;       // (R, q): exp(+2 pi i m_q . m_R / n) -- the transform of the rung
      bool ok = false;
      double check = -1.0;          // the convolution identity residual of build()
      // the FFT route (2026-09-12): mesh dimensions and the lexicographic row index of every k / q
      // (m1 n2 + m2) n3 + m3, so the three-dimensional FFT over the mesh replaces the dense U/Uinv
      // (nk log nk instead of nk^2 per column). fft = false falls back to the dense transform.
      int ndim[3] = {0, 0, 0};
      nda::array<long, 1> lex_k, lex_q;
      bool fft = false;
      void build(nda::array<double, 2> const &kcrys, nda::array<long, 2> const &kmq, nda::array<long, 2> const &kpq) {
        decltype(nda::range::all) all;
        nk = kcrys.shape(0);
        const long nq = kmq.shape(0);
        ok = false;
        if (nq != nk or kcrys.shape(1) != 3) return;
        // mesh dimensions per direction from the distinct fractional coordinates
        long n[3];
        nda::array<long, 2> mk(nk, 3);
        for (int a = 0; a < 3; ++a) {
          std::vector<double> v;
          for (long k = 0; k < nk; ++k) {
            double x = kcrys(k, a) - std::floor(kcrys(k, a));
            if (x > 1.0 - 1e-8) x = 0.0;
            bool found = false;
            for (double y : v) if (std::abs(x - y) < 1e-8) { found = true; break; }
            if (not found) v.push_back(x);
          }
          n[a] = long(v.size());
          for (long k = 0; k < nk; ++k) {
            double x = kcrys(k, a) - std::floor(kcrys(k, a));
            if (x > 1.0 - 1e-8) x = 0.0;
            const double m = x * double(n[a]);
            if (std::abs(m - std::round(m)) > 1e-6) return;      // not a Gamma-centered uniform mesh
            mk(k, a) = long(std::round(m)) % n[a];
          }
        }
        if (n[0] * n[1] * n[2] != nk) return;
        // the transfer q_x's integer coordinates from k - kmq(q_x, k) (any k; use k = 0)
        nda::array<long, 2> mq(nq, 3);
        for (long iqx = 0; iqx < nq; ++iqx) {
          const long k2 = kmq(iqx, 0);
          for (int a = 0; a < 3; ++a) mq(iqx, a) = ((mk(0, a) - mk(k2, a)) % n[a] + n[a]) % n[a];
        }
        for (int a = 0; a < 3; ++a) ndim[a] = int(n[a]);
        lex_k = nda::array<long, 1>(nk);
        lex_q = nda::array<long, 1>(nq);
        {
          std::vector<char> seen(size_t(nk), 0);
          for (long k = 0; k < nk; ++k) {
            lex_k(k) = (mk(k, 0) * n[1] + mk(k, 1)) * n[2] + mk(k, 2);
            seen[size_t(lex_k(k))] = 1;
          }
          for (long q = 0; q < nq; ++q) lex_q(q) = (mq(q, 0) * n[1] + mq(q, 1)) * n[2] + mq(q, 2);
          bool all = true;
          for (char c : seen) all = all and (c != 0);
#if defined(ENABLE_FFTW)
          fft = all;
#else
          fft = false;
#endif
        }
        U = nda::array<cplx, 2>(nk, nk);
        Uinv = nda::array<cplx, 2>(nk, nk);
        Uq = nda::array<cplx, 2>(nk, nq);
        for (long R = 0; R < nk; ++R) {
          for (long k = 0; k < nk; ++k) {
            double ph = 0.0;
            for (int a = 0; a < 3; ++a) ph += double(mk(k, a) * mk(R, a)) / double(n[a]);
            const cplx e = std::exp(cplx(0.0, -2.0 * M_PI * ph));
            U(R, k) = e;
            Uinv(k, R) = std::conj(e) / double(nk);
          }
          for (long q = 0; q < nq; ++q) {
            double ph = 0.0;
            for (int a = 0; a < 3; ++a) ph += double(mq(q, a) * mk(R, a)) / double(n[a]);
            Uq(R, q) = std::exp(cplx(0.0, 2.0 * M_PI * ph));
          }
        }
        // self-check: the convolution identity on random data against the direct sum
        nda::array<long, 2> qx_of(nk, nk);
        qx_of() = -1;
        for (long iqx = 0; iqx < nq; ++iqx)
          for (long ik = 0; ik < nk; ++ik) qx_of(ik, kmq(iqx, ik)) = iqx;
        for (long ik = 0; ik < nk; ++ik)
          for (long ikp = 0; ikp < nk; ++ikp) if (qx_of(ik, ikp) < 0) return;
        const long nc_t = 3;
        nda::array<cplx, 2> Y(nk, nc_t), Wq(nq, 1), Zd(nk, nc_t), Yh(nk, nc_t), Zf(nk, nc_t), A(nk, 1);
        std::mt19937_64 gen(7);
        std::uniform_real_distribution<double> ur(-1.0, 1.0);
        for (auto &v : Y) v = cplx(ur(gen), ur(gen));
        for (auto &v : Wq) v = cplx(ur(gen), ur(gen));
        for (long kp = 0; kp < nk; ++kp)
          for (long c = 0; c < nc_t; ++c) {
            cplx acc(0.0);
            for (long k = 0; k < nk; ++k) acc += Wq(qx_of(k, kp), 0) * Y(k, c);
            Zd(kp, c) = acc;
          }
        nda::blas::gemm(U, Y, Yh);
        nda::blas::gemm(Uq, Wq, A);
        for (long R = 0; R < nk; ++R)
          for (long c = 0; c < nc_t; ++c) Yh(R, c) *= A(R, 0);
        nda::blas::gemm(Uinv, Yh, Zf);
        double d = 0.0, sc = 0.0;
        for (long k = 0; k < nk; ++k)
          for (long c = 0; c < nc_t; ++c) { d = std::max(d, std::abs(Zf(k, c) - Zd(k, c))); sc = std::max(sc, std::abs(Zd(k, c))); }
        check = (sc > 0.0) ? d / sc : d;
        ok = (check < 1e-10);
        (void)kpq;
      }
    };

    /** thc_rung_apply with the k-sum done by the mesh Fourier transform (see kmesh_ft): identical
     *  contraction, out(k', (p1 p3'), N) = scale sum_k sum_PQ X(k',P,p1) conj(X(k'+q,Q,p3')) W_PQ(k-k')
     *  sum_{p1' p3} conj(X(k,P,p1')) F(k,(p1'p3),N) X(k+q,Q,p3).
     *  Layout (2026-09-12): the k-sum buffers hold (k | R, (P n Q)) so that every intermediate of the
     *  leg gemms is a plain reinterpretation -- A(P, (n p3)) = A2((P n), p3), Y2((P n), Q) = one
     *  contiguous row, Z row (P, (n Q)) feeds the leg-out gemm directly, B(p1, (n Q)) = B2((p1 n), Q) --
     *  no transposes of the (Nm x Nm x nb) blocks (they dominated the wall: memory traffic, not flops). */
    template<class WqFn>
    inline void thc_rung_apply_ft(nda::array<cplx, 4> const &Xb, long is, long iq,
                                  nda::array<long, 2> const &kpq, kmesh_ft const &kft,
                                  WqFn &&Wq, cplx scale, nda::MemoryArrayOfRank<3> auto const &F,
                                  nda::MemoryArrayOfRank<3> auto &&out, long nb) {
      decltype(nda::range::all) all;
      const long nk = F.shape(0), nc2 = F.shape(1), nR = F.shape(2), Nm = Xb.shape(2);
      const long nc = Xb.shape(3), nq = kft.Uq.shape(1);
      utils::check(nc * nc == nc2 and kft.ok and kft.nk == nk, "thc_rung_apply_ft: mesh transform not usable.");
      nb = std::max(1l, std::min(nb, nR));
      out() = cplx(0.0);
      const long M = Nm * nb * Nm;                                   // (P n Q)
      nda::array<cplx, 2> Xc(Nm, nc), XkqT(nc, Nm), XkT(nc, Nm), Xcq(Nm, nc);
      nda::array<cplx, 2> Fk(nc, nb * nc);                            // (p1', (n p3))
      nda::array<cplx, 2> A(Nm, nb * nc);                             // (P, (n p3)) == A2((P n), p3)
      nda::array<cplx, 2> Yk(nk, M), Yh(nk, M);                       // (k | R, (P n Q))
      nda::array<cplx, 2> Wall(nq, Nm * Nm), Ah(nk, Nm * Nm);          // the rung at all q, and its transform
      nda::array<cplx, 2> B(nc, nb * Nm);                             // (p1, (n Q)) == B2((p1 n), Q)
      nda::array<cplx, 2> O2(nc * nb, nc);                            // ((p1 n), p3')
      auto row = [&](long k) { return kft.fft ? kft.lex_k(k) : k; };
      // the rung's transform A(R, (P Q)) once per call (the same for every N block)
      for (long q = 0; q < nq; ++q) {
        auto W = Wq(q);
        const long rq = kft.fft ? kft.lex_q(q) : q;
        for (long P = 0; P < Nm; ++P)
          for (long Q = 0; Q < Nm; ++Q) Wall(rq, P * Nm + Q) = W(P, Q);
      }
#if defined(ENABLE_FFTW)
      math::fft::fftplan_t plan_w, plan_y;
      if (kft.fft) {
        const int nd[3] = {kft.ndim[0], kft.ndim[1], kft.ndim[2]};
        const int Mw = int(Nm * Nm), My = int(M);
#pragma omp critical(coqui_dynbse_fftw_plan)
        {   // FFTW planning is not thread-safe (execution is): the tau nodes run in parallel
          plan_w = math::fft::impl::host::create_plan_many_impl_(3, nd, Mw, Wall.data(), nd, Mw, 1, Ah.data(), nd, Mw, 1,
                                                                  math::fft::FFT_ESTIMATE);
          plan_y = math::fft::impl::host::create_plan_many_impl_(3, nd, My, Yk.data(), nd, My, 1, Yh.data(), nd, My, 1,
                                                                  math::fft::FFT_ESTIMATE);
        }
        math::fft::impl::host::invfft(plan_w, Wall.data(), Ah.data());     // A(R) = sum_q e^{+i q.R} W(q)
      } else
#endif
      nda::blas::gemm(kft.Uq, Wall, Ah);
      const cplx inv_nk = kft.fft ? cplx(1.0 / double(nk)) : cplx(1.0);
      auto A2 = nda::reshape(A, std::array<long, 2>{Nm * nb, nc});     // ((P n), p3): the same memory as A
      auto B2 = nda::reshape(B, std::array<long, 2>{nc * nb, Nm});     // ((p1 n), Q): the same memory as B
      for (long n0 = 0; n0 < nR; n0 += nb) {
        const long nbl = std::min(nb, nR - n0);
        // ---- legs in: Yk(k, (P n Q)) -------------------------------------------------------------
        for (long k = 0; k < nk; ++k) {
          const long kq = kpq(iq, k);
          for (long P = 0; P < Nm; ++P)
            for (long a = 0; a < nc; ++a) {
              Xc(P, a) = std::conj(Xb(is, k, P, a));
              XkqT(a, P) = Xb(is, kq, P, a);
            }
          for (long p1p = 0; p1p < nc; ++p1p)
            for (long n = 0; n < nb; ++n)
              for (long p3 = 0; p3 < nc; ++p3) Fk(p1p, n * nc + p3) = (n < nbl) ? F(k, p1p * nc + p3, n0 + n) : cplx(0.0);
          nda::blas::gemm(Xc, Fk, A);                                    // (P, (n p3))
          auto Yrow = nda::reshape(Yk(row(k), all), std::array<long, 2>{Nm * nb, Nm});   // ((P n), Q)
          nda::blas::gemm(A2, XkqT, Yrow);                               // ((P n), Q) = sum_p3 A2 X(k+q, Q, p3)
        }
        // ---- the k-sum: Yh = U Yk; Yh(R, P n Q) *= A(R, P Q); Yk = Uinv Yh ---------------------
#if defined(ENABLE_FFTW)
        if (kft.fft) math::fft::impl::host::fwdfft(plan_y, Yk.data(), Yh.data());
        else
#endif
        nda::blas::gemm(kft.U, Yk, Yh);
        for (long R = 0; R < nk; ++R)
          for (long P = 0; P < Nm; ++P)
            for (long n = 0; n < nb; ++n) {
              cplx *y = &Yh(R, (P * nb + n) * Nm);
              const cplx *a = &Ah(R, P * Nm);
              for (long Q = 0; Q < Nm; ++Q) y[Q] *= a[Q] * inv_nk;
            }
#if defined(ENABLE_FFTW)
        if (kft.fft) math::fft::impl::host::invfft(plan_y, Yh.data(), Yk.data());   // unnormalized backward
        else
#endif
        nda::blas::gemm(kft.Uinv, Yh, Yk);                               // Yk now holds Z(k', (P n Q))
        // ---- legs out ------------------------------------------------------------------------------
        for (long kp = 0; kp < nk; ++kp) {
          const long kq = kpq(iq, kp);
          for (long P = 0; P < Nm; ++P)
            for (long a = 0; a < nc; ++a) {
              XkT(a, P) = Xb(is, kp, P, a);
              Xcq(P, a) = std::conj(Xb(is, kq, P, a));
            }
          auto Zrow = nda::reshape(Yk(row(kp), all), std::array<long, 2>{Nm, nb * Nm});  // (P, (n Q))
          nda::blas::gemm(XkT, Zrow, B);                                 // (p1, (n Q))
          nda::blas::gemm(B2, Xcq, O2);                                  // ((p1 n), p3')
          for (long p1 = 0; p1 < nc; ++p1)
            for (long p3p = 0; p3p < nc; ++p3p)
              for (long n = 0; n < nbl; ++n) out(kp, p1 * nc + p3p, n0 + n) = scale * O2(p1 * nb + n, p3p);
        }
      }
#if defined(ENABLE_FFTW)
      if (kft.fft) {
#pragma omp critical(coqui_dynbse_fftw_plan)
        {
          math::fft::impl::host::destroy_plan(plan_w);
          math::fft::impl::host::destroy_plan(plan_y);
        }
      }
#endif
    }

    /** the mean-field gap of the band window over the full BZ: (occupied max, empty min) from the
     *  occupations; the pole variable is measured from mu, and for a semiconductor mu sits inside
     *  the (wider) quasiparticle gap, so |eps| < 0.45 x this gap is spectral-weight-free. */
    template<class MFT>
    inline std::pair<double, double> window_mf_gap(MFT const &MF, nda::range bw) {
      double ev = -1e300, ec = 1e300;
      const long ns = MF->nspin(), nk = MF->nkpts();
      for (long is = 0; is < ns; ++is)
        for (long ik = 0; ik < nk; ++ik)
          for (long n = bw.first(); n < bw.last(); ++n) {
            const double e = MF->eigval(is, ik, n), o = MF->occ(is, ik, n);
            if (o > 0.5) ev = std::max(ev, e); else ec = std::min(ec, e);
          }
      return {ev, ec};
    }

    /** the static rung Kbig (D x D) of pair_space_ladder, nosym, for (is, iq): Kbig(ikp nc2 + (p1 nc + p3'),
     *  ik nc2 + (p1' nc + p3)) = [U1^T W0b(qx_of(ik, ikp)) U2](p1 nc + p1', p3 nc + p3'). */
    inline void build_kbig(nda::array<cplx, 4> const &Xb, nda::MemoryArrayOfRank<3> auto const &W0b, long is, long iq,
                           nda::array<long, 2> const &kpq, nda::array<long, 2> const &qx_of,
                           nda::MemoryArrayOfRank<2> auto &&Kbig, vertex_sym::sym_ctx const *symc = nullptr) {
      // IBZ symmetry (mirrors vertex_ladder::pair_space_ladder's rung read): the internal (ik, ikp)
      // run over the FULL BZ; with an active symc the transfer's rung is read from the IBZ-stored W0b
      // at q_star(iqx) -- PQ-TRANSPOSED for a time-reversal transfer -- and the four legs use the
      // effective (rotation + trev-conj) columns Xhat via build_U_legs with jsym = q_isym(iqx). With
      // symc == nullptr this is bitwise the historic nosym expression (jsx = 0, qsx = iqx, no transpose).
      decltype(nda::range::all) all;
      const long nk = kpq.shape(1), Nm = Xb.shape(2), nc = Xb.shape(3), nc2 = nc * nc;
      const bool sym = (symc != nullptr and symc->active);
      nda::array<cplx, 2> U1(Nm, nc2), U2(Nm, nc2), WU2(Nm, nc2), wb(nc2, nc2);
      Kbig() = cplx(0.0);
      for (long ik = 0; ik < nk; ++ik) {
        const long ikpq = kpq(iq, ik);
        for (long ikp = 0; ikp < nk; ++ikp) {
          const long iqx = qx_of(ik, ikp);
          const long ikppq = kpq(iq, ikp);
          const long jsx = sym ? symc->q_isym(iqx) : 0l;
          const long qsx = sym ? symc->q_star(iqx) : iqx;
          const bool trx = sym ? bool(symc->q_trev(iqx)) : false;
          vertex_pi::detail::build_U_legs(Xb, symc, nda::range(0, nc), is, ik, ikp, ikpq, ikppq, jsx, U1, U2);
          if (trx)
            nda::blas::gemm(nda::transpose(W0b(qsx, all, all)), U2, WU2);
          else
            nda::blas::gemm(W0b(qsx, all, all), U2, WU2);
          nda::blas::gemm(nda::transpose(U1), WU2, wb);
          for (long p1 = 0; p1 < nc; ++p1)
            for (long p1p = 0; p1p < nc; ++p1p)
              for (long p3 = 0; p3 < nc; ++p3)
                for (long p3p = 0; p3p < nc; ++p3p)
                  Kbig(ikp * nc2 + (p1 * nc + p3p), ik * nc2 + (p1p * nc + p3)) = wb(p1 * nc + p1p, p3 * nc + p3p);
        }
      }
    }

    /** the tau-route chi0 of the ladder (A.4 block) at bosonic node m: Cb(k, (p1'p3), (ab)) */
    inline void build_cb_tau(nda::MemoryArrayOfRank<5> auto const &G_CC, vertex_pi::iaft_tools const &tools,
                             long is, long iq, long m, nda::array<long, 2> const &kpq,
                             nda::array<cplx, 3> &Cb) {
      const long nt = G_CC.shape(0), nk = G_CC.shape(2), nc = G_CC.shape(3), nc2 = nc * nc;
      nda::array<cplx, 2> Pf(nt, nc2 * nc2), Bf(tools.nw_b, nc2 * nc2);
      for (long ik = 0; ik < nk; ++ik) {
        const long ikpq = kpq(iq, ik);
        for (long s = 0; s < nt; ++s) {
          const long sm = tools.t_mirror(s);
          for (long p1p = 0; p1p < nc; ++p1p)
            for (long p3 = 0; p3 < nc; ++p3)
              for (long a = 0; a < nc; ++a)
                for (long b = 0; b < nc; ++b)
                  Pf(s, (p1p * nc + p3) * nc2 + (a * nc + b)) = G_CC(sm, is, ik, a, p1p) * G_CC(s, is, ikpq, p3, b);
        }
        nda::blas::gemm(cplx(-1.0), tools.Twt_bb, Pf, cplx(0.0), Bf);
        for (long r = 0; r < nc2; ++r)
          for (long c = 0; c < nc2; ++c) Cb(ik, r, c) = Bf(m, r * nc2 + c);
      }
    }

    /**
     * THE DRIVER. Outputs (nnu, nq, Nm, Nm), any may be null; all are ZEROED here and indexed by
     * position in nu_list; every (jn, iq) cell written by exactly one rank (the caller all-reduces).
     *   Pi_static : the static ladder, rungs >= 1  ( (spin/nk) D^dag [Cb Gamma_s - Cb D] )
     *   Pi_dyn1   : the one bare dynamic rung        ( (spin/nk) D^dag [sum_iw L0 K_d L0 D] )
     *   Pi_gam1   : the first iterate, rungs >= 1
     *   Pi_dyn    : the resummed vertex, rungs >= 1
     * Wbh = the cache _Wb_qwmm (nq, nw_half, Nm, Nm): W_dyn on the positive half mesh.
     */
    inline void pair_space_ladder_dyn(nda::MemoryArrayOfRank<5> auto const &G_CC,    // (nt,ns,nk,nc,nc)
                                      nda::array<cplx, 4> const &Xb,                 // (ns,nk,Nm,nc)
                                      nda::array<cplx, 3> const &W0b,                // (nq,Nm,Nm)
                                      nda::array<cplx, 4> const &Wbh,                // (nq,nw_half,Nm,Nm)
                                      nda::array<long, 2> const &kmq, nda::array<long, 2> const &kpq,
                                      vertex_pi::iaft_tools &tools, std::vector<long> const &nu_list,
                                      nda::array<cplx, 4> *Pi_static, nda::array<cplx, 4> *Pi_dyn1,
                                      nda::array<cplx, 4> *Pi_gam1, nda::array<cplx, 4> *Pi_dyn,
                                      long rank, long nproc, dyn_opts const &opt, dyn_meter *met,
                                      vertex_sym::sym_ctx const *symc = nullptr) {
      decltype(nda::range::all) all;
      vertex_ladder_detail::prof_watch watch;
      const bool sym = (symc != nullptr and symc->active);
      const bool wan = opt.wannier_pairs;   // W-int-0/1: Wannier-pair output frame (inputs already MLWF-rotated)
      const long nt = G_CC.shape(0), ns = G_CC.shape(1), nk = G_CC.shape(2), nc = G_CC.shape(3);
      const long Nm = Xb.shape(2), nc2 = nc * nc, D = nc2 * nk;
      const long nout = wan ? nc2 : Nm;                     // external-leg / output dimension (aux Nm, or Wannier pair)
      const long nq = W0b.shape(0), nw_b = tools.nw_b;
      const long nw_half = (nw_b % 2 == 0) ? nw_b / 2 : nw_b / 2 + 1;
      utils::check(not sym or opt.dense_rung, "pair_space_ladder_dyn: IBZ symmetry currently requires the dense rung "
                   "(the streaming/THC rung's symmetric q_star read is not wired yet).");
      const long nnu = long(nu_list.size());
      const double spinfac = (ns == 1) ? 2.0 : 1.0;
      if (sym) {
        // symmetric mesh: outputs / W caches carry nq_ibz (= nq), while kmq/kpq carry the FULL transfer
        // mesh (nq_full) so the internal k-sums reach every transfer (mapped to q_star for the rung read).
        utils::check(nq == symc->nq_ibz and kmq.shape(0) == symc->nq_full and kpq.shape(0) == symc->nq_full and
                     kmq.shape(1) == nk and symc->nk_full == nk,
                     "pair_space_ladder_dyn: symmetry mesh mismatch (nq_w = {}, nq_ibz = {}, kmq {} x {}, nq_full = {}).",
                     nq, symc->nq_ibz, kmq.shape(0), kmq.shape(1), symc->nq_full);
      } else {
        utils::check(kmq.shape(0) == nq and kpq.shape(0) == nq and kmq.shape(1) == nk,
                     "pair_space_ladder_dyn: nosym mesh expected (nq_w = {}, kmq {} x {}).", nq, kmq.shape(0), kmq.shape(1));
      }
      utils::check(Wbh.shape(0) == nq and Wbh.shape(1) == nw_half and Wbh.shape(2) == Nm and Wbh.shape(3) == Nm,
                   "pair_space_ladder_dyn: W cache shape ({}, {}, {}, {}) != ({}, {}, {}, {}).",
                   Wbh.shape(0), Wbh.shape(1), Wbh.shape(2), Wbh.shape(3), nq, nw_half, Nm, Nm);
      utils::check(nt == tools.nt_f, "pair_space_ladder_dyn: G tau axis {} != nt_f {}.", nt, tools.nt_f);
      for (auto *o : {Pi_static, Pi_dyn1, Pi_gam1, Pi_dyn, opt.Pi_bub})
        if (o != nullptr) {
          utils::check(o->shape(0) == nnu and o->shape(1) == nq and o->shape(2) == nout and o->shape(3) == nout,
                       "pair_space_ladder_dyn: output shape mismatch (nout = {}).", nout);
          (*o)() = cplx(0.0);
        }
      utils::check(not opt.bubble_only or opt.Pi_bub != nullptr, "pair_space_ladder_dyn: bubble_only needs the Pi_bub output.");
      for (auto m : nu_list) utils::check(m >= 0 and m < nw_b, "pair_space_ladder_dyn: nu index {} out of range.", m);

      // ---- the vertex basis and G's residues --------------------------------------------------
      tools.init_poles();
      auto b = db::build_freq_basis(*tools.ft);
      // D2f: the in-gap vertex-node mask (pol_vertex_dyn_vmask = [lo, hi] relative to mu; env COQUI_DYNBSE_VMASK="lo,hi"
      // overrides for experiments)
      double vlo = opt.vmask_lo, vhi = opt.vmask_hi;
      if (char const *e = std::getenv("COQUI_DYNBSE_VMASK")) { vlo = std::atof(e); if (char const *cm = std::strchr(e, ',')) vhi = std::atof(cm + 1); }
      const bool vmasked = (vhi > vlo);
      if (vmasked) db::mask_freq_basis(b, vlo, vhi);
      const long np_fit = b.np;
      if (not vmasked) {
        utils::check(np_fit == tools.np, "pair_space_ladder_dyn: vertex basis size {} != tools.np {}.", np_fit, tools.np);
        double de = 0.0, ds = 0.0;
        for (long p = 0; p < np_fit; ++p) de = std::max(de, std::abs(b.eps(p) - tools.epsl(p)));
        for (long i = 0; i < nt; ++i) ds = std::max(ds, std::abs(b.s(i) - tools.s_phys(i)));
        utils::check(de < 1e-10 and ds < 1e-10, "pair_space_ladder_dyn: vertex basis / tools grids differ ({}, {}).", de, ds);
      }
      if (met) met->dsq_err = std::max(met->dsq_err, b.dsq_fit_err);
      // union scheme: G on the shifted grid, appended to the vertex basis (gnode0 = np_fit);
      // shared scheme: G on the vertex grid itself (gnode0 = 0)
      nda::array<double, 1> epsG;
      db::node_pole_fit npf;
      long n_masked = 0;
      nda::array<long, 1> gmap;                 // shared + mask: the G nodes' indices in the vertex grid
      if (opt.union_nodes) {
        auto all_nodes = db::shifted_nodes(b);
        std::vector<double> keep;
        const long stride = std::max(1l, opt.union_stride);
        for (long j = 0; j < all_nodes.shape(0); ++j) {
          if (std::abs(all_nodes(j)) < opt.gap_mask) { ++n_masked; continue; }
          if (vmasked and all_nodes(j) > vlo and all_nodes(j) < vhi) { ++n_masked; continue; }   // no G node inside the gap either
          if (stride > 1 and (j % stride) != 0 and j != all_nodes.shape(0) - 1) { ++n_masked; continue; }
          keep.push_back(all_nodes(j));
        }
        epsG = nda::array<double, 1>(long(keep.size()));
        for (long j = 0; j < long(keep.size()); ++j) epsG(j) = keep[size_t(j)];
        npf.build(tools.beta, b.s, epsG, 1e-8);
        db::extend_freq_basis(b, epsG);
      } else if (opt.gap_mask > 0.0) {
        // the SHARED grid without its in-gap nodes: G is refit on the kept vertex nodes
        std::vector<long> keep;
        for (long a = 0; a < np_fit; ++a) {
          if (std::abs(b.eps(a)) < opt.gap_mask) { ++n_masked; continue; }
          keep.push_back(a);
        }
        epsG = nda::array<double, 1>(long(keep.size()));
        gmap = nda::array<long, 1>(long(keep.size()));
        for (long j = 0; j < long(keep.size()); ++j) { gmap(j) = keep[size_t(j)]; epsG(j) = b.eps(keep[size_t(j)]); }
        npf.build(tools.beta, b.s, epsG, 1e-8);
      } else {
        epsG = b.eps;
      }
      const bool use_npf = opt.union_nodes or (opt.gap_mask > 0.0);
      const long ng = epsG.shape(0), np = b.np, gnode0 = opt.union_nodes ? np_fit : 0;
      nda::array<cplx, 5> gC(ns, ng, nk, nc, nc);
      {
        nda::array<cplx, 2> Fg(nt, nc2);
        for (long is = 0; is < ns; ++is)
          for (long k = 0; k < nk; ++k) {
            for (long i = 0; i < nt; ++i)
              for (long a = 0; a < nc; ++a)
                for (long bb2 = 0; bb2 < nc; ++bb2) Fg(i, a * nc + bb2) = G_CC(i, is, k, a, bb2);
            auto c = use_npf ? npf.coeffs(Fg) : db::basis_coeffs(b, Fg);
            if (met) {
              met->fit_err_G = std::max(met->fit_err_G, use_npf ? npf.fit_error(Fg, c) : db::basis_fit_error(b, Fg, c));
              double cm = 0.0, fm = 0.0;
              for (auto const &v : c) cm = std::max(cm, std::abs(v));
              for (auto const &v : Fg) fm = std::max(fm, std::abs(v));
              met->rr_G = std::max(met->rr_G, (fm > 0.0) ? cm / fm : 0.0);
            }
            for (long p = 0; p < ng; ++p)
              for (long a = 0; a < nc; ++a)
                for (long bb2 = 0; bb2 < nc; ++bb2) gC(is, p, k, a, bb2) = c(p, a * nc + bb2);
          }
      }
      if (rank == 0)
        app_log(2, "  [dynbse] node set: {} ({} vertex nodes, {} G nodes ({} in-gap nodes masked at |eps| < {:.4f} Ha), "
                   "{} total); G fit error {:.2e}, residue ratio {:.2f}",
                opt.union_nodes ? "UNION (G on the shifted grid)" : "SHARED (G on the vertex grid)", np_fit, ng, n_masked, opt.gap_mask, np,
                met ? met->fit_err_G : 0.0, met ? met->rr_G : 0.0);
      // ---- W_dyn(q', s) on the tau grid and its inu' = 0 value ---------------------------------
      // full-mesh unfold of the PH-sym half grid (the same mirror map as eval_Pi_C), then the
      // bosonic inu -> tau transform Ttw_bb (nt, nw_b); W_d(s) = W_dyn(s) (its tau form), the
      // constant part of K_d is -W_dyn(inu'=0) acting on the frequency sums.
      const long lpos0 = std::max(tools.m0, tools.w_mirror_b(tools.m0)) - nw_b / 2;
      nda::array<cplx, 4> Wd_s(nq, nt, Nm, Nm);
      nda::array<cplx, 3> Wd0(nq, Nm, Nm);
      {
        nda::array<cplx, 2> Wq(nw_b, Nm * Nm), Wt(nt, Nm * Nm);
        double dsym = 0.0, wmax = 0.0;
        for (long iqp = 0; iqp < nq; ++iqp) {
          for (long l = 0; l < nw_b; ++l) {
            const long lpos = std::max(l, tools.w_mirror_b(l)) - nw_b / 2;
            for (long P = 0; P < Nm; ++P)
              for (long Q = 0; Q < Nm; ++Q) Wq(l, P * Nm + Q) = Wbh(iqp, lpos, P, Q);
          }
          nda::blas::gemm(tools.Ttw_bb, Wq, Wt);
          for (long i = 0; i < nt; ++i)
            for (long P = 0; P < Nm; ++P)
              for (long Q = 0; Q < Nm; ++Q) Wd_s(iqp, i, P, Q) = Wt(i, P * Nm + Q);
          for (long i = 0; i < nt; ++i) {
            const long im = tools.t_mirror(i);
            for (long P = 0; P < Nm; ++P)
              for (long Q = 0; Q < Nm; ++Q) {
                dsym = std::max(dsym, std::abs(Wd_s(iqp, i, P, Q) - Wd_s(iqp, im, P, Q)));
                wmax = std::max(wmax, std::abs(Wd_s(iqp, i, P, Q)));
              }
          }
          Wd0(iqp, all, all) = Wbh(iqp, lpos0, all, all);
        }
        if (met) met->wtau_sym = std::max(met->wtau_sym, (wmax > 0.0) ? dsym / wmax : 0.0);
      }
      // ---- transfer lookup ---------------------------------------------------------------------
      nda::array<long, 2> qx_of(nk, nk);
      qx_of() = -1;
      // the transfer index spans the FULL mesh (kmq rows = nq_full; = nq on a nosym mesh). Under symmetry
      // build_kbig maps qx_of(ik, ikp) to q_star for the IBZ-stored rung read.
      for (long iqx = 0; iqx < kmq.shape(0); ++iqx)
        for (long ik = 0; ik < nk; ++ik) qx_of(ik, kmq(iqx, ik)) = iqx;
      for (long ik = 0; ik < nk; ++ik)
        for (long ikp = 0; ikp < nk; ++ikp)
          utils::check(qx_of(ik, ikp) >= 0, "pair_space_ladder_dyn: transfer mesh does not connect k = {} to k' = {}.", ik, ikp);
      if (met) met->t_setup += watch.lap();

      const cplx scale_k(opt.sign_ks / double(nk), 0.0);
      const bool keep_y = (opt.sigma != nullptr);
      if (opt.sigma != nullptr) {
        utils::check(not wan, "pair_space_ladder_dyn: the Sigma hook needs the aux-frame legs (not the Wannier-pair frame).");
        utils::check(not opt.bubble_only, "pair_space_ladder_dyn: the Sigma hook needs the solve (bubble_only set).");
        utils::check(long(nu_list.size()) == nw_b, "pair_space_ladder_dyn: the Sigma hook needs EVERY bosonic node ({} of {} given).",
                     nu_list.size(), nw_b);
        utils::check(opt.dump_prefix.empty(), "pair_space_ladder_dyn: the Sigma hook and the unit dump/restart are exclusive.");
        opt.sigma->init(nt, ns, nk, np, nc, b);
        if (rank == 0)
          app_log(1, "  [LFF-Sigma dyn] Sigma hook armed: col {}, outer W {}; accumulators (nt {}, nk {}, np {}, nc {}) x 3, {:.2f} GB per rank",
                  opt.sigma->col, opt.sigma->outer, nt, nk, np, nc, double(nt * ns * nk * nc2) * (2.0 * double(np) + 1.0) * 16.0 / 1e9);
      }
      const auto metric = db::build_tf_metric(b);       // the tau-value inner product of the solves
      const long nb = std::min(Nm, 16l);
      const long nrb = (opt.rhs_block > 0) ? std::min(opt.rhs_block, nout) : nout;   // RHS column block width
      // the mesh Fourier transform of the rung's k-sum (self-checked; direct sum otherwise)
      kmesh_ft kft;
      // the transform pays off when nk is large (the direct sum's Nm^2 tiny gemms are overhead-bound
      // at nk = 64: Si 4^3; on lih222's 8-point mesh the direct sum is 2x faster)
      if (opt.ksum_ft and opt.kcrys != nullptr and nk >= 8) kft.build(*opt.kcrys, kmq, kpq);
      const bool use_ft = kft.ok;
      if (rank == 0)
        app_log(2, "  [dynbse] rung k-sum: {} (mesh transform check {:.2e})",
                use_ft ? (kft.fft ? "mesh FFT (FFTW)" : "dense mesh Fourier transform") : "direct", kft.check);
      if (met) met->ksum_ft = use_ft;
      auto rung_apply = [&](auto &&Wfn, cplx sc, auto const &Fin, auto &&Oout, long is_, long iq_) {
        if (use_ft) thc_rung_apply_ft(Xb, is_, iq_, kpq, kft, Wfn, sc, Fin, Oout, nb);
        else thc_rung_apply(Xb, is_, iq_, kpq, qx_of, Wfn, sc, Fin, Oout, nb);
      };
      // host threads (the omp_threads knob; the global OMP_NUM_THREADS stays 1 per the T-3b contract): the
      // tau nodes of a rung application are independent; the body holds no MPI, no HDF5, no shared writes
      // (each tau writes its own Ys slice; the rung buffers are per call)
      const long nthr = std::max(1l, utils::omp_threads());
      nda::array<cplx, 2> Kbig, Ks;
      if (not opt.bubble_only) { Kbig = nda::array<cplx, 2>(D, D); Ks = nda::array<cplx, 2>(D, D); }
      nda::array<cplx, 3> Cb_k(nk, nc2, nc2);
      nda::array<cplx, 4> Dc(nk, nc, nc, nout);   // external legs: aux (Nm) or Wannier-pair (nab) columns
      // per-block scratch, sized to the current RHS block width nR (the kd operator reads F.nR)
      nda::array<cplx, 4> Dblk, CbD, Vout, Fs, Ys;
      nda::array<cplx, 3> Fs3, Os3;
      nda::array<cplx, 2> Yc2;
      long nR_cur = -1;
      auto size_scratch = [&](long nR) {
        if (nR == nR_cur) return;
        nR_cur = nR;
        Dblk = nda::array<cplx, 4>(nk, nc, nc, nR);
        CbD = nda::array<cplx, 4>(nk, nc, nc, nR);
        Vout = nda::array<cplx, 4>(nk, nc, nc, nR);
        Fs3 = nda::array<cplx, 3>(nk, nc2, nR);
        Os3 = nda::array<cplx, 3>(nk, nc2, nR);
        Fs = nda::array<cplx, 4>(nt, nk, nc2, nR);
        Ys = nda::array<cplx, 4>(nt, nk, nc2, nR);
        Yc2 = nda::array<cplx, 2>(nt, nk * nc2 * nR);
      };

      if (wan and rank == 0)
        app_log(1, "  [dynbse] Wannier-pair output: M = {} MLWFs, nout = nab = {} (identity pair legs on the MLWF-frame "
                   "inputs; aux Nm = {} used only internally for the rung)", nc, nout, Nm);
      std::vector<long> qlist;
      if (opt.q_subset != nullptr) {
        qlist = *opt.q_subset;
        for (long q : qlist) utils::check(q >= 0 and q < nq, "pair_space_ladder_dyn: q subset index {} out of range.", q);
      } else {
        for (long q = 0; q < nq; ++q) qlist.push_back(q);
      }
      const long nql = long(qlist.size());
      // the parallel unit is (s, q, nu) [2026-09-12]: with a long nu list and few transfers (the eps cuts)
      // the former (s, q) units left most ranks idle; the per-(s, q) setup below is cheap next to a solve.
      // Scheduling [2026-09-13]: with opt.sched_comm the units are handed out through a shared counter
      // (MPI_Fetch_and_op on rank 0's window) in LONGEST-FIRST order -- the nu != 0 (union-grid) units,
      // highest node first, then nu = 0 -- so the tail is one unit long instead of one round; without
      // it the static round-robin of before (bitwise the same unit list).
      const long nunits_all = ns * nql * nnu;
      std::vector<long> order(static_cast<size_t>(nunits_all), 0l);
      for (long u = 0; u < nunits_all; ++u) order[size_t(u)] = u;
      std::stable_sort(order.begin(), order.end(), [&](long a, long b) {
        const long ja = a % nnu, jb = b % nnu;
        const bool za = (nu_list[size_t(ja)] == tools.m0), zb = (nu_list[size_t(jb)] == tools.m0);
        if (za != zb) return zb;                          // nu != 0 before nu = 0
        return nu_list[size_t(ja)] > nu_list[size_t(jb)]; // then the higher node first
      });
      const bool dyn_sched = (opt.sched_comm != MPI_COMM_NULL);
      MPI_Win win = MPI_WIN_NULL;
      long *counter = nullptr;
      if (dyn_sched) {
        MPI_Win_allocate((rank == 0) ? sizeof(long) : 0, sizeof(long), MPI_INFO_NULL, opt.sched_comm, &counter, &win);
        if (rank == 0) *counter = 0;
        MPI_Win_fence(0, win);
      }
      auto next_unit = [&](long &pos) -> long {   // returns the unit index, or -1 when the list is exhausted
        if (dyn_sched) {
          const long one = 1;
          long got = 0;
          MPI_Win_lock(MPI_LOCK_SHARED, 0, 0, win);
          MPI_Fetch_and_op(&one, &got, MPI_LONG, 0, 0, MPI_SUM, win);
          MPI_Win_unlock(0, win);
          return (got < nunits_all) ? order[size_t(got)] : -1;
        }
        const long u = pos;
        pos += nproc;
        return (u < nunits_all) ? u : -1;
      };
      // ---- per-unit dump / restart --------------------------------------------------------------
      // record: 5 longs {is, iq, m, Nm, 4} + 4 x Nm^2 complex (static, dyn1, gam1, dyn; zeros when not requested)
      std::map<std::tuple<long, long, long>, std::vector<cplx>> dumped;
      std::ofstream dump_out;
      if (not opt.dump_prefix.empty()) {
        namespace fs = std::filesystem;
        const fs::path pfx(opt.dump_prefix);
        const std::string stem = pfx.filename().string() + ".r";
        const fs::path dir = pfx.parent_path().empty() ? fs::path(".") : pfx.parent_path();
        long nrec = 0;
        if (fs::exists(dir))
          for (auto const &e : fs::directory_iterator(dir)) {
            const std::string fn = e.path().filename().string();
            if (fn.rfind(stem, 0) != 0 or fn.size() < stem.size() + 4 or fn.substr(fn.size() - 4) != ".bin") continue;
            std::ifstream in(e.path(), std::ios::binary);
            while (in) {
              long hdr[5];
              if (not in.read(reinterpret_cast<char *>(hdr), sizeof(hdr))) break;
              if (hdr[3] != nout or hdr[4] != 4) break;
              std::vector<cplx> blk(static_cast<size_t>(4 * nout * nout));
              if (not in.read(reinterpret_cast<char *>(blk.data()), std::streamsize(blk.size() * sizeof(cplx)))) break;
              dumped[std::make_tuple(hdr[0], hdr[1], hdr[2])] = std::move(blk);
              ++nrec;
            }
          }
        if (rank == 0)
          app_log(1, "  [dynbse] unit dump \"{}.r*.bin\": {} finished units found (loaded, not re-solved)", opt.dump_prefix, nrec);
        dump_out.open(opt.dump_prefix + ".r" + std::to_string(rank) + ".bin", std::ios::binary | std::ios::app);
      }
      long pos = rank;
      long units_taken = 0;
      db::tfold_ratio_ref() = opt.tfold;
      if (met) { met->unit_diag = nda::array<double, 2>(nunits_all, 12); met->unit_diag() = 0.0; }
      for (long u = next_unit(pos); u >= 0; u = next_unit(pos)) {
        ++units_taken;
        const long sq = u / nnu, jn_unit = u % nnu;
        const long is = sq / nql, iq = qlist[size_t(sq % nql)];
        if (opt.Pi_bub != nullptr) {
          // LFF-aux L-0: the window bubble of this unit in the output frame, (spin/nk) D^dag Cb(q, i nu) D. The legs
          // and Cb are the unit's own (rebuilt below for the solve: cheap, and the solve path stays untouched).
          const long m_b = nu_list[size_t(jn_unit)];
          for (long k = 0; k < nk; ++k) {
            const long kq = kpq(iq, k);
            for (long a = 0; a < nc; ++a)
              for (long bb2 = 0; bb2 < nc; ++bb2)
                for (long N = 0; N < nout; ++N)
                  Dc(k, a, bb2, N) = wan ? ((N == a * nc + bb2) ? cplx(1.0) : cplx(0.0))
                                         : Xb(is, k, N, a) * std::conj(Xb(is, kq, N, bb2));
          }
          build_cb_tau(G_CC, tools, is, iq, m_b, kpq, Cb_k);
          nda::array<cplx, 4> CbDf(nk, nc, nc, nout);
          for (long k = 0; k < nk; ++k) {
            auto Ck = Cb_k(k, all, all);                                                      // (nc2, nc2)
            auto Dk = nda::reshape(Dc(k, all, all, all), std::array<long, 2>{nc2, nout});     // (nc2, nout)
            auto Ok = nda::reshape(CbDf(k, all, all, all), std::array<long, 2>{nc2, nout});
            nda::blas::gemm(Ck, Dk, Ok);
          }
          auto Pb = db::collapse(Dc, CbDf);                                                   // (nout, nout)
          for (long M = 0; M < nout; ++M)
            for (long N = 0; N < nout; ++N) (*opt.Pi_bub)(jn_unit, iq, M, N) = cplx(spinfac / double(nk)) * Pb(M, N);
          if (met) met->t_cb += watch.lap();
          if (opt.bubble_only) {
            if (met) { ++met->nunits; ++met->nconv; }
            continue;
          }
        }
        if (not dumped.empty()) {
          auto it_d = dumped.find(std::make_tuple(is, iq, nu_list[size_t(jn_unit)]));
          if (it_d != dumped.end()) {
            auto const &blk = it_d->second;
            nda::array<cplx, 4> *outs[4] = {Pi_static, Pi_dyn1, Pi_gam1, Pi_dyn};
            for (int c = 0; c < 4; ++c)
              if (outs[c] != nullptr)
                for (long M = 0; M < nout; ++M)
                  for (long N = 0; N < nout; ++N) (*outs[c])(jn_unit, iq, M, N) = blk[size_t((c * nout + M) * nout + N)];
            if (met) { ++met->nunits; ++met->nconv; }
            continue;
          }
        }
        if (rank == 0)
          app_log(2, "  [dynbse] rank 0 takes unit {} (s {}, q {}, nu node {}), its {}-th{}", u, is, iq,
                  nu_list[size_t(jn_unit)], units_taken, dyn_sched ? " (dynamic scheduling)" : "");
        // ---- the external legs of this unit: aux (window) or the MLWF pair E (Wannier, W-int-0) --------
        for (long k = 0; k < nk; ++k) {
          const long kq = kpq(iq, k);
          if (wan) {
            // W-int-1: the inputs are in the MLWF frame, so the Wannier-PAIR readout is the identity on the
            // pair labels: column N = a nc + b picks the (hole a at k, particle b at k+q) MLWF pair. For a
            // unitary U this equals W-int-0's U-leg sandwich on band-frame inputs; for an isometry (M < nW,
            // a disentangled C) it is the only consistent form (the kernel runs on the M-dim C).
            for (long a = 0; a < nc; ++a)
              for (long bb2 = 0; bb2 < nc; ++bb2)
                for (long N = 0; N < nout; ++N) Dc(k, a, bb2, N) = (N == a * nc + bb2) ? cplx(1.0) : cplx(0.0);
          } else {
            for (long a = 0; a < nc; ++a)
              for (long bb2 = 0; bb2 < nc; ++bb2)
                for (long N = 0; N < Nm; ++N) Dc(k, a, bb2, N) = Xb(is, k, N, a) * std::conj(Xb(is, kq, N, bb2));
          }
        }
        build_kbig(Xb, W0b, is, iq, kpq, qx_of, Kbig, symc);
        Ks() = Kbig * scale_k;
        if (opt.sigma != nullptr) {
          double dh = 0.0, kmx = 0.0;
          for (long i = 0; i < D; ++i)
            for (long j = 0; j < D; ++j) {
              dh = std::max(dh, std::abs(Ks(i, j) - std::conj(Ks(j, i))));
              kmx = std::max(kmx, std::abs(Ks(i, j)));
            }
          opt.sigma->ks_herm = std::max(opt.sigma->ks_herm, (kmx > 0.0) ? dh / kmx : 0.0);
          ++opt.sigma->nunits;
        }
        // the dense per-tau rungs K_d(s) (PH-symmetric: one block per mirror pair) and the constant part
        std::vector<long> trep(static_cast<size_t>(nt), -1);
        long ndist = 0;
        nda::array<cplx, 3> Kd_s;
        nda::array<cplx, 2> Kd0;
        if (opt.dense_rung) {
          std::vector<long> reps;
          for (long i = 0; i < nt; ++i) {
            const long im = tools.t_mirror(i);
            const long r0 = std::min(i, im);
            long slot = -1;
            for (long r = 0; r < long(reps.size()); ++r) if (reps[size_t(r)] == r0) { slot = r; break; }
            if (slot < 0) { slot = long(reps.size()); reps.push_back(r0); }
            trep[size_t(i)] = slot;
          }
          ndist = long(reps.size());
          Kd_s = nda::array<cplx, 3>(ndist, D, D);
          Kd0 = nda::array<cplx, 2>(D, D);
#pragma omp parallel for schedule(dynamic, 1) num_threads(nthr)
          for (long r = 0; r < ndist; ++r) {
            auto Wr = Wd_s(all, reps[size_t(r)], all, all);
            auto Kr = Kd_s(r, all, all);
            build_kbig(Xb, Wr, is, iq, kpq, qx_of, Kr, symc);
          }
          build_kbig(Xb, Wd0, is, iq, kpq, qx_of, Kd0, symc);
          if (rank == 0 and units_taken == 1)
            app_log(2, "  [dynbse] dense tau rungs: {} distinct PH-sym tau nodes of {}, {:.2f} GB per rank", ndist, nt,
                    double(ndist) * double(D) * double(D) * 16.0 / 1.0e9);
        }
        if (met) met->t_kbig += watch.lap();
        // the pair poles of this unit (shared grid: gnode identity)
        nda::array<cplx, 4> gk(ng, nk, nc, nc), gkq(ng, nk, nc, nc);
        for (long k = 0; k < nk; ++k) {
          gk(all, k, all, all) = gC(is, all, k, all, all);
          gkq(all, k, all, all) = gC(is, all, kpq(iq, k), all, all);
        }
        auto P = db::make_pair_poles(tools.beta, epsG, gk, gkq, gnode0, (gmap.size() > 0) ? &gmap : nullptr);
        const bool shared = not opt.union_nodes;
        // the dynamic rung operator of this unit
        auto Wq_s = [&](long i) { return [&, i](long iqp) { return Wd_s(iqp, i, all, all); }; };
        auto Wq_0 = [&](long iqp) { return Wd0(iqp, all, all); };
        long kd_calls = 0;
        cplx inu_cur(0.0);            // set per nu node below; the kd operator reads it
        auto kd = [&](db::tf_vector const &F, nda::array<cplx, 4> const &Fsum, db::tf_vector &y) {
          y.zero();
          double fe = 0.0;
          const long nR = F.nR;           // the RHS block width of this solve
          utils::check(nR == nR_cur and y.nR == nR and Fsum.shape(3) == nR, "pair_space_ladder_dyn: kd block width mismatch.");
          const bool nu0 = (inu_cur == cplx(0.0));
          const bool dbg = (rank == 0 and units_taken == 1);
          auto nrm = [](auto const &A) { double n = 0.0; for (auto const &v : A) n += std::norm(v); return std::sqrt(n); };
          if (dbg)
            app_log(2, "  [dynbse dbg] kd call {}: |F fam0| {:.3e} |F fam1| {:.3e} |F cst| {:.3e} |Fsum| {:.3e}",
                    kd_calls, nrm(F.fam(0, nda::ellipsis{})), nrm(F.fam(1, nda::ellipsis{})), nrm(F.cst), nrm(Fsum));
          // inu = 0: family 1 (U_j^2 at the union's G nodes, kernel KF2) joins family 0 in ONE refit;
          // inu != 0: family 1 = the twisted pairs, its own refit (the phi_nu factor rides along)
          const long nfam = nu0 ? 1 : 2;
          for (long fam = 0; fam < nfam; ++fam) {
            bool anyf = false;
            for (long ff = fam; ff < (nu0 ? 2 : fam + 1) and not anyf; ++ff)
              for (auto const &v : F.fam(ff, nda::ellipsis{})) { if (v != cplx(0.0)) { anyf = true; break; } }
            if (not anyf) continue;
            // tau values (nt, nk, nc2, nR) = KF (nt, np) . fam (np, nk nc2 nR)   [+ KF2 . fam1 at inu = 0]
            auto Fs2 = nda::reshape(Fs, std::array<long, 2>{nt, nk * nc2 * nR});
            Fs2() = cplx(0.0);
            nda::array<cplx, 2> famc(np, nk * nc2 * nR), KFc(nt, np);
            for (long ff = fam; ff < (nu0 ? 2 : fam + 1); ++ff) {
              auto fam2 = nda::reshape(F.fam(ff, nda::ellipsis{}), std::array<long, 2>{np, nk * nc2 * nR});
              famc() = fam2;
              for (long i = 0; i < nt; ++i)
                for (long p = 0; p < np; ++p) KFc(i, p) = cplx((ff == 1 and nu0) ? b.KF2(i, p) : b.KF(i, p));
              nda::blas::gemm(cplx(1.0), KFc, famc, cplx(1.0), Fs2);
            }
            vertex_ladder_detail::prof_watch kwatch;
            if (opt.dense_rung) {
              // Ys(i) = scale_k K_d(s_i) Fs(i): nt gemms (D x D)(D x nR) on the mirrored blocks
#pragma omp parallel for schedule(dynamic, 1) num_threads(nthr)
              for (long i = 0; i < nt; ++i) {
                auto Fi = nda::reshape(Fs(i, all, all, all), std::array<long, 2>{D, nR});
                auto Oi = nda::reshape(Ys(i, all, all, all), std::array<long, 2>{D, nR});
                nda::blas::gemm(scale_k, Kd_s(trep[size_t(i)], all, all), Fi, cplx(0.0), Oi);
              }
            } else {
#pragma omp parallel for schedule(dynamic, 1) num_threads(nthr)
              for (long i = 0; i < nt; ++i) {
                auto Fi = Fs(i, all, all, all);
                auto Oi = Ys(i, all, all, all);
                rung_apply(Wq_s(i), scale_k, Fi, Oi, is, iq);
              }
            }
            if (met) met->t_rung += kwatch.lap();
            auto Ys2 = nda::reshape(Ys, std::array<long, 2>{nt, nk * nc2 * nR});
            Yc2() = Ys2;
            auto c = db::basis_coeffs(b, Yc2);
            const double fef = db::basis_fit_error(b, Yc2, c);
            if (met) met->t_refit += kwatch.lap();
            fe = std::max(fe, fef);
            if (dbg)
              app_log(2, "  [dynbse dbg]   fam {}: |F(s)| {:.3e} |W F(s)| {:.3e} refit {:.3e} |coeffs| {:.3e}", fam,
                      nrm(Fs), nrm(Ys), fef, nrm(c));
            for (long p = 0; p < b.np_fit; ++p)
              for (long k = 0; k < nk; ++k)
                for (long r = 0; r < nc2; ++r)
                  for (long N = 0; N < nR; ++N) y.fam(fam, p, k, r / nc, r % nc, N) = c(p, (k * nc2 + r) * nR + N);
          }
          // the constant part: -W_dyn(0) on the frequency sums
          for (long k = 0; k < nk; ++k)
            for (long r = 0; r < nc2; ++r)
              for (long N = 0; N < nR; ++N) Fs3(k, r, N) = Fsum(k, r / nc, r % nc, N);
          if (opt.dense_rung) {
            auto F2 = nda::reshape(Fs3, std::array<long, 2>{D, nR});
            auto O2 = nda::reshape(Os3, std::array<long, 2>{D, nR});
            nda::blas::gemm(-scale_k, Kd0, F2, cplx(0.0), O2);
          } else {
            rung_apply(Wq_0, -scale_k, Fs3, Os3, is, iq);
          }
          for (long k = 0; k < nk; ++k)
            for (long r = 0; r < nc2; ++r)
              for (long N = 0; N < nR; ++N) y.cst(k, r / nc, r % nc, N) = Os3(k, r, N);
          if (dbg)
            app_log(2, "  [dynbse dbg]   -> |y fam0| {:.3e} |y fam1| {:.3e} |y cst| {:.3e}", nrm(y.fam(0, nda::ellipsis{})),
                    nrm(y.fam(1, nda::ellipsis{})), nrm(y.cst));
          ++kd_calls;
          if (met) ++met->n_apps;
          return fe;
        };
        // ---- the requested nu of this unit ---------------------------------------------------
        {
          const long jn = jn_unit;
          const long m = nu_list[jn];
          const cplx inu = (m == tools.m0) ? cplx(0.0) : cplx(tools.ft->omega(tools.wn_b(m)));
          inu_cur = inu;
          // inu != 0: the twisted-pair tables of this node (D2e); built once per (unit, nu)
          std::optional<db::shift_tables> stab;
          db::shift_tables const *stp = nullptr;
          if (inu != cplx(0.0)) {
            stab.emplace(db::build_shift_tables(b, inu, 1e-11, opt.table_mode));
            stp = std::addressof(stab.value());
            if (met) met->dsq_err = std::max(met->dsq_err, stab->fit_err);
            if (rank == 0 and units_taken == 1)
              app_log(2, "  [dynbse] shift tables at nu node {} (inu = {:.4e}i): fit err {:.3e}, kept condition {:.3e}",
                      m, inu.imag(), stab->fit_err, stab->cond_kept);
          }
          build_cb_tau(G_CC, tools, is, iq, m, kpq, Cb_k);
          if (met) met->t_cb += watch.lap();
          // the static resolvent (or T_s = 0 for the pure one-rung column)
          db::static_resolvent S;
          if (opt.one_rung_only) {
            S.D = D; S.nk = nk; S.nc = nc;
            S.Cb = nda::array<cplx, 2>(D, D);
            S.Cb() = cplx(0.0);
            for (long k = 0; k < nk; ++k)
              for (long r = 0; r < nc2; ++r)
                for (long c = 0; c < nc2; ++c) S.Cb(k * nc2 + r, k * nc2 + c) = Cb_k(k, r, c);
            S.Ts = nda::array<cplx, 2>(D, D);
            S.Ts() = cplx(0.0);
          } else {
            S = db::build_static_resolvent_from(Cb_k, Ks);
          }
          if (met) met->t_lu += watch.lap();
          // ---- the RHS column blocks: each block is an independent solve of width nR ----------
          db::dyson_result res;          // the unit's aggregate over its blocks (histories: the last block)
          long it_unit = 0;
          bool conv_unit = true, stag_unit = false, rconv_unit = false;
          double ritz_unit = 0.0, refit_unit = 0.0;
          for (long N0 = 0; N0 < nout; N0 += nrb) {
            const long N1 = std::min(nout, N0 + nrb), nR = N1 - N0;
            size_scratch(nR);
            db::solve_timers_state().reset();
            Dblk() = Dc(all, all, all, nda::range(N0, N1));
            // Cb D (the bubble's pair block) for the "rungs >= 1" subtraction
            for (long k = 0; k < nk; ++k)
              for (long r = 0; r < nc2; ++r)
                for (long N = 0; N < nR; ++N) {
                  cplx acc(0.0);
                  for (long c = 0; c < nc2; ++c) acc += Cb_k(k, r, c) * Dblk(k, c / nc, c % nc, N);
                  CbD(k, r / nc, r % nc, N) = acc;
                }
            auto readout = [&](nda::array<cplx, 4> const &Gsum, nda::array<cplx, 4> *out) {
              if (out == nullptr) return;
              Vout() = Gsum - CbD;
              auto Pblk = db::collapse(Dc, Vout);                    // (nout, nR): the full left leg (aux or Wannier pair)
              for (long M = 0; M < nout; ++M)
                for (long N = 0; N < nR; ++N) (*out)(jn, iq, M, N0 + N) = cplx(spinfac / double(nk)) * Pblk(M, N);
            };
            if (opt.static_only) {
              db::tf_vector y0(np, nk, nc, nR), Gamma(np, nk, nc, nR);
              nda::array<cplx, 4> Gsum(nk, nc, nc, nR);
              db::ls_apply(b, P, S, inu, shared, Dblk, y0, Gamma, Gsum, &Cb_k, stp);
              res = db::dyson_result{};
              res.Gsum0 = Gsum;
              res.Gsum1 = Gsum;
              res.Gsum = Gsum;
              res.converged = true;
            } else if (opt.one_rung_only) {
              res = db::solve_dyson_op(b, P, kd, S, inu, shared, Dblk, opt.tol, 1, false, &Cb_k, stp, nullptr, keep_y);
            } else if (opt.gmres_m > 0) {
              res = db::solve_dyson_gmres(b, P, kd, S, inu, shared, Dblk, opt.tol, opt.maxit, opt.gmres_m, &Cb_k, stp,
                                          &metric, opt.readout_tol, opt.gamma1_only, keep_y);
            } else {
              res = db::solve_dyson_op(b, P, kd, S, inu, shared, Dblk, opt.tol, opt.maxit, false, &Cb_k, stp, &metric, keep_y);
            }
            if (met) {
              auto const &stt = db::solve_timers_state();
              met->t_l0 += stt.t_l0; met->t_ts += stt.t_ts; met->t_orth += stt.t_orth;
            }
            it_unit = std::max(it_unit, res.iterations);
            conv_unit = conv_unit and res.converged;
            stag_unit = stag_unit or res.stagnated;
            rconv_unit = rconv_unit or res.readout_converged;
            ritz_unit = std::max(ritz_unit, res.contraction);
            refit_unit = std::max(refit_unit, res.fit_err_max);
            if (opt.sigma != nullptr) {
              // LFF-Sigma L-7: the outer W-bar of this node, then the block's deposit into the accumulators
              nda::array<cplx, 2> Wout(Nm, Nm);
              Wout() = W0b(iq, all, all);
              if (opt.sigma->outer == "dynamic") {
                const long lp = std::max(m, tools.w_mirror_b(m)) - nw_b / 2;
                for (long M = 0; M < Nm; ++M)
                  for (long N = 0; N < Nm; ++N) Wout(M, N) += Wbh(iq, lp, M, N) - Wd0(iq, M, N);
              }
              sigma_dyn_accumulate(*opt.sigma, b, P, inu, res, Ks, Dc, N0, N1, Wout, G_CC, kpq, is, iq, m, tools);
            }
            readout(res.Gsum0, Pi_static);
            if (opt.one_rung_only) {
              // Gsum1 = Cb D + sum L0 K_d L0 D  (T_s = 0): the pure one dynamic rung
              readout(res.Gsum1, Pi_dyn1);
            } else {
              readout(res.Gsum1, Pi_gam1);
              // gamma1_only: res.Gsum == res.Gsum1, so the resummed slot repeats Gamma_1 (logged by the caller)
              readout(res.Gsum, Pi_dyn);
            }
          }
          if (dump_out.is_open()) {
            const long hdr[5] = {is, iq, m, nout, 4};
            dump_out.write(reinterpret_cast<char const *>(hdr), sizeof(hdr));
            nda::array<cplx, 4> *outs[4] = {Pi_static, Pi_dyn1, Pi_gam1, Pi_dyn};
            std::vector<cplx> blk(static_cast<size_t>(4 * nout * nout), cplx(0.0));
            for (int c = 0; c < 4; ++c)
              if (outs[c] != nullptr)
                for (long M = 0; M < nout; ++M)
                  for (long N = 0; N < nout; ++N) blk[size_t((c * nout + M) * nout + N)] = (*outs[c])(jn, iq, M, N);
            dump_out.write(reinterpret_cast<char const *>(blk.data()), std::streamsize(blk.size() * sizeof(cplx)));
            dump_out.flush();
          }
          res.iterations = it_unit;
          res.converged = conv_unit;
          res.stagnated = stag_unit;
          res.readout_converged = rconv_unit;
          res.contraction = ritz_unit;
          res.fit_err_max = refit_unit;
          if (met) {
            auto row = met->unit_diag(u, nda::range::all);
            row(0) = double(is); row(1) = double(iq); row(2) = double(m); row(3) = double(res.iterations);
            row(4) = res.converged ? 1.0 : 0.0; row(5) = res.stagnated ? 1.0 : 0.0; row(6) = res.readout_converged ? 1.0 : 0.0;
            row(7) = res.contraction; row(8) = res.fit_err_max;
            row(9) = (stp != nullptr) ? stp->fit_err : 0.0; row(10) = (stp != nullptr) ? stp->cond_kept : 0.0;
            row(11) = res.readout_history.empty() ? -1.0 : res.readout_history.back();
          }
          if (rank == 0 and units_taken == 1) {
            std::string hist;
            for (double h : res.history) {
              char buf[32];
              std::snprintf(buf, sizeof(buf), " %.2e", h);
              hist += buf;
            }
            std::string rhist;
            for (double h : res.readout_history) {
              char buf[32];
              std::snprintf(buf, sizeof(buf), " %.2e", h);
              rhist += buf;
            }
            app_log(2, "  [dynbse] unit (s {}, q {}) nu node {}: {} applications (max over {} RHS blocks of {}), converged {}, "
                       "stagnated {}, readout-converged {}, watchdog {:.3e}, refit {:.3e}; last block's residuals:{}; readout "
                       "steps:{}", is, iq, m, res.iterations, (nout + nrb - 1) / nrb, nrb, res.converged, res.stagnated,
                    res.readout_converged, res.contraction, res.fit_err_max, hist, rhist);
          }
          if (met) {
            met->t_solve += watch.lap();
            met->refit_err_max = std::max(met->refit_err_max, res.fit_err_max);
            met->ritz_max = std::max(met->ritz_max, res.contraction);
            met->it_max = std::max(met->it_max, res.iterations);
            met->it_sum += res.iterations;
            ++met->nunits;
            if (res.converged or res.stagnated or res.readout_converged) ++met->nconv;   // stagnated at the refit floor / readout-converged count as done
          }
          if (met) {
            met->t_read += watch.lap();
            met->rss_max_gb = std::max(met->rss_max_gb, vertex_ladder_detail::prof_rss_gb());
          }
        }
      }
      if (dyn_sched) {
        MPI_Win_fence(0, win);
        MPI_Win_free(&win);
      }
    }

  } // namespace vertex_dynbse_detail

  /**
   * THE D2 GATES on the readout instance (nosym window mode; requires W0bar and the W-bar cache):
   *   a0_resid  : the THC rung operator with a nu'-constant W (= W0bar) vs the explicit Kbig on a
   *               random pair block -- machine class (pins the leg conjugation and the k-sum orientation);
   *   a_resid   : the static limit of the driver vs the SIGN-CORRECTED L2 resolvent
   *               pair_space_ladder(W0bar) (resolvent 1 + Xh Kt since 2026-09-11) -- 1e-12 class (same tau-route Cb, same Kbig, same legs);
   *   a_l2_diff : the same vs the as-implemented L2 (the even-order sign; O(lambda^2), reported);
   *   b_resid   : the one bare dynamic rung vs pi_c_accumulate_w(Z = 0, W_dyn - W_dyn(0)) -- fit class;
   *   herm      : |P - P^dag| / |P| of the resummed vertex; ritz / iterations / fit meters.
   */
  vertex_t::dynbse_diag vertex_t::dynbse_gate(MBState &mb_state, THC_ERI auto &thc, bool quick) {
    decltype(nda::range::all) all;
    namespace vd = vertex_dynbse_detail;
    dynbse_diag d;
    utils::check(active() and secondary(), "vertex_t::dynbse_gate: requires an ACTIVE secondary-basis vertex.");
    utils::check(not _wannier, "vertex_t::dynbse_gate: window mode only.");
    utils::check(_W0b_qmm.has_value(), "vertex_t::dynbse_gate: W0bar is absent -- build_w0 must run first.");
    utils::check(_Wb_qwmm.has_value(),
                 "vertex_t::dynbse_gate: the W-bar cache is absent -- run update_w and cache_w first.");
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    utils::check(MF->nkpts() == MF->nkpts_ibz() and MF->nqpts() == MF->nqpts_ibz(),
                 "vertex_t::dynbse_gate: nosym meshes only at D2.");
    nda::array<ComplexType, 5> G_CC;
    nda::array<long, 2> kmq, kpq;
    vertex_sym::sym_ctx const *symc = nullptr;
    ladder_inputs(mb_state, thc, G_CC, kmq, kpq, symc);
    utils::check(symc == nullptr or not symc->active, "vertex_t::dynbse_gate: nosym only.");
    const nda::array<double, 2> kc(MF->kpts_crystal());       // the mesh transform of the rung's k-sum
    auto tools_h = vd::make_dyn_tools(*_ft, _dyn_iaft_prec, G_CC);
    auto &tools = *tools_h.tools;
    const long nw_b = tools.nw_b, nk = MF->nkpts(), nq = MF->nqpts(), Nm = _Xb_skma.shape(2);
    const long nc = subspace_rank(), nc2 = nc * nc;
    const long rank = mpi->comm.rank(), size = mpi->comm.size();
    std::vector<long> nus = {tools.m0, tools.m0 + 1};
    const long nnu = long(nus.size());
    auto const &W0b = _W0b_qmm.value();
    auto const &Wbh = _Wb_qwmm.value();
    auto max_abs4 = [](nda::array<ComplexType, 4> const &A) {
      double m = 0.0;
      for (auto const &v : A) m = std::max(m, std::abs(v));
      return m;
    };
    auto rel4 = [&](nda::array<ComplexType, 4> const &A, nda::array<ComplexType, 4> const &B) {
      double dm = 0.0, sm = 0.0;
      for (long i = 0; i < long(A.size()); ++i) {
        dm = std::max(dm, std::abs(A.data()[i] - B.data()[i]));
        sm = std::max(sm, std::abs(B.data()[i]));
      }
      return (sm > 0.0) ? dm / sm : dm;
    };

    // the in-gap mask of the union scheme from the window's mean-field gap
    double gap_mask = 0.0;
    {
      auto [ev, ec] = vd::window_mf_gap(MF, _band_window);
      gap_mask = (ec > ev) ? 0.45 * (ec - ev) : 0.0;
      app_log(1, "  [D2 gate] window mean-field gap: occupied max {:.4f}, empty min {:.4f} Ha (gap {:.4f}); union G nodes "
                 "masked at |eps| < {:.4f} Ha", ev, ec, ec - ev, gap_mask);
    }
    // ---- (A0) the rung operator vs Kbig (rank 0, unit (0, 0)) --------------------------------
    {
      nda::array<long, 2> qx_of(nk, nk);
      qx_of() = -1;
      for (long iqx = 0; iqx < nq; ++iqx)
        for (long ik = 0; ik < nk; ++ik) qx_of(ik, kmq(iqx, ik)) = iqx;
      const long D = nc2 * nk;
      nda::array<ComplexType, 2> Kbig(D, D);
      vd::build_kbig(_Xb_skma, W0b, 0, 0, kpq, qx_of, Kbig);
      std::mt19937 rng(11);
      std::uniform_real_distribution<double> u(-1.0, 1.0);
      const long nR = 5;
      nda::array<ComplexType, 3> F(nk, nc2, nR), O(nk, nc2, nR);
      for (auto &v : F) v = ComplexType(u(rng), u(rng));
      auto Wq = [&](long iqp) { return W0b(iqp, all, all); };
      vd::thc_rung_apply(_Xb_skma, 0, 0, kpq, qx_of, Wq, ComplexType(1.0), F, O, 3);
      double dm = 0.0, sm = 0.0;
      for (long kp = 0; kp < nk; ++kp)
        for (long r = 0; r < nc2; ++r)
          for (long n = 0; n < nR; ++n) {
            ComplexType acc(0.0);
            for (long k = 0; k < nk; ++k)
              for (long c = 0; c < nc2; ++c) acc += Kbig(kp * nc2 + r, k * nc2 + c) * F(k, c, n);
            dm = std::max(dm, std::abs(acc - O(kp, r, n)));
            sm = std::max(sm, std::abs(acc));
          }
      d.a0_resid = (sm > 0.0) ? dm / sm : dm;
      app_log(1, "  [D2 gate] (A0) THC rung operator vs explicit Kbig: rel diff {:.3e} (scale {:.3e})", d.a0_resid, sm);
      // the mesh-Fourier k-sum (2026-09-12): the same operator through kmesh_ft, timed against the direct sum
      {
        vd::kmesh_ft kft;
        kft.build(kc, kmq, kpq);
        d.a0_ft_check = kft.check;
        if (kft.ok) {
          nda::array<ComplexType, 3> Of(nk, nc2, nR);
          vertex_ladder_detail::prof_watch tw;
          vd::thc_rung_apply_ft(_Xb_skma, 0, 0, kpq, kft, Wq, ComplexType(1.0), F, Of, 3);
          const double t_ft = tw.lap();
          vd::thc_rung_apply(_Xb_skma, 0, 0, kpq, qx_of, Wq, ComplexType(1.0), F, O, 3);
          const double t_direct = tw.lap();
          double df = 0.0;
          for (long kp = 0; kp < nk; ++kp)
            for (long r = 0; r < nc2; ++r)
              for (long n = 0; n < nR; ++n) df = std::max(df, std::abs(Of(kp, r, n) - O(kp, r, n)));
          d.a0_ft_resid = (sm > 0.0) ? df / sm : df;
          app_log(1, "  [D2 gate] (A0-FT) mesh-Fourier k-sum [{}] vs the direct sum: rel diff {:.3e} (mesh check {:.2e}); wall "
                     "{:.3f} s vs {:.3f} s (Nm = {}, nk = {}, nR = {})", kft.fft ? "FFTW" : "dense", d.a0_ft_resid, kft.check,
                  t_ft, t_direct, Nm, nk, nR);
        } else {
          app_log(1, "  [D2 gate] (A0-FT) mesh transform NOT usable (check {:.2e}): the driver uses the direct sum", kft.check);
        }
      }
      if (quick) return d;
      // ---- the SIGNED dominant eigenvalue of Xh Kt = (1/nk) Cb Kbig at inu = 0 (the L2 resolvent's operator):
      // the Bethe-Salpeter series with the kernel -W is a geometric series in K'Cb = -(1/nk) Kbig Cb,
      // i.e. its resolvent is (1 + Xh Kt)^-1 and the particle-hole instability sits at lambda(Xh Kt) -> -1;
      // the as-implemented L2 resolvent (1 - Xh Kt)^-1 would only meet it at +1. A NEGATIVE dominant
      // eigenvalue is therefore the sign-sensitive pin the power-iteration watchdog (|lambda|) cannot give.
      {
        nda::array<ComplexType, 3> Cb0(nk, nc2, nc2);
        vd::build_cb_tau(G_CC, tools, 0, 0, tools.m0, kpq, Cb0);
        nda::array<ComplexType, 1> v(D), w(D), u(D);
        for (long i = 0; i < D; ++i) v(i) = ComplexType(1.0 / std::sqrt(double(D)), 0.0);
        ComplexType lam(0.0);
        double lam_abs = 0.0;
        auto apply = [&](nda::array<ComplexType, 1> const &x, nda::array<ComplexType, 1> &y) {
          // y = (1/nk) Cb Kbig x  (Cb block-diagonal in k)
          for (long i = 0; i < D; ++i) { ComplexType acc(0.0); for (long j = 0; j < D; ++j) acc += Kbig(i, j) * x(j); u(i) = acc; }
          for (long k = 0; k < nk; ++k)
            for (long r = 0; r < nc2; ++r) {
              ComplexType acc(0.0);
              for (long c = 0; c < nc2; ++c) acc += Cb0(k, r, c) * u(k * nc2 + c);
              y(k * nc2 + r) = acc / double(nk);
            }
        };
        for (int it = 0; it < 300; ++it) {
          apply(v, w);
          ComplexType num(0.0); double den = 0.0;
          for (long i = 0; i < D; ++i) { num += std::conj(v(i)) * w(i); den += std::norm(v(i)); }
          const ComplexType lam_new = num / den;
          double nw = 0.0;
          for (long i = 0; i < D; ++i) nw += std::norm(w(i));
          nw = std::sqrt(nw);
          for (long i = 0; i < D; ++i) v(i) = w(i) / nw;
          if (it > 5 and std::abs(lam_new - lam) < 1e-10 * std::abs(lam_new)) { lam = lam_new; lam_abs = nw; break; }
          lam = lam_new; lam_abs = nw;
        }
        d.lam_xhkt_re = lam.real();
        d.lam_xhkt_im = lam.imag();
        app_log(1, "  [D2 gate] (A0') dominant eigenvalue of Xh Kt = (1/nk) Cb Kbig at inu = 0, unit (0,0): {:+.6f} {:+.3e} i "
                   "(|lambda| {:.6f}); the -W ladder's resolvent (1 + Xh Kt)^-1 is singular at lambda = -1, the "
                   "as-implemented L2 resolvent (1 - Xh Kt)^-1 at +1", lam.real(), lam.imag(), lam_abs);
      }
    }

    // ---- (A) the static limit vs the L2 resolvent, both signs --------------------------------
    nda::array<ComplexType, 4> Ps(nnu, nq, Nm, Nm);
    {
      vd::dyn_opts o;
      o.kcrys = std::addressof(kc);
      o.gap_mask = gap_mask;
      o.static_only = true;
      vd::dyn_meter met;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nus, &Ps, nullptr, nullptr, nullptr,
                                rank, size, o, &met);
      mpi->comm.all_reduce_in_place_n(Ps.data(), Ps.size(), std::plus<>{});
      met.reduce(mpi->comm);
      d.fit_err_G = met.fit_err_G;
      d.rr_G = met.rr_G;
      d.dsq_err = met.dsq_err;
      d.wtau_sym = met.wtau_sym;
      nda::array<ComplexType, 4> Pl(nnu, nq, Nm, Nm), Plm(nnu, nq, Nm, Nm);
      nda::array<ComplexType, 3> W0m(nq, Nm, Nm);
      W0m() = -W0b;
      vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, W0b, kmq, kpq, tools, nus, nullptr, &Pl, rank, size, symc);
      vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, W0m, kmq, kpq, tools, nus, nullptr, &Plm, rank, size, symc);
      mpi->comm.all_reduce_in_place_n(Pl.data(), Pl.size(), std::plus<>{});
      mpi->comm.all_reduce_in_place_n(Plm.data(), Plm.size(), std::plus<>{});
      // 2026-09-11: pair_space_ladder now resums the derived resolvent (1 + Xh Kt)^-1, so the
      // static column must equal it DIRECTLY; -ladder(-W0) reproduces the former (1 - Xh Kt)^-1
      // resummation and is kept as the "as-implemented-before" reference (a_l2_diff).
      Plm() = -Plm;                                   // the former L2 resolvent
      d.a_resid = rel4(Ps, Pl);
      d.a_l2_diff = rel4(Ps, Plm);
      d.static_max = max_abs4(Ps);
      app_log(1, "  [D2 gate] (A) static limit vs pair_space_ladder(W0) [resolvent 1 + Xh Kt]: rel diff {:.3e}; vs the "
                 "former L2 resolvent (-ladder(-W0), 1 - Xh Kt): {:.3e} (|static| {:.3e}); G fit {:.3e} (rr {:.3g}), "
                 "Dsq/Dcb {:.3e}, W_d(s) PH-sym resid {:.3e}",
              d.a_resid, d.a_l2_diff, d.static_max, d.fit_err_G, d.rr_G, d.dsq_err, d.wtau_sym);
    }

    // ---- (B) one bare dynamic rung vs the anchor's phase 2 -----------------------------------
    {
      nda::array<ComplexType, 4> P1(nnu, nq, Nm, Nm);
      vd::dyn_opts o;
      o.kcrys = std::addressof(kc);
      o.gap_mask = gap_mask;
      o.one_rung_only = true;
      vd::dyn_meter met;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nus, nullptr, &P1, nullptr, nullptr,
                                rank, size, o, &met);
      mpi->comm.all_reduce_in_place_n(P1.data(), P1.size(), std::plus<>{});
      met.reduce(mpi->comm);
      d.refit_err_1 = met.refit_err_max;
      // the anchor: K_d = W_dyn(inu') - W_dyn(0) split as the anchor needs it -- the CONSTANT
      // -W_dyn(0) is its instantaneous rung (phase 1: pair bubbles at the external nu; the phase-2
      // DLR tau transform cannot carry a constant in nu'), the full W_dyn(inu') its dynamic rung
      const long lpos0 = std::max(tools.m0, tools.w_mirror_b(tools.m0)) - nw_b / 2;
      nda::array<ComplexType, 3> Zm(nq, Nm, Nm);
      for (long iqp = 0; iqp < nq; ++iqp) Zm(iqp, all, all) = -Wbh(iqp, lpos0, all, all);
      nda::array<ComplexType, 4> Wdyn(nq, nw_b, Nm, Nm);
      for (long iqp = 0; iqp < nq; ++iqp)
        for (long l = 0; l < nw_b; ++l) {
          const long lpos = std::max(l, tools.w_mirror_b(l)) - nw_b / 2;
          Wdyn(iqp, l, all, all) = Wbh(iqp, lpos, all, all);
        }
      nda::array<ComplexType, 4> PiC(nw_b, nq, Nm, Nm);
      PiC() = ComplexType(0.0);
      vertex_pi::pi_c_accumulate_w(*_ft, tools, G_CC, _Xb_skma, Zm, &Wdyn, kmq, kpq, nda::range(0, nc), PiC,
                                   rank, size, false, nullptr, symc);
      mpi->comm.all_reduce_in_place_n(PiC.data(), PiC.size(), std::plus<>{});
      double dm = 0.0, sm = 0.0;
      for (long jn = 0; jn < nnu; ++jn)
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              dm = std::max(dm, std::abs(P1(jn, iq, M, N) - PiC(nus[size_t(jn)], iq, M, N)));
              sm = std::max(sm, std::abs(PiC(nus[size_t(jn)], iq, M, N)));
            }
      // the anchor is compared at inu = 0 (its instantaneous + dynamic phases are exact there);
      // at the first positive node the one-rung term must be CONTINUOUS in nu (the node is
      // 2 pi / beta above zero): |P1(nu_1) - P1(0)| / |P1(0)| is the meter, and the anchor's own
      // jump between the two nodes is reported next to it
      {
        double d0 = 0.0, s0 = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              d0 = std::max(d0, std::abs(P1(1, iq, M, N) - P1(0, iq, M, N)));
              s0 = std::max(s0, std::abs(P1(0, iq, M, N)));
            }
        d.b_continuity = (s0 > 0.0) ? d0 / s0 : d0;
        double da = 0.0, sa = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              da = std::max(da, std::abs(PiC(nus[1], iq, M, N) - PiC(nus[0], iq, M, N)));
              sa = std::max(sa, std::abs(PiC(nus[0], iq, M, N)));
            }
        app_log(1, "  [D2 gate] (B) nu-continuity of the one dynamic rung, node 1 vs 0: driver {:.3e}, anchor {:.3e}",
                d.b_continuity, (sa > 0.0) ? da / sa : da);
      }
      {
        double dm0 = 0.0, sm0 = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              dm0 = std::max(dm0, std::abs(P1(0, iq, M, N) - PiC(nus[0], iq, M, N)));
              sm0 = std::max(sm0, std::abs(PiC(nus[0], iq, M, N)));
            }
        d.b_resid = (sm0 > 0.0) ? dm0 / sm0 : dm0;      // the gate: inu = 0
      }
      d.onerung_max = sm;
      app_log(1, "  [D2 gate] (B) one bare dynamic rung vs pi_c_accumulate_w(Z = 0, W_dyn - W_dyn(0)): rel diff "
                 "{:.3e} (|anchor| {:.3e}, |static| {:.3e}); tau refit err {:.3e}",
              d.b_resid, sm, d.static_max, d.refit_err_1);
      // per-node detail
      for (long jn = 0; jn < nnu; ++jn) {
        double dj = 0.0, sj = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              dj = std::max(dj, std::abs(P1(jn, iq, M, N) - PiC(nus[size_t(jn)], iq, M, N)));
              sj = std::max(sj, std::abs(PiC(nus[size_t(jn)], iq, M, N)));
            }
        double pj = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) pj = std::max(pj, std::abs(P1(jn, iq, M, N)));
        app_log(1, "  [D2 gate] (B) node {} (n = {}): rel diff {:.3e}, |anchor| {:.3e}, |P1| {:.3e}", jn,
                tools.wn_b(nus[size_t(jn)]), (sj > 0.0) ? dj / sj : dj, sj, pj);
      }
    }

    // ---- (B2) the nu-continuity of the Neumann orders 2 and 3 (node 1 vs node 0) -------------
    // Each order is a readout of a physical object continuous in nu; a jump between the two
    // nodes (2 pi/beta apart) at order n localizes the numerical defect at that order.
    {
      for (long nord = 2; nord <= 3; ++nord) {
        nda::array<ComplexType, 4> Pn(nnu, nq, Nm, Nm);
        vd::dyn_opts o;
        o.kcrys = std::addressof(kc);
        o.gap_mask = gap_mask;
        o.gmres_m = 0;
        o.maxit = nord;
        o.tol = 0.0;
        vd::dyn_meter met;
        vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nus, nullptr, nullptr, nullptr, &Pn,
                                  rank, size, o, &met);
        mpi->comm.all_reduce_in_place_n(Pn.data(), Pn.size(), std::plus<>{});
        double d0 = 0.0, s0 = 0.0, dS = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              d0 = std::max(d0, std::abs(Pn(1, iq, M, N) - Pn(0, iq, M, N)));
              s0 = std::max(s0, std::abs(Pn(0, iq, M, N)));
              dS = std::max(dS, std::abs(Pn(0, iq, M, N) - Ps(0, iq, M, N)));
            }
        app_log(1, "  [D2 gate] (B2) Neumann order {}: nu-continuity node 1 vs 0 = {:.3e} (|P| {:.3e}; |P - static| at node 0 "
                   "{:.3e})", nord, (s0 > 0.0) ? d0 / s0 : d0, s0, dS);
      }
    }

    // ---- (C) the resummed vertex at inu = 0: Neumann and GMRES, Hermiticity, meters --------
    // (inu = 0 only here: in the {U, S} two-family representation the index-confluent pairs carry
    //  coefficients +-1/(i nu) that cancel only in values, and at the first positive node of a
    //  beta = 1000 grid (1/nu = 159) the per-family tau refit noise re-enters the iteration at the
    //  level of the physical content -- measured: Ritz 2e3, the solve stalls. The bounded
    //  representation T_a = U_a S_a of the shifted family is increment D2e; the one-rung column
    //  above is continuous into that node because its readout cancels exactly.)
    // ---- (C') the inu != 0 EXPERIMENT (reported, not asserted): union grid + mask + tau metric ----
    // D2e status: the physical readouts are nu-continuous order by order (B2), the tau-metric GMRES
    // readout at the first positive node is continuous with inu = 0, but the iteration carries a
    // spurious mode (watchdog ~2.6 union / ~40 shared+mask on lih222 at beta = 1000) -- open.
    {
      std::vector<long> nu1 = {tools.m0 + 1};
      nda::array<ComplexType, 4> Pe(1, nq, Nm, Nm), Pge(1, nq, Nm, Nm);
      for (int variant = 0; variant < 3; ++variant) {
        vd::dyn_opts oe;
        oe.kcrys = std::addressof(kc);
        oe.gap_mask = (variant == 0) ? 0.0 : gap_mask;     // 0: union, no mask; 1: union + mask; 2: shared + mask
        oe.gmres_m = 12;
        oe.maxit = 36;
        oe.tol = 1e-8;
        oe.readout_tol = 1e-6;
        oe.union_nodes = (variant <= 1);
        vd::dyn_meter mete;
        vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nu1, nullptr, nullptr, &Pge, &Pe,
                                  rank, size, oe, &mete);
        mpi->comm.all_reduce_in_place_n(Pe.data(), Pe.size(), std::plus<>{});
        mete.reduce(mpi->comm);
        double ds = 0.0, ss = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              ds = std::max(ds, std::abs(Pe(0, iq, M, N) - Ps(1, iq, M, N)));
              ss = std::max(ss, std::abs(Ps(1, iq, M, N)));
            }
        app_log(1, "  [D2 gate] (C') inu != 0 experiment [{}], tau metric, GMRES(12), readout tol 1e-6: |resummed - static| / "
                   "|static| at node 1 = {:.3e} (node 0's asserted value below), watchdog {:.3e}, applications max {}, "
                   "done {}, refit {:.2e}, G pole fit {:.2e}",
                variant == 0 ? "union, no mask" : (variant == 1 ? "union + mask" : "shared + mask"),
                (ss > 0.0) ? ds / ss : ds, mete.ritz_max, mete.it_max, mete.nconv == mete.nunits, mete.refit_err_max,
                mete.fit_err_G);
        if (variant == 0) d.nu1_resid = (ss > 0.0) ? ds / ss : ds;
        if (variant == 0) d.nu1_gfit = mete.fit_err_G;
        if (variant == 0) d.nu1_done = (mete.nconv == mete.nunits);
      }
    }
    {
      std::vector<long> nu0 = {tools.m0};          // the asserted solve: inu = 0, the D4 configuration
      const long nnu0 = 1;
      nda::array<ComplexType, 4> Pg(nnu0, nq, Nm, Nm), Pd(nnu0, nq, Nm, Nm), Pd2(nnu0, nq, Nm, Nm), Pg2(nnu0, nq, Nm, Nm);
      vd::dyn_opts o;
      o.kcrys = std::addressof(kc);
      o.gmres_m = 4;
      o.maxit = 12;
      vd::dyn_meter met;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nu0, nullptr, nullptr, &Pg, &Pd,
                                rank, size, o, &met);
      mpi->comm.all_reduce_in_place_n(Pg.data(), Pg.size(), std::plus<>{});
      mpi->comm.all_reduce_in_place_n(Pd.data(), Pd.size(), std::plus<>{});
      met.reduce(mpi->comm);
      vd::dyn_opts o2;
      o2.kcrys = std::addressof(kc);
      o2.gmres_m = 0;
      o2.maxit = 12;
      vd::dyn_meter met2;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nu0, nullptr, nullptr, &Pg2, &Pd2,
                                rank, size, o2, &met2);
      mpi->comm.all_reduce_in_place_n(Pg2.data(), Pg2.size(), std::plus<>{});
      mpi->comm.all_reduce_in_place_n(Pd2.data(), Pd2.size(), std::plus<>{});
      met2.reduce(mpi->comm);
      d.gmres_vs_neumann = rel4(Pd, Pd2);
      d.gam1_consistency = rel4(Pg, Pg2);
      {   // (C'') the RHS column blocking: each block is an independent solve to tol -> tol class
        nda::array<ComplexType, 4> Pgb(nnu0, nq, Nm, Nm), Pdb(nnu0, nq, Nm, Nm);
        vd::dyn_opts ob = o;
        ob.rhs_block = 5;
        vd::dyn_meter metb;
        vd::pair_space_ladder_dyn(G_CC, _Xb_skma, W0b, Wbh, kmq, kpq, tools, nu0, nullptr, nullptr, &Pgb, &Pdb,
                                  rank, size, ob, &metb);
        mpi->comm.all_reduce_in_place_n(Pgb.data(), Pgb.size(), std::plus<>{});
        mpi->comm.all_reduce_in_place_n(Pdb.data(), Pdb.size(), std::plus<>{});
        metb.reduce(mpi->comm);
        d.block_resid = std::max(rel4(Pd, Pdb), rel4(Pg, Pgb));
        app_log(1, "  [D2 gate] (C'') RHS blocks of 5 (of Nm = {}) vs the unblocked solve: resummed rel diff {:.3e}, Gamma1 "
                   "{:.3e}; applications max {} vs {}; RSS {:.2f} vs {:.2f} GB", Nm, rel4(Pd, Pdb), rel4(Pg, Pgb), metb.it_max,
                met.it_max, metb.rss_max_gb, met.rss_max_gb);
      }
      d.ritz_max = met.ritz_max;
      d.contraction_max = met2.ritz_max;
      d.it_max = met.it_max;
      d.it_max_neumann = met2.it_max;
      d.all_converged = (met.nconv == met.nunits) and (met2.nconv == met2.nunits);
      d.refit_err = std::max(met.refit_err_max, met2.refit_err_max);
      d.dyn_max = max_abs4(Pd);
      d.gam1_max = max_abs4(Pg);
      d.herm = vertex_ladder_detail::hermitize_mn(Pd);
      // the dynamic correction relative to the static ladder (inu = 0)
      for (long jn = 0; jn < nnu0; ++jn) {
        double ds = 0.0, ss = 0.0, d1 = 0.0;
        for (long iq = 0; iq < nq; ++iq)
          for (long M = 0; M < Nm; ++M)
            for (long N = 0; N < Nm; ++N) {
              ds = std::max(ds, std::abs(Pd(jn, iq, M, N) - Ps(jn, iq, M, N)));
              d1 = std::max(d1, std::abs(Pg(jn, iq, M, N) - Ps(jn, iq, M, N)));
              ss = std::max(ss, std::abs(Ps(jn, iq, M, N)));
            }
        if (jn == 0) { d.dyn_vs_static = (ss > 0.0) ? ds / ss : ds; d.gam1_vs_static = (ss > 0.0) ? d1 / ss : d1; }
        app_log(1, "  [D2 gate] (C) node {}: |resummed - static| / |static| = {:.3e}, |Gamma1 - static| / |static| "
                   "= {:.3e}", jn, (ss > 0.0) ? ds / ss : ds, (ss > 0.0) ? d1 / ss : d1);
      }
      app_log(1, "  [D2 gate] (C) resummed: GMRES(4) vs Neumann rel diff {:.3e} (Gamma1 {:.3e}); max |Ritz(K_d L_s)| "
                 "{:.3f}, Neumann contraction {:.3f}; applications max {} / {}; all converged {}; tau refit "
                 "{:.3e}; Hermiticity {:.3e}; walls: setup {:.2f} kbig {:.2f} cb {:.2f} lu {:.2f} solve {:.2f} "
                 "read {:.2f} s; RSS {:.2f} GB",
              d.gmres_vs_neumann, d.gam1_consistency, d.ritz_max, d.contraction_max, d.it_max, d.it_max_neumann,
              d.all_converged, d.refit_err, d.herm, met.t_setup, met.t_kbig, met.t_cb, met.t_lu, met.t_solve,
              met.t_read, met.rss_max_gb);
    }
    return d;
  }

  vertex_t::dynbse_nu0_result vertex_t::eval_pol_dynbse_nu0(MBState &mb_state, THC_ERI auto &thc, long gen) {
    decltype(nda::range::all) all;
    namespace vd = vertex_dynbse_detail;
    vertex_ladder_detail::prof_watch twatch;
    dynbse_nu0_result r;
    utils::check(active() and secondary(), "vertex_t::eval_pol_dynbse_nu0: requires an ACTIVE secondary-basis vertex.");
    // W-int-0: _wannier => the outputs are the MLWF-pair polarization (dumped for coarse->fine interpolation).
    utils::check(_W0b_qmm.has_value(), "vertex_t::eval_pol_dynbse_nu0: W0bar is absent -- build_w0 must run first.");
    utils::check(_Wb_qwmm.has_value(),
                 "vertex_t::eval_pol_dynbse_nu0: the W-bar cache is absent -- cache_w must run on this instance "
                 "(the dynamic readout folds THIS iteration's dW).");
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    nda::array<ComplexType, 5> G_CC;
    nda::array<long, 2> kmq, kpq;
    vertex_sym::sym_ctx const *symc = nullptr;
    ladder_inputs(mb_state, thc, G_CC, kmq, kpq, symc);   // full-BZ G_CC/kmq/kpq + (on a sym mesh) an active symc
    const nda::array<double, 2> kc(MF->kpts_crystal());
    auto tools_h = vd::make_dyn_tools(*_ft, _dyn_iaft_prec, G_CC);
    auto &tools = *tools_h.tools;
    const long nq = long(_W0b_qmm.value().shape(0)), Nm = _Xb_skma.shape(2);   // nq_ibz on a symmetric mesh
    const bool pair_frame = _wannier and (_wannier_frame == "pair");   // W-int-1b: "aux" (points) is the interpolable frame
    const long nout = pair_frame ? _M * _M : Nm;
    std::vector<long> nu0 = {tools.m0};
    nda::array<ComplexType, 4> Ps(1, nq, nout, nout), P1(1, nq, nout, nout), Pg(1, nq, nout, nout), Pd(1, nq, nout, nout);
    vd::dyn_opts o;
    o.kcrys = std::addressof(kc);
    o.tol = _dyn_tol; o.maxit = _dyn_maxit; o.gmres_m = _dyn_gmres; o.sign_ks = _dyn_sign;
    o.rhs_block = _dyn_rhs_block;
    o.dense_rung = _dyn_dense;
    o.tfold = _dyn_tfold;
    o.vmask_lo = _dyn_vmask_lo; o.vmask_hi = _dyn_vmask_hi;
    o.gamma1_only = _dyn_gamma1_only;
    if (_dyn_gamma1_only) app_log(1, "  [scGW-tilde T2] pol_vertex_dyn_gamma1_only: GMRES resummation SKIPPED; the resummed column repeats Gamma_1.");
    o.sched_comm = mpi->comm.get();      // dynamic longest-first scheduling of the (s, q, nu) units
    o.readout_tol = 1e-6;                // the physical readout's own stop (the 1e-8 residual is below the refit floor)
    if (_wannier) {
      o.wannier_pairs = pair_frame;
      if (pair_frame) app_log(1, "  [scGW-tilde T2] Wannier-pair vertex output (W-int-0/1): Pi_loc(q) in the MLWF pair basis (M = {}, nab = {}; G_bar / X_bar inputs, identity pair legs) -- the SAME-CELL pair block.", _M, nout);
      else app_log(1, "  [scGW-tilde T2] Wannier-C vertex output in the aux/point frame (W-int-1b): Pi(q)_{{MN}} on the N_m = {} secondary points (M = {} MLWFs, G_bar / X_bar inputs) -- the interpolable frame (freeze the points on the fine mesh).", nout, _M);
    }
    if (_dyn_dump) o.dump_prefix = mb_state.coqui_prefix + ".dynunits.nu0.g" + std::to_string(gen);
    // D3/D4 configuration at inu = 0: the shared aux grid with the Dsq/Dcb tables, no mask (the
    // union grid / in-gap mask / twisted-pair basis are the inu != 0 machinery of D2e, still open)
    vd::dyn_meter met;
    vd::pair_space_ladder_dyn(G_CC, _Xb_skma, _W0b_qmm.value(), _Wb_qwmm.value(), kmq, kpq, tools, nu0,
                              &Ps, nullptr, &Pg, &Pd, mpi->comm.rank(), mpi->comm.size(), o, &met, symc);
    // the pure one dynamic rung (T_s = 0, one application) as its own column
    {
      vd::dyn_opts o1 = o;
      o1.one_rung_only = true;
      if (_dyn_dump) o1.dump_prefix = mb_state.coqui_prefix + ".dynunits.nu0r1.g" + std::to_string(gen);
      vd::dyn_meter met1;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, _W0b_qmm.value(), _Wb_qwmm.value(), kmq, kpq, tools, nu0,
                                nullptr, &P1, nullptr, nullptr, mpi->comm.rank(), mpi->comm.size(), o1, &met1, symc);
    }
    for (auto *A : {&Ps, &P1, &Pg, &Pd}) mpi->comm.all_reduce_in_place_n(A->data(), A->size(), std::plus<>{});
    met.reduce(mpi->comm);
    const double hs = vertex_ladder_detail::hermitize_mn(Ps), h1 = vertex_ladder_detail::hermitize_mn(P1);
    const double hg = vertex_ladder_detail::hermitize_mn(Pg), hd = vertex_ladder_detail::hermitize_mn(Pd);
    r.Pi_static = nda::array<ComplexType, 3>(nq, nout, nout); r.Pi_static = Ps(0, all, all, all);
    r.Pi_dyn1 = nda::array<ComplexType, 3>(nq, nout, nout);   r.Pi_dyn1 = P1(0, all, all, all);
    r.Pi_gam1 = nda::array<ComplexType, 3>(nq, nout, nout);   r.Pi_gam1 = Pg(0, all, all, all);
    r.Pi_dyn = nda::array<ComplexType, 3>(nq, nout, nout);    r.Pi_dyn = Pd(0, all, all, all);
    if (_dyn_dump and mpi->comm.root()) {
      // W-int-1b: the assembled inu = 0 columns as ONE h5 (the offline Route-B tool's input, and the fine-mesh
      // consumer's format: pol_vertex_interp_file). q in crystal coordinates (this run's Qpts order).
      const std::string fn = mb_state.coqui_prefix + ".pol_nu0.g" + std::to_string(gen) + ".h5";
      auto lat = MF->lattv();                          // rows a_i (bohr); a_i . b_j = 2 pi delta_ij
      auto Q = MF->Qpts();                             // Cartesian (bohr^-1, 2 pi included)
      nda::array<double, 2> qc(nq, 3);
      for (long iq = 0; iq < nq; ++iq)
        for (long i = 0; i < 3; ++i) {
          double v = 0.0;
          for (long j = 0; j < 3; ++j) v += lat(i, j) * Q(iq, j);
          qc(iq, i) = v / (2.0 * M_PI);
        }
      h5::file f(fn, 'w');
      h5::group g(f);
      nda::h5_write(g, "q", qc);
      nda::h5_write(g, "Pi_static", r.Pi_static);
      nda::h5_write(g, "Pi_dyn1", r.Pi_dyn1);
      nda::h5_write(g, "Pi_gam1", r.Pi_gam1);
      nda::h5_write(g, "Pi_dyn", r.Pi_dyn);
      h5::h5_write(g, "nout", nout);
      h5::h5_write(g, "frame", std::string(pair_frame ? "pair" : "aux"));
      h5::h5_write(g, "wannier", long(_wannier ? 1 : 0));
      h5::h5_write(g, "nm", Nm);
      h5::h5_write(g, "window_first", long(_band_window.first()));
      h5::h5_write(g, "window_size", long(_band_window.size()));
      if (_sec_ipts.size() > 0) nda::h5_write(g, "ipts", _sec_ipts);
      app_log(1, "  [W-int] inu = 0 vertex columns written to {} ({} q x {} x {}, frame {}).", fn, nq, nout, nout,
              pair_frame ? "pair" : "aux");
    }
    r.ritz_max = met.ritz_max; r.refit_err = met.refit_err_max; r.fit_err_G = met.fit_err_G; r.rr_G = met.rr_G;
    r.herm_dyn = hd; r.it_max = met.it_max; r.it_sum = met.it_sum; r.nunits = met.nunits;
    r.all_converged = (met.nconv == met.nunits); r.t_solve = met.t_solve; r.rss_gb = met.rss_max_gb;
    r.t_total = twatch.lap();
    auto mx = [](nda::array<ComplexType, 3> const &A) { double m = 0.0; for (auto const &v : A) m = std::max(m, std::abs(v)); return m; };
    app_log(1, "  [scGW-tilde T2] dynamic-rung ladder at inu = 0: {} units, applications max {} (mean {:.1f}), "
               "all converged {}, watchdog max |Ritz(K_d L_s)| {:.3f}; G pole fit {:.2e} (rr {:.2f}), tau refit "
               "{:.2e}; (M,N) asymmetry static {:.1e} / one-rung {:.1e} / Gamma1 {:.1e} / resummed {:.1e}; "
               "|static| {:.3e} |one-rung| {:.3e} |Gamma1| {:.3e} |resummed| {:.3e}; wall {:.1f} s (solve {:.1f} s "
               "on the slowest rank: rung {:.1f} s, refit {:.1f} s, L0 {:.1f} s, T_s gemms {:.1f} s, Arnoldi {:.1f} s, rest "
               "{:.1f} s; {} applications, {:.1f} s each), RSS {:.2f} GB, omp_threads {}",
            met.nunits, met.it_max, (met.nunits > 0) ? double(met.it_sum) / double(met.nunits) : 0.0, r.all_converged,
            met.ritz_max, met.fit_err_G, met.rr_G, met.refit_err_max, hs, h1, hg, hd, mx(r.Pi_static), mx(r.Pi_dyn1),
            mx(r.Pi_gam1), mx(r.Pi_dyn), r.t_total, met.t_solve, met.t_rung, met.t_refit, met.t_l0, met.t_ts, met.t_orth,
            met.t_solve - met.t_rung - met.t_refit - met.t_l0 - met.t_ts - met.t_orth, met.n_apps,
            (met.n_apps > 0) ? met.t_solve * double(mpi->comm.size()) / double(met.n_apps) : 0.0, met.rss_max_gb,
            utils::omp_threads());
    if (met.ritz_max >= 1.0)
      app_log(1, "  [scGW-tilde T2] WARNING: the dynamic remainder's watchdog is >= 1 on some unit -- the resummed "
                 "column is not to be trusted there; Gamma_1 is the reportable number.");
    return r;
  }

  /**
   * eps(q_i, i nu) cuts (2026-09-11): the dynamic-rung columns on a list of PH-sym bosonic HALF
   * nodes (j <-> full index nw_b/2 + j) at a subset of transfers. The inu != 0 framework of D2e:
   * the UNION {U, T} basis (G on the half-shifted grid, in-gap nodes masked at 0.45 x the window
   * gap), the tau metric, GMRES with a Krylov space of at least 12 (the restart at m = 4 was the
   * stall: lih node 1 converges to 6e-9 in 10 applications at m = 12), the readout criterion as
   * the stop. Node 0 is evaluated on the same footing (the union scheme is exact there too), so
   * the cut's node 0 agrees with eval_pol_dynbse_nu0's shared-grid value to the refit class.
   */
  vertex_t::dynbse_cut_result vertex_t::eval_pol_dynbse_cut(MBState &mb_state, THC_ERI auto &thc,
                                                            std::vector<long> const &half_nodes,
                                                            std::vector<long> const &qsel, long gen, bool bubble_only) {
    decltype(nda::range::all) all;
    namespace vd = vertex_dynbse_detail;
    vertex_ladder_detail::prof_watch twatch;
    dynbse_cut_result r;
    utils::check(active() and secondary(), "vertex_t::eval_pol_dynbse_cut: requires an ACTIVE secondary-basis vertex.");
    utils::check(not _wannier or _wannier_frame != "pair",
                 "vertex_t::eval_pol_dynbse_cut: Wannier mode in the aux/point frame only (the pair frame is inu = 0 only).");
    utils::check(_W0b_qmm.has_value(), "vertex_t::eval_pol_dynbse_cut: W0bar is absent -- build_w0 must run first.");
    utils::check(_Wb_qwmm.has_value(), "vertex_t::eval_pol_dynbse_cut: the W-bar cache is absent -- cache_w must run.");
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    nda::array<ComplexType, 5> G_CC;
    nda::array<long, 2> kmq, kpq;
    vertex_sym::sym_ctx const *symc = nullptr;
    ladder_inputs(mb_state, thc, G_CC, kmq, kpq, symc);   // full-BZ G_CC/kmq/kpq + (on a sym mesh) an active symc
    const nda::array<double, 2> kc(MF->kpts_crystal());
    auto tools_h = vd::make_dyn_tools(*_ft, _dyn_iaft_prec, G_CC);
    auto &tools = *tools_h.tools;
    const long nq = long(_W0b_qmm.value().shape(0)), Nm = _Xb_skma.shape(2), nn = long(half_nodes.size());   // nq_ibz on a symmetric mesh
    std::vector<long> nus;
    for (long j : half_nodes) {
      utils::check(j >= 0 and tools.m0 + j < tools.nw_b, "vertex_t::eval_pol_dynbse_cut: half node {} out of range.", j);
      nus.push_back(tools.m0 + j);
    }
    r.half_nodes = half_nodes;
    r.qsel = qsel;
    nda::array<ComplexType, 4> Ps(nn, nq, Nm, Nm), P1(nn, nq, Nm, Nm), Pg(nn, nq, Nm, Nm), Pd(nn, nq, Nm, Nm);
    nda::array<ComplexType, 4> Pb(nn, nq, Nm, Nm);   // LFF-aux L-0: the window bubble column (always evaluated: cheap)
    vd::dyn_opts o;
    o.Pi_bub = std::addressof(Pb);
    o.bubble_only = bubble_only;
    if (bubble_only) app_log(1, "  [scGW-tilde T2] pol_vertex_dyn_bubble_only: ONLY the window bubble column Pi_bub = (spin/nk) D^dag Cb D is evaluated (no rung, no solve).");
    o.kcrys = std::addressof(kc);
    o.tol = _dyn_tol; o.maxit = _dyn_maxit; o.gmres_m = std::max<long>(_dyn_gmres, 12); o.sign_ks = _dyn_sign;
    o.rhs_block = _dyn_rhs_block;
    o.dense_rung = _dyn_dense;
    o.union_stride = _dyn_union_stride;
    o.table_mode = _dyn_table_mode;
    o.tfold = _dyn_tfold;
    o.vmask_lo = _dyn_vmask_lo; o.vmask_hi = _dyn_vmask_hi;
    o.gamma1_only = _dyn_gamma1_only;
    if (_dyn_gamma1_only) app_log(1, "  [scGW-tilde T2] pol_vertex_dyn_gamma1_only: GMRES resummation SKIPPED; the resummed column repeats Gamma_1.");
    o.sched_comm = mpi->comm.get();      // dynamic longest-first scheduling of the (s, q, nu) units
    if (_dyn_dump) o.dump_prefix = mb_state.coqui_prefix + ".dynunits.cut.g" + std::to_string(gen);
    o.union_nodes = true;
    // NO in-gap mask: the symmetric |eps| < 0.45 gap mask is centered at mu, not on the gap, and on
    // lih222 it removed the nodes the occupied top (0.027 Ha) needs (G pole fit 2.5e-1). The union
    // grid without a mask represents G to the node_pole_fit class; GMRES(>= 12) handles the rest.
    o.gap_mask = 0.0;
    // EXPERIMENT (small-nu spurious mode): COQUI_DYNBSE_UNION=0 runs the cut on the SHARED node set
    // (exact confluent algebra + the twisted R1/R3 tables) instead of the union grid.
    if (char const *e = std::getenv("COQUI_DYNBSE_UNION")) o.union_nodes = (std::atoi(e) != 0);
    o.readout_tol = 1e-6;
    o.q_subset = std::addressof(qsel);
    vd::dyn_meter met;
    vd::pair_space_ladder_dyn(G_CC, _Xb_skma, _W0b_qmm.value(), _Wb_qwmm.value(), kmq, kpq, tools, nus,
                              &Ps, nullptr, &Pg, &Pd, mpi->comm.rank(), mpi->comm.size(), o, &met, symc);
    if (_dyn_cut_r1 and not bubble_only) {
      vd::dyn_opts o1 = o;
      o1.one_rung_only = true;
      o1.Pi_bub = nullptr;
      if (_dyn_dump) o1.dump_prefix = mb_state.coqui_prefix + ".dynunits.cutr1.g" + std::to_string(gen);
      vd::dyn_meter met1;
      vd::pair_space_ladder_dyn(G_CC, _Xb_skma, _W0b_qmm.value(), _Wb_qwmm.value(), kmq, kpq, tools, nus,
                                nullptr, &P1, nullptr, nullptr, mpi->comm.rank(), mpi->comm.size(), o1, &met1, symc);
    } else {
      // pol_vertex_dyn_cut_r1 = false: the one-bare-rung column is not computed (Pi_dyn1 below = Pi_static)
      P1() = ComplexType(0.0);
      if (not bubble_only)
        app_log(1, "  [scGW-tilde T2] pol_vertex_dyn_cut_r1 = false: the one-bare-dynamic-rung pass is SKIPPED; the Pi_dyn1 column repeats Pi_static.");
    }
    for (auto *A : {&Ps, &P1, &Pg, &Pd, &Pb}) mpi->comm.all_reduce_in_place_n(A->data(), A->size(), std::plus<>{});
    r.Pi_bub = std::move(Pb);
    met.reduce(mpi->comm);
    r.Pi = nda::array<ComplexType, 5>(4, nn, nq, Nm, Nm);
    r.Pi(0, all, all, all, all) = Ps;
    r.Pi(1, all, all, all, all) = Ps;
    r.Pi(1, all, all, all, all) += P1;          // static + one dynamic rung
    r.Pi(2, all, all, all, all) = Pg;
    r.Pi(3, all, all, all, all) = Pd;
    r.ritz_max = met.ritz_max; r.refit_err = met.refit_err_max; r.fit_err_G = met.fit_err_G;
    r.it_max = met.it_max; r.it_sum = met.it_sum; r.nunits = met.nunits;
    r.all_converged = (met.nconv == met.nunits); r.t_solve = met.t_solve; r.rss_gb = met.rss_max_gb;
    r.t_total = twatch.lap();
    app_log(1, "  [scGW-tilde T2] {} on {} nu nodes x {} transfers (union basis, mask {:.4f} Ha, "
               "GMRES({}), RHS blocks {}, readout tol 1e-6): {} units, applications max {} (mean {:.1f}), all done {}, "
               "watchdog max |Ritz(K_d L_s)| {:.3f}; G pole fit {:.2e}, tau refit {:.2e}; wall {:.1f} s (solve {:.1f} s on "
               "the slowest rank: rung {:.1f} s, refit {:.1f} s, L0 {:.1f} s, T_s gemms {:.1f} s, Arnoldi {:.1f} s, rest {:.1f} s; "
               "{} applications), RSS {:.2f} GB, omp_threads {}",
            bubble_only ? "window bubble (bubble_only)" : "dynamic-rung ladder", nn, long(qsel.size()), o.gap_mask, o.gmres_m, o.rhs_block, met.nunits, met.it_max,
            (met.nunits > 0) ? double(met.it_sum) / double(met.nunits) : 0.0, r.all_converged, met.ritz_max,
            met.fit_err_G, met.refit_err_max, r.t_total, met.t_solve, met.t_rung, met.t_refit, met.t_l0, met.t_ts, met.t_orth,
            met.t_solve - met.t_rung - met.t_refit - met.t_l0 - met.t_ts - met.t_orth, met.n_apps, met.rss_max_gb,
            utils::omp_threads());
    if (met.unit_diag.size() > 0) {
      app_log(2, "  [dynbse cut units]   s   q  node  apps conv stag rconv    |Ritz|     refit   shift-fit  shift-cond  last-readout-step  (table mode {}, fold ratio {})", o.table_mode, o.tfold);
      for (long u = 0; u < met.unit_diag.shape(0); ++u) {
        auto row = met.unit_diag(u, nda::range::all);
        if (row(3) <= 0.0) continue;   // restored from the dump
        app_log(2, "  [dynbse cut units] {:3d} {:3d} {:5d} {:5d} {:4d} {:4d} {:5d} {:9.3e} {:9.3e} {:9.3e} {:9.3e} {:9.3e}",
                long(row(0)), long(row(1)), long(row(2)), long(row(3)), long(row(4)), long(row(5)), long(row(6)), row(7), row(8),
                row(9), row(10), row(11));
      }
    }
    if ((met.fit_err_G > 1e-4 or not r.all_converged) and not bubble_only)
      app_log(1, "  [scGW-tilde T2] WARNING: the dynamic cut's G pole fit ({:.2e}) or convergence ({}) is not clean -- "
                 "its columns are not to be trusted at that level.", met.fit_err_G, r.all_converged);
    return r;
  }


  /**
   * LFF-Sigma L-7: the DYNAMIC-rung vertex in Sigma (vertex_sigma_dyn.icc), on the READOUT instance: the dynamic-rung
   * ladder solver of eval_pol_dynbse_cut on EVERY bosonic node (both signs) x every transfer, with the Sigma hook armed;
   * opt.col selects static_dyn | dyn1_bare | dyn1 | dyn (the solver mode follows: static_only | one_rung_only |
   * gamma1_only | full GMRES). dSig OUT: (nt, ns, nk, nc, nc), replicated, Hermitized in (i, j) when opt.hermitize.
   */
  void vertex_t::eval_sigma_pair_dyn(MBState &mb_state, THC_ERI auto &thc, sigma_pair_opts const &opt,
                                     nda::array<ComplexType, 5> &dSig, sigma_pair_meter *met) {
    decltype(nda::range::all) all;
    namespace vd = vertex_dynbse_detail;
    vertex_ladder_detail::prof_watch twatch;
    utils::check(active() and secondary(), "vertex_t::eval_sigma_pair_dyn: requires an ACTIVE secondary-basis vertex (the readout instance).");
    utils::check(not _wannier, "vertex_t::eval_sigma_pair_dyn: the dynamic pair-resolved Sigma vertex runs in the band (window) frame only.");
    utils::check(_W0b_qmm.has_value(), "vertex_t::eval_sigma_pair_dyn: W0bar is absent -- build_w0 must run first.");
    utils::check(opt.col == "static_dyn" or opt.col == "dyn1_bare" or opt.col == "dyn1" or opt.col == "dyn",
                 "vertex_t::eval_sigma_pair_dyn: unknown column \"{}\" (static_dyn | dyn1_bare | dyn1 | dyn).", opt.col);
    utils::check(opt.outer == "dynamic" or opt.outer == "static", "vertex_t::eval_sigma_pair_dyn: unknown outer W \"{}\".", opt.outer);
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    if (not _Wb_qwmm.has_value()) {
      app_log(1, "  [LFF-Sigma dyn] folding this iteration's W into the W-bar cache (cache_w on demand).");
      cache_w(mb_state, thc);
    }
    nda::array<ComplexType, 5> G_CC;
    nda::array<long, 2> kmq, kpq;
    vertex_sym::sym_ctx const *symc = nullptr;
    ladder_inputs(mb_state, thc, G_CC, kmq, kpq, symc);
    utils::check(symc == nullptr or not symc->active, "vertex_t::eval_sigma_pair_dyn: the symmetric mesh is not wired (nosym only).");
    utils::check(MF->nkpts() == MF->nkpts_ibz(), "vertex_t::eval_sigma_pair_dyn: nosym mesh expected.");
    const nda::array<double, 2> kc(MF->kpts_crystal());
    auto tools_h = vd::make_dyn_tools(*_ft, _dyn_iaft_prec, G_CC);
    auto &tools = *tools_h.tools;
    utils::check(tools.nw_b == _ft->nw_b() and tools.nt_f == _ft->nt_f(),
                 "vertex_t::eval_sigma_pair_dyn: the Sigma hook needs the LOOP's grid (pol_vertex_dyn_iaft_prec must not refine it).");
    const long nq = long(_W0b_qmm.value().shape(0)), nw_b = tools.nw_b;
    std::vector<long> nus(static_cast<size_t>(nw_b)), qs(static_cast<size_t>(nq));
    for (long l = 0; l < nw_b; ++l) nus[size_t(l)] = l;
    for (long iq = 0; iq < nq; ++iq) qs[size_t(iq)] = iq;
    vd::sigma_dyn_hook hook;
    hook.col = opt.col;
    hook.outer = opt.outer;
    vd::dyn_opts o;
    o.kcrys = std::addressof(kc);
    o.tol = _dyn_tol; o.maxit = _dyn_maxit; o.gmres_m = std::max<long>(_dyn_gmres, 12); o.sign_ks = opt.sign_ks;
    o.rhs_block = _dyn_rhs_block;
    o.dense_rung = _dyn_dense;
    o.union_stride = _dyn_union_stride;
    o.table_mode = _dyn_table_mode;
    o.tfold = _dyn_tfold;
    o.vmask_lo = _dyn_vmask_lo; o.vmask_hi = _dyn_vmask_hi;
    o.static_only = (opt.col == "static_dyn");
    o.one_rung_only = (opt.col == "dyn1_bare");
    o.gamma1_only = (opt.col == "dyn1");
    o.sched_comm = mpi->comm.get();
    o.union_nodes = true;
    o.gap_mask = 0.0;
    if (char const *e = std::getenv("COQUI_DYNBSE_UNION")) o.union_nodes = (std::atoi(e) != 0);
    o.readout_tol = 1e-6;
    o.q_subset = std::addressof(qs);
    o.sigma = std::addressof(hook);
    vd::dyn_meter dmet;
    vd::pair_space_ladder_dyn(G_CC, _Xb_skma, _W0b_qmm.value(), _Wb_qwmm.value(), kmq, kpq, tools, nus,
                              nullptr, nullptr, nullptr, nullptr, mpi->comm.rank(), mpi->comm.size(), o, &dmet, symc);
    mpi->comm.all_reduce_in_place_n(hook.S_cst.data(), hook.S_cst.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(hook.RU.data(), hook.RU.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(hook.RT.data(), hook.RT.size(), std::plus<>{});
    dmet.reduce(mpi->comm);
    hook.ks_herm = mpi->comm.all_reduce_value(hook.ks_herm, boost::mpi3::max<>{});
    hook.amax = mpi->comm.all_reduce_value(hook.amax, boost::mpi3::max<>{});
    hook.ymax = mpi->comm.all_reduce_value(hook.ymax, boost::mpi3::max<>{});
    hook.t_sig = mpi->comm.all_reduce_value(hook.t_sig, boost::mpi3::max<>{});
    hook.nunits = mpi->comm.all_reduce_value(hook.nunits, std::plus<>{});
    double e_fit = 0.0;
    vd::sigma_dyn_finish(hook, opt.scale, MF->nkpts(), dSig, e_fit);
    const long nt = dSig.shape(0), ns = dSig.shape(1), nk = dSig.shape(2), nc = dSig.shape(3);
    double dmax = 0.0, dherm = 0.0;
    for (long it = 0; it < nt; ++it)
      for (long is = 0; is < ns; ++is)
        for (long k = 0; k < nk; ++k)
          for (long i = 0; i < nc; ++i)
            for (long j = 0; j < nc; ++j) {
              dmax = std::max(dmax, std::abs(dSig(it, is, k, i, j)));
              dherm = std::max(dherm, std::abs(dSig(it, is, k, i, j) - std::conj(dSig(it, is, k, j, i))));
            }
    if (opt.hermitize)
      for (long it = 0; it < nt; ++it)
        for (long is = 0; is < ns; ++is)
          for (long k = 0; k < nk; ++k)
            for (long i = 0; i < nc; ++i)
              for (long j = i; j < nc; ++j) {
                const ComplexType hv = 0.5 * (dSig(it, is, k, i, j) + std::conj(dSig(it, is, k, j, i)));
                dSig(it, is, k, i, j) = hv;
                dSig(it, is, k, j, i) = std::conj(hv);
              }
    sigma_pair_meter mloc;
    mloc.dsig_max = dmax; mloc.dsig_herm = (dmax > 0.0) ? dherm / dmax : 0.0; mloc.ks_herm = hook.ks_herm;
    mloc.nunits = hook.nunits; mloc.t_total = twatch.lap(); mloc.t_amp = hook.t_sig; mloc.rss_gb = dmet.rss_max_gb;
    mloc.e_fit_err = e_fit; mloc.fit_err_G = dmet.fit_err_G; mloc.refit_err = dmet.refit_err_max; mloc.ritz_max = dmet.ritz_max;
    mloc.t_solve = dmet.t_solve; mloc.all_converged = (dmet.nconv == dmet.nunits);
    app_log(1, "  [LFF-Sigma dyn] col {} outer {} scale {}: {} (s, q, nu) units on ALL {} bosonic nodes (union basis, GMRES({}), RHS blocks {}, "
               "C = [{}, {}), N_m = {}, n_p = {}): max |dSigma(tau)| = {:.4e}, anti-Hermitian residual {:.3e} ({}), |K_s - K_s^dag|/|K_s| = {:.2e}; "
               "max |A_cst| {:.3e}, max |y| {:.3e}; E-refit (T family) {:.2e}, G pole fit {:.2e}, tau refit {:.2e}, watchdog {:.3f}, all converged {}; "
               "wall {:.1f} s (solve {:.1f} s, Sigma deposits {:.1f} s on the slowest rank), RSS {:.2f} GB",
            opt.col, opt.outer, opt.scale, dmet.nunits, nw_b, o.gmres_m, o.rhs_block, _band_window.first(), _band_window.last(), _Xb_skma.shape(2),
            hook.np, dmax, mloc.dsig_herm, opt.hermitize ? "Hermitized" : "NOT Hermitized", hook.ks_herm, hook.amax, hook.ymax, e_fit,
            dmet.fit_err_G, dmet.refit_err_max, dmet.ritz_max, mloc.all_converged, mloc.t_total, dmet.t_solve, hook.t_sig, dmet.rss_max_gb);
    if (met) *met = mloc;
    (void)all;
  }
} // namespace solvers
} // namespace methods

#endif // COQUI_VERTEX_DYNBSE_ICC
