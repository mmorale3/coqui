#ifndef COQUI_VERTEX_LADDER_ICC
#define COQUI_VERTEX_LADDER_ICC

/**
 * scGW-tilde ladder polarization (notes/scgwt_implementation_plan.md increments L1-L3;
 * theory notes/scgw_screening_fix_proposal.pdf section 4.2).
 *
 * Density-channel BSE with the static screened kernel, resummed in the secondary-ISDF
 * pair basis:
 *
 *   Pi-bar = [1 - Pi-bar^0 K-bar]^-1 Pi-bar^0,   K-bar = +/- W-bar_0
 *
 * frequency-diagonal (static kernel => independent (q, inu) solves, N_m x N_m LAPACK on
 * replicated arrays, round-robin over the flattened (q, inu) index -- the
 * build_secondary_basis pattern). The sign and prefactor of K-bar are pinned by gate
 * L1-b, NOT by rederivation: upfold(Pi-bar^0 K-bar Pi-bar^0) with K-bar from build_w0
 * must reproduce the implemented static-rung Pi^C (eval_Pi_C static path), the object
 * already validated by dense oracles + GF2 + conservation. The ladder's first-order term
 * IS that static rung (PDF section 5.2) -- which is also why pol_vertex = "ladder"
 * excludes a vertex_type whose P injection carries the static/linear Pi^C (double
 * counting; guard in vertex_t::set_pol_vertex).
 *
 * Output contract (identical to eval_Pi_C at the scr_coulomb_t injection seam): return
 * on the CALLER's grid -- the Pi grid never splits q -- and the caller does +=.
 *
 * INCREMENT C0: scaffolding only. L1 lands the C-window pair bubble Pi-bar^0_mn(q, inu)
 * (reusing build_pair_component, build_Xbar, fold_core_block, iaft tau -> nu rows); L2
 * lands the ladder solve + the ladder_eps readout; L3 wires the in-loop injection.
 */

#include "utilities/check.hpp"

namespace methods {
namespace solvers {
namespace vertex_ladder_detail {

  // Every ladder entry funnels through this abort until L1/L2 land; the guard in
  // vertex_t::set_pol_vertex fires earlier (an ACTIVE pol_vertex aborts at setup),
  // so reaching this indicates a plumbing error.
  [[noreturn]] inline void ladder_not_implemented(std::string_view where) {
    utils::check(false,
                 "{}: pol_vertex = \"ladder\" is scaffolding only (increment C0); the "
                 "pair bubble, ladder solve and injection land in increments L1-L3 of "
                 "notes/scgwt_implementation_plan.md.", where);
    std::abort();  // unreachable: utils::check(false, ...) aborts
  }

} // vertex_ladder_detail
} // solvers
} // methods

#endif // COQUI_VERTEX_LADDER_ICC
