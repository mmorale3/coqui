#ifndef COQUI_VERTEX_LADDER_ICC
#define COQUI_VERTEX_LADDER_ICC

/**
 * scGW-tilde ladder polarization (notes/scgwt_implementation_plan.md increments L1-L3;
 * theory notes/scgw_screening_fix_proposal.pdf sections 4.2 and 5.2).
 *
 * THE PAIR SPACE (increment L1, corrected derivation 2026-08-11). The static-rung
 * Pi^C -- the anchor object, vertex_pi::pi_c_accumulate_w phase 1 -- decomposes
 * EXACTLY (verified index-by-index against the code; gate L1-b measures 3.2e-16) as
 *
 *   Pi^C_MN(q, nu) = pref sum_s sum_{k,k'} [ b23(k')^T K(k,k')^T b41(k) ]_{MN},
 *   pref = -(spin)/nk^2,
 *
 * with, in the ORBITAL-PAIR (hole, particle) space of the C window
 * (pair pack r = hole*nc + particle; dimension nc^2 per k, D = nc^2 nk overall):
 *
 *   b41(k) = chi0(k) . d(k),          b23(k') = chi0(k')^T . conj(d(k')),
 *   chi0_{(p1' nc + p3),(a nc + b)}(k; q, nu)
 *       = -sum_s' Twt(nu, s') G_{a p1'}(k, beta - s') G_{p3 b}(k + q, s'),
 *   d_{(a nc + b), N}(k) = Xb_{N a}(k) Xb*_{N b}(k + q),
 *   K(k,k')_{(p1' nc + p3),(p1 nc + p3')}
 *       = sum_{PQ} Xb_{P p1}(k') Xb*_{P p1'}(k) W0bar_{PQ}(k - k')
 *                  Xb_{Q p3}(k + q) Xb*_{Q p3'}(k' + q)
 *   (the anchor's U1^T W0 U2 fold with its to_wmat twist-packing).
 *
 * chi0 is the particle-hole PAIR PROPAGATOR (particle line at k+q, hole line at k);
 * d collapses a pair onto the coincident external density point N; K is the
 * qx = k - k' resolved e-h rung. The rebuild is an algebraic REARRANGEMENT of the
 * anchor's own sums, so gate L1-b demands MACHINE-precision agreement with no fitted
 * scale. (A first attempt composed the coincident pair-density bubble as Pi0.K.Pi0 --
 * the RING topology, resid 0.28 -- an error of that gate's own first implementation,
 * not physics; the ladder lives in the pair space above.)
 *
 * THE RESUMMATION (increment L2): the rung is STATIC, so every segment between rungs
 * is an independent pair bubble at the EXTERNAL nu (the bosonic rung-frequency sums
 * map bijectively onto independent fermionic segment sums -- exactly why the anchor's
 * phase 1 factorizes into b41(nu) x b23(nu)). The geometric series therefore closes
 * frequency-diagonally in the D-dimensional pair space, per (s, q, nu):
 *
 *   Pi_ladder = -spin * conj(D)^T (1 - Xh Kt)^{-1} Xh Kt Xh D     (all rungs >= 1),
 *   Xh = blockdiag_k( chi0(k) ) / nk,   Kt[(k'),(k)] = K(k,k')^T,
 *   D  = stack_k( d(k) ),
 *
 * whose n = 1 term is the anchor. Output contract (L3): return on the CALLER's grid
 * -- the Pi grid never splits q -- and the caller does +=.
 *
 * L1/L2 run NOSYM, window mode (the gate fixtures + the readout); symmetry + Wannier
 * ride with L3.
 */

#include "utilities/check.hpp"
#include "utilities/interpolation_utils.hpp"   // P4a: WS_rgrid for the R-space kernel

namespace methods {
namespace solvers {

  namespace vertex_ladder_detail {

    // Gc on the secondary interpolating points, all (s, k, t) replicated (N_m-class):
    //   Gc(s, k, t)_MN = [Xb(s,k) . G_CC(t,s,k) . Xb(s,k)^dag]_MN
    inline nda::array<ComplexType, 5>
    build_Gc_aux(nda::MemoryArrayOfRank<5> auto const &G_CC,      // (nt, ns, nk, nc, nc)
                 nda::array<ComplexType, 4> const &Xb_skma) {     // (ns, nk, Nm, nc)
      decltype(nda::range::all) all;
      const long nt = G_CC.shape(0), ns = G_CC.shape(1), nk = G_CC.shape(2);
      const long nc = G_CC.shape(3), Nm = Xb_skma.shape(2);
      nda::array<ComplexType, 5> Gc(ns, nk, nt, Nm, Nm);
      nda::array<ComplexType, 2> T(Nm, nc);
      nda::array<ComplexType, 2> Xd(nc, Nm);
      for (long is = 0; is < ns; ++is)
        for (long ik = 0; ik < nk; ++ik) {
          auto X = Xb_skma(is, ik, all, all);                     // (Nm, nc)
          for (long a = 0; a < nc; ++a)
            for (long m = 0; m < Nm; ++m) Xd(a, m) = std::conj(X(m, a));
          for (long it = 0; it < nt; ++it) {
            nda::blas::gemm(X, G_CC(it, is, ik, all, all), T);
            nda::blas::gemm(T, Xd, Gc(is, ik, it, all, all));
          }
        }
      return Gc;
    }

    /**
     * C-window G on the FULL BZ (C.2): a plain window slice on nosym meshes; under
     * symmetry the image points are gauge copies of the IBZ blocks (identity D by
     * convention, symmetry.hpp:910) and trev points are the tau-pointwise TRANSPOSE
     * -- the eval-path contract verbatim (vertex_t.cpp SIG_SECONDARY block, memo
     * (G1)/(G2); no tau-mirror anywhere).
     */
    inline void expand_G_CC_fullbz(nda::MemoryArrayOfRank<5> auto const &G_tskij,
                                   nda::range bw, bool sym_mesh,
                                   auto const &kp_to_ibz, auto const &kp_trev,
                                   nda::array<ComplexType, 5> &G_CC) {
      decltype(nda::range::all) all;
      const long nt = G_CC.shape(0), ns = G_CC.shape(1), nk = G_CC.shape(2);
      const long nc = G_CC.shape(3);
      if (not sym_mesh) {
        G_CC = G_tskij(all, all, all, bw, bw);
        return;
      }
      for (long kp = 0; kp < nk; ++kp) {
        const long kib = kp_to_ibz(kp);
        if (not kp_trev(kp)) {
          G_CC(all, all, kp, all, all) = G_tskij(all, all, kib, bw, bw);
        } else {
          for (long it = 0; it < nt; ++it)
            for (long is = 0; is < ns; ++is)
              for (long a = 0; a < nc; ++a)
                for (long b = 0; b < nc; ++b)
                  G_CC(it, is, kp, a, b) =
                      G_tskij(it, is, kib, bw.first() + b, bw.first() + a);
        }
      }
    }

    /**
     * THE PAIR-SPACE LADDER CORE (file header for the derivation and conventions).
     * For the bosonic nodes in nu_list, accumulate the one-rung rebuild and/or the
     * resummed ladder (rungs >= 1) into (i_nu, iq)-indexed (Nm x Nm) outputs.
     *
     * P2 (notes/scgwt_parallel_memory_design.md): the flattened (s, iq) pairs are
     * round-robined over (rank, nproc) -- each owner builds its K blocks ONCE (they
     * are nu-independent) and runs all requested nu. Every (jn, iq) output cell is
     * written by exactly one rank, so the caller's all_reduce (zeros elsewhere)
     * reproduces the replicated result BITWISE. (rank, nproc) = (0, 1) = the
     * replicated/toy mode. Outputs are ZEROED here, indexed by POSITION in nu_list.
     *
     * C.2 IBZ SYMMETRY (the pi_c_accumulate_w contract, notes/vertex_ibz_symmetry.md):
     * with an active symc the EXTERNAL q axis of the outputs is nq_ibz, W0b carries
     * nq_ibz rows, kmq/kpq carry the FULL transfer mesh, and G_CC/Xb are full-BZ
     * objects. The rung K(k,k') then reads W0bar at q_star(qx) (PQ-TRANSPOSED for
     * trev transfers, memo (P2)) with the four legs on the effective columns
     * Xhat(is, jsym, .) through the anchor's OWN leg builder
     * (vertex_pi::detail::build_U_legs -- the single source; identical assignments on
     * the nosym path). nullptr / !active: all axes coincide, bit-identical to the
     * historic kernel.
     */
    inline void pair_space_ladder(nda::MemoryArrayOfRank<5> auto const &G_CC,  // (nt,ns,nk,nc,nc)
                                  nda::array<ComplexType, 4> const &Xb,        // (ns,nk,Nm,nc)
                                  nda::array<ComplexType, 3> const &W0b,       // (nq_w,Nm,Nm)
                                  nda::array<long, 2> const &kmq,
                                  nda::array<long, 2> const &kpq,
                                  vertex_pi::iaft_tools const &tools,
                                  std::vector<long> const &nu_list,
                                  nda::array<ComplexType, 4> *Pi_onerung,  // (nnu,nq_ext,Nm,Nm) or null
                                  nda::array<ComplexType, 4> *Pi_ladder,   // (nnu,nq_ext,Nm,Nm) or null
                                  long rank = 0, long nproc = 1,
                                  vertex_sym::sym_ctx const *symc = nullptr) {
      decltype(nda::range::all) all;
      const long nt = G_CC.shape(0), ns = G_CC.shape(1), nk = G_CC.shape(2);
      const long nc = G_CC.shape(3), Nm = Xb.shape(2);
      const long nw_b = tools.nw_b;
      const long nc2 = nc * nc, Dsz = nc2 * nk;
      const long nnu = long(nu_list.size());
      const double spinfac = (ns == 1) ? 2.0 : 1.0;
      const double pref = -spinfac / double(nk * nk);
      // symmetry bookkeeping (the pi_c_accumulate_w axes): nq_w = stored rung rows,
      // nq_full = internal transfer mesh, nq_ext = external output q axis.
      const bool sym = (symc != nullptr and symc->active);
      const long nq_w = W0b.shape(0);
      const long nq_full = kmq.shape(0);
      utils::check(Pi_onerung != nullptr or Pi_ladder != nullptr,
                   "pair_space_ladder: no output requested.");
      const long nq_ext = (Pi_onerung != nullptr) ? Pi_onerung->shape(1)
                                                  : Pi_ladder->shape(1);
      if (Pi_onerung != nullptr and Pi_ladder != nullptr)
        utils::check(Pi_ladder->shape(1) == nq_ext,
                     "pair_space_ladder: output q axes differ.");
      if (sym) {
        utils::check(nq_w == symc->nq_ibz and nq_ext == symc->nq_ibz and
                     nq_full == symc->nq_full and nk == symc->nk_full,
                     "pair_space_ladder: symmetry context dimension mismatch (nq_w = {}, "
                     "nq_ext = {}, nq_full = {}, nk = {} vs ctx {}, {}, {}).",
                     nq_w, nq_ext, nq_full, nk, symc->nq_ibz, symc->nq_full,
                     symc->nk_full);
        utils::check(symc->naux == Nm and symc->nc == nc,
                     "pair_space_ladder: symmetry context Xhat mismatch (naux = {} vs "
                     "Nm = {}, nc = {} vs {}).", symc->naux, Nm, symc->nc, nc);
      } else {
        utils::check(nq_w == nq_full and nq_ext == nq_full,
                     "pair_space_ladder: inconsistent q axes without a symmetry context "
                     "(nq_w = {}, nq_full = {}, nq_ext = {}).", nq_w, nq_full, nq_ext);
      }
      utils::check(kmq.shape(1) == nk and kpq.shape(0) >= nq_ext and kpq.shape(1) == nk,
                   "pair_space_ladder: kmq/kpq shape mismatch.");
      for (auto m : nu_list)
        utils::check(m >= 0 and m < nw_b, "pair_space_ladder: nu index {} out of range.", m);
      if (Pi_onerung != nullptr) (*Pi_onerung)() = ComplexType(0.0);
      if (Pi_ladder != nullptr) (*Pi_ladder)() = ComplexType(0.0);

      // qx lookup: kmq(qx, k) = k'  =>  qx_of(k, k')
      nda::array<long, 2> qx_of(nk, nk);
      qx_of() = -1;
      for (long iqx = 0; iqx < nq_full; ++iqx)
        for (long ik = 0; ik < nk; ++ik) qx_of(ik, kmq(iqx, ik)) = iqx;
      for (long ik = 0; ik < nk; ++ik)
        for (long ikp = 0; ikp < nk; ++ikp)
          utils::check(qx_of(ik, ikp) >= 0,
                       "pair_space_ladder: transfer mesh does not connect k = {} to "
                       "k' = {}.", ik, ikp);

      nda::array<ComplexType, 3> Dmat(nk, nc2, Nm), Dcj(nk, nc2, Nm);
      nda::array<ComplexType, 4> Cb(nk, nnu, nc2, nc2);
      nda::array<ComplexType, 4> Kb(nk, nk, nc2, nc2);
      nda::array<ComplexType, 2> Pf(nt, nc2 * nc2), Bf(nw_b, nc2 * nc2);
      nda::array<ComplexType, 2> U1(Nm, nc2), U2(Nm, nc2), WU2(Nm, nc2), wb(nc2, nc2);
      nda::array<ComplexType, 3> Y1(nk, nc2, Nm), Y2(nk, nc2, Nm);
      nda::array<ComplexType, 2> KtY1(nc2, Nm), T2(Nm, Nm);
      nda::matrix<ComplexType> Rm(Dsz, Dsz);
      nda::array<ComplexType, 2> Kbig(Dsz, Dsz), XK(Dsz, Dsz);
      nda::array<ComplexType, 2> XD(Dsz, Nm), KXD(Dsz, Nm), XKXD(Dsz, Nm), Zl(Dsz, Nm);
      nda::array<ComplexType, 2> Dstack_c(Dsz, Nm);

      for (long sq = rank; sq < ns * nq_ext; sq += nproc) {
        const long is = sq / nq_ext;
        const long iq = sq % nq_ext;
        {
          // --- d(k) and the chi0 blocks (only the requested nu rows are kept) ---------
          for (long ik = 0; ik < nk; ++ik) {
            const long ikpq = kpq(iq, ik);
            for (long a = 0; a < nc; ++a)
              for (long b = 0; b < nc; ++b)
                for (long N = 0; N < Nm; ++N) {
                  Dmat(ik, a * nc + b, N) =
                      Xb(is, ik, N, a) * std::conj(Xb(is, ikpq, N, b));
                  Dcj(ik, a * nc + b, N) = std::conj(Dmat(ik, a * nc + b, N));
                }
            for (long s = 0; s < nt; ++s) {
              const long sm = tools.t_mirror(s);
              for (long p1p = 0; p1p < nc; ++p1p)
                for (long p3 = 0; p3 < nc; ++p3)
                  for (long a = 0; a < nc; ++a)
                    for (long b = 0; b < nc; ++b)
                      Pf(s, (p1p * nc + p3) * nc2 + (a * nc + b)) =
                          G_CC(sm, is, ik, a, p1p) * G_CC(s, is, ikpq, p3, b);
            }
            nda::blas::gemm(ComplexType(-1.0), tools.Twt_bb, Pf, ComplexType(0.0), Bf);
            for (long jn = 0; jn < nnu; ++jn)
              for (long r = 0; r < nc2; ++r)
                for (long c = 0; c < nc2; ++c)
                  Cb(ik, jn, r, c) = Bf(nu_list[jn], r * nc2 + c);
          }
          // --- the rung blocks K(k, k') (nu-independent) -------------------------------
          // qx = k - k' (kmq orientation; the ladder's k' IS the anchor's ikmqx). The
          // legs go through the anchor's OWN builder (identical assignments on the
          // nosym path; Xhat(is, jsx, .) under symmetry) and the rung is read at
          // q_star(qx), PQ-TRANSPOSED for trev transfers (memo (P2)).
          for (long ik = 0; ik < nk; ++ik) {
            const long ikpq = kpq(iq, ik);
            for (long ikp = 0; ikp < nk; ++ikp) {
              const long iqx = qx_of(ik, ikp);
              const long ikppq = kpq(iq, ikp);
              const long jsx = sym ? symc->q_isym(iqx) : 0l;
              const long qsx = sym ? symc->q_star(iqx) : iqx;
              const bool trx = sym ? bool(symc->q_trev(iqx)) : false;
              vertex_pi::detail::build_U_legs(Xb, symc, nda::range(0, nc), is, ik, ikp,
                                              ikpq, ikppq, jsx, U1, U2);
              if (trx)
                nda::blas::gemm(nda::transpose(W0b(qsx, all, all)), U2, WU2);
              else
                nda::blas::gemm(W0b(qsx, all, all), U2, WU2);
              nda::blas::gemm(nda::transpose(U1), WU2, wb);
              // twist-pack (the anchor's to_wmat):
              //   K_{(p1' nc + p3),(p1 nc + p3')} = wb_{(p1 nc + p1'),(p3 nc + p3')}
              for (long p1 = 0; p1 < nc; ++p1)
                for (long p1p = 0; p1p < nc; ++p1p)
                  for (long p3 = 0; p3 < nc; ++p3)
                    for (long p3p = 0; p3p < nc; ++p3p)
                      Kb(ik, ikp, p1p * nc + p3, p1 * nc + p3p) =
                          wb(p1 * nc + p1p, p3 * nc + p3p);
            }
          }
          // --- Kt[(k'),(k)] = K(k,k')^T and conj(D) stack (nu-independent) -------------
          for (long ikp = 0; ikp < nk; ++ikp)
            for (long ik = 0; ik < nk; ++ik)
              for (long r = 0; r < nc2; ++r)
                for (long c = 0; c < nc2; ++c)
                  Kbig(ikp * nc2 + r, ik * nc2 + c) = Kb(ik, ikp, c, r);
          for (long ik = 0; ik < nk; ++ik)
            for (long r = 0; r < nc2; ++r) Dstack_c(ik * nc2 + r, all) = Dcj(ik, r, all);

          // --- per requested nu: one-rung rebuild + resummation ------------------------
          for (long jn = 0; jn < nnu; ++jn) {
            if (Pi_onerung != nullptr) {
              for (long ik = 0; ik < nk; ++ik) {
                nda::blas::gemm(Cb(ik, jn, all, all), Dmat(ik, all, all),
                                Y1(ik, all, all));
                nda::blas::gemm(nda::transpose(Cb(ik, jn, all, all)), Dcj(ik, all, all),
                                Y2(ik, all, all));
              }
              auto Pr = (*Pi_onerung)(jn, iq, all, all);
              for (long ik = 0; ik < nk; ++ik)
                for (long ikp = 0; ikp < nk; ++ikp) {
                  nda::blas::gemm(nda::transpose(Kb(ik, ikp, all, all)),
                                  Y1(ik, all, all), KtY1);
                  nda::blas::gemm(ComplexType(pref), nda::transpose(Y2(ikp, all, all)),
                                  KtY1, ComplexType(0.0), T2);
                  Pr += T2;
                }
            }
            if (Pi_ladder == nullptr) continue;
            // Pi_ladder = -spin conj(D)^T (1 - Xh Kt)^{-1} Xh Kt Xh D
            for (long ikp = 0; ikp < nk; ++ikp) {
              auto Krows = Kbig(nda::range(ikp * nc2, (ikp + 1) * nc2), all);
              auto Xrows = XK(nda::range(ikp * nc2, (ikp + 1) * nc2), all);
              nda::blas::gemm(ComplexType(1.0 / nk), Cb(ikp, jn, all, all), Krows,
                              ComplexType(0.0), Xrows);
            }
            for (long ik = 0; ik < nk; ++ik) {
              auto Drows = XD(nda::range(ik * nc2, (ik + 1) * nc2), all);
              nda::blas::gemm(ComplexType(1.0 / nk), Cb(ik, jn, all, all),
                              Dmat(ik, all, all), ComplexType(0.0), Drows);
            }
            nda::blas::gemm(Kbig, XD, KXD);
            for (long ikp = 0; ikp < nk; ++ikp) {
              auto Kr = KXD(nda::range(ikp * nc2, (ikp + 1) * nc2), all);
              auto Xr = XKXD(nda::range(ikp * nc2, (ikp + 1) * nc2), all);
              nda::blas::gemm(ComplexType(1.0 / nk), Cb(ikp, jn, all, all), Kr,
                              ComplexType(0.0), Xr);
            }
            Rm() = ComplexType(0.0);
            Rm() -= XK;
            for (long i = 0; i < Dsz; ++i) Rm(i, i) += ComplexType(1.0);
            nda::inverse_in_place(Rm);
            nda::blas::gemm(Rm, XKXD, Zl);
            auto Pl = (*Pi_ladder)(jn, iq, all, all);
            nda::blas::gemm(ComplexType(-spinfac), nda::transpose(Dstack_c), Zl,
                            ComplexType(1.0), Pl);
          }
        }
      }
    }

    // =================================================================================
    // P4a (notes/scgwt_parallel_memory_design.md section 4b.1): the R-space kernel
    //   K = sum_L (1/w_L) R_L^T W^_L C_L,   w_PQ(L) = (1/N_k) sum_qx e^{-i qx.L} W0bar_PQ(qx)
    // with W^_L DIAGONAL over the (P,Q)-pair channel. v1 stores w(L) DENSE per kept L
    // (gemm-only apply; the sampled kept-(P,Q) path is the production follow-up, to be
    // pinned bit-identically against this one). The chain applies K~ = K^T (the
    // verified Kbig orientation), so the apply below is the K~-apply.
    // =================================================================================
    struct ladder_kernel_rs {
      long Nm = 0, nL = 0, nL_full = 0;
      nda::array<double, 2> Lcart;          // (nL, 3) kept L vectors, cartesian
      nda::array<ComplexType, 3> w;         // (nL, Nm, Nm): w_PQ(L)/w_L (1/w_L folded in)
      double dropped_frac = 0.0;            // dropped ||w(L)|| fraction (the L meter)
      // sampled kept-(P,Q) mode (tau_PQ > 0; design note section 4b.1 step (ii)):
      // ONE global kept-pair list over the (P,Q) channel, kernel values stored on it
      // only -- the dense (nL, Nm, Nm) store never exists in this mode. Thresholds and
      // meters use the FOLDED values w_PQ(L)/w_L (what the apply consumes).
      bool sampled = false;
      nda::array<long, 1> pq_P, pq_Q;       // (n_pq) kept-pair channel indices
      nda::array<ComplexType, 2> w_pq;      // (nL, n_pq): w_PQ(L)/w_L on the kept list
      double pq_kept_frac = 1.0;            // n_pq / Nm^2 (the pair meter)
      double pq_dropped_wfrac = 0.0;        // dropped pair-channel ||w||_F fraction
    };

    // cartesian L vectors from lattice-unit indices (the cvv_detail::rcart_from_idx
    // math, duplicated locally to keep this module free of scr_coulomb headers)
    inline nda::array<double, 2> lcart_from_idx(nda::MemoryArrayOfRank<2> auto const &Lidx,
                                                nda::stack_array<double, 3, 3> const &lattv) {
      const long nL = Lidx.shape(0);
      nda::array<double, 2> Lc(nL, 3);
      for (long i = 0; i < nL; ++i)
        for (int a = 0; a < 3; ++a)
          Lc(i, a) = Lidx(i, 0) * lattv(0, a) + Lidx(i, 1) * lattv(1, a) +
                     Lidx(i, 2) * lattv(2, a);
      return Lc;
    }

    /** Build the R-space kernel from W0bar on the transfer mesh. tol_L = 0 keeps every
     *  L shell => the WS round trip is EXACT on mesh qx (the CVV-verified pair). The
     *  shell rule is the CVV cumulative-dropped-norm walk (outermost first, L = 0
     *  never dropped). One dense (Nm, Nm) buffer at a time -- no (nL, Nm^2) transient
     *  beyond the kept set.
     *  tau_PQ > 0 selects the SAMPLED kept-(P,Q) mode (design 4b.1 step (ii)): keep
     *  the pairs with max_L |w_PQ(L)/w_L| >= tau_PQ * max over the kept L set (one
     *  global list, v1), store the kernel values on the list only. tau_PQ = 0 is the
     *  dense-w path, untouched. */
    inline ladder_kernel_rs build_kernel_rs(nda::array<ComplexType, 3> const &W0b,
                                            nda::MemoryArrayOfRank<2> auto const &Qpts,
                                            nda::stack_array<double, 3, 3> const &lattv,
                                            nda::MemoryArrayOfRank<1> auto const &kp_grid,
                                            double tol_L, double tau_PQ = 0.0) {
      decltype(nda::range::all) all;
      const long nq = W0b.shape(0), Nm = W0b.shape(1);
      auto [lw, lp] = utils::WS_rgrid(lattv, kp_grid);
      const long nLf = lp.shape(0);
      auto Lc = lcart_from_idx(lp, lattv);
      nda::array<ComplexType, 2> wbuf(Nm, Nm);
      auto wL_at = [&](long iL) {
        wbuf() = ComplexType(0.0);
        for (long iqx = 0; iqx < nq; ++iqx) {
          const double qL = Qpts(iqx, 0) * Lc(iL, 0) + Qpts(iqx, 1) * Lc(iL, 1) +
                            Qpts(iqx, 2) * Lc(iL, 2);
          const ComplexType ph = std::exp(ComplexType(0.0, -qL)) / double(nq);
          wbuf += ph * W0b(iqx, all, all);
        }
      };
      // pass 1: per-L squared norms
      std::vector<double> n2(nLf, 0.0), rad(nLf);
      for (long iL = 0; iL < nLf; ++iL) {
        wL_at(iL);
        for (auto const &v : wbuf) n2[iL] += std::norm(v);
        rad[iL] = std::sqrt(Lc(iL, 0) * Lc(iL, 0) + Lc(iL, 1) * Lc(iL, 1) +
                            Lc(iL, 2) * Lc(iL, 2));
      }
      // shell walk (outermost first; cumulative bound; L = 0 kept)
      std::vector<long> order(nLf);
      for (long i = 0; i < nLf; ++i) order[i] = i;
      std::sort(order.begin(), order.end(), [&](long a, long b) { return rad[a] > rad[b]; });
      const double tot2 = std::accumulate(n2.begin(), n2.end(), 0.0);
      std::vector<bool> drop(nLf, false);
      double drop2 = 0.0;
      {
        long i = 0;
        while (i < nLf) {
          long j = i;
          double shell2 = 0.0;
          while (j < nLf and std::abs(rad[order[j]] - rad[order[i]]) < 1e-8) {
            shell2 += n2[order[j]];
            ++j;
          }
          if (rad[order[i]] < 1e-12) break;
          if (std::sqrt((drop2 + shell2) / std::max(tot2, 1e-300)) > tol_L) break;
          drop2 += shell2;
          for (long m = i; m < j; ++m) drop[order[m]] = true;
          i = j;
        }
      }
      ladder_kernel_rs ker;
      ker.Nm = Nm;
      ker.nL_full = nLf;
      std::vector<long> kept;
      for (long iL = 0; iL < nLf; ++iL)
        if (not drop[iL]) kept.push_back(iL);
      ker.nL = long(kept.size());
      ker.Lcart = nda::array<double, 2>(ker.nL, 3);
      for (long i = 0; i < ker.nL; ++i)
        for (int a = 0; a < 3; ++a) ker.Lcart(i, a) = Lc(kept[i], a);
      if (tau_PQ <= 0.0) {
        ker.w = nda::array<ComplexType, 3>(ker.nL, Nm, Nm);
        for (long i = 0; i < ker.nL; ++i) {
          const long iL = kept[i];
          wL_at(iL);                                 // pass 2: recompute, fold 1/w_L
          ker.w(i, all, all) = wbuf;
          ker.w(i, all, all) /= double(lw(iL));
        }
      } else {
        // pass 2a: per-pair max and Frobenius weight of the FOLDED values over kept L
        ker.sampled = true;
        nda::array<double, 2> mx(Nm, Nm), n2p(Nm, Nm);
        mx() = 0.0;
        n2p() = 0.0;
        for (long i = 0; i < ker.nL; ++i) {
          const long iL = kept[i];
          wL_at(iL);
          const double wLi = 1.0 / double(lw(iL));
          for (long P = 0; P < Nm; ++P)
            for (long Q = 0; Q < Nm; ++Q) {
              const double a = std::abs(wbuf(P, Q)) * wLi;
              mx(P, Q) = std::max(mx(P, Q), a);
              n2p(P, Q) += a * a;
            }
        }
        double wmax = 0.0;
        for (long P = 0; P < Nm; ++P)
          for (long Q = 0; Q < Nm; ++Q) wmax = std::max(wmax, mx(P, Q));
        std::vector<long> pq;
        double kept2 = 0.0, all2 = 0.0;
        for (long P = 0; P < Nm; ++P)
          for (long Q = 0; Q < Nm; ++Q) {
            all2 += n2p(P, Q);
            if (mx(P, Q) >= tau_PQ * wmax) {
              pq.push_back(P * Nm + Q);
              kept2 += n2p(P, Q);
            }
          }
        const long npq = long(pq.size());
        ker.pq_P = nda::array<long, 1>(npq);
        ker.pq_Q = nda::array<long, 1>(npq);
        for (long ip = 0; ip < npq; ++ip) {
          ker.pq_P(ip) = pq[ip] / Nm;
          ker.pq_Q(ip) = pq[ip] % Nm;
        }
        ker.pq_kept_frac = double(npq) / double(Nm * Nm);
        ker.pq_dropped_wfrac =
            std::sqrt(std::max(all2 - kept2, 0.0) / std::max(all2, 1e-300));
        // pass 2b: gather the kernel values on the kept list, 1/w_L folded
        ker.w_pq = nda::array<ComplexType, 2>(ker.nL, npq);
        for (long i = 0; i < ker.nL; ++i) {
          const long iL = kept[i];
          wL_at(iL);
          const double wLi = 1.0 / double(lw(iL));
          for (long ip = 0; ip < npq; ++ip)
            ker.w_pq(i, ip) = wbuf(ker.pq_P(ip), ker.pq_Q(ip)) * wLi;
        }
      }
      ker.dropped_frac = std::sqrt(drop2 / std::max(tot2, 1e-300));
      app_log(2, "  [scGW-tilde P4a] R-space kernel: {} / {} L shells kept "
                 "(tol_L = {}); dropped ||w(L)|| fraction = {:.3e}",
              ker.nL, nLf, tol_L, ker.dropped_frac);
      if (ker.sampled)
        app_log(2, "  [scGW-tilde P4a] sampled (P,Q) channel: {} / {} pairs kept "
                   "(tau_PQ = {}); dropped pair ||w|| fraction = {:.3e}",
                long(ker.pq_P.shape(0)), Nm * Nm, tau_PQ, ker.pq_dropped_wfrac);
      return ker;
    }

    /**
     * The sampled kept-(P,Q) K~-apply (design 4b.1 step (ii)): the same three-phase
     * sweep as the dense apply below, but the (P,Q) channel is visited on the kernel's
     * global kept list only -- the dense T2 (forward) and A1 (backward) gemms become
     * nc-length dots / rank-1 scatters per kept pair. Same summand values and p3/p1
     * orderings as the dense path (the all-kept limit differs only by the gemm-vs-dot
     * accumulation class). Y is OVERWRITTEN.
     */
    inline void apply_kernel_rs_sampled(ladder_kernel_rs const &ker,
                                        nda::array<ComplexType, 4> const &Xb, long is,
                                        nda::array<long, 2> const &kpq, long iq,
                                        nda::array<double, 2> const &kpts,
                                        nda::MemoryArrayOfRank<2> auto const &X,   // (D, B)
                                        nda::MemoryArrayOfRank<2> auto &&Y) {      // (D, B)
      decltype(nda::range::all) all;
      const long nk = kpq.shape(1), nc = Xb.shape(3), Nm = ker.Nm;
      const long nc2 = nc * nc, B = X.shape(1);
      const long npq = ker.pq_P.shape(0);
      utils::check(X.shape(0) == nc2 * nk and Y.shape(0) == nc2 * nk and
                   Y.shape(1) == B, "apply_kernel_rs_sampled: block shape mismatch.");
      Y() = ComplexType(0.0);
      nda::array<ComplexType, 2> Xw(nc2, B), T1(Nm, nc * B);
      nda::array<ComplexType, 2> Xkc(Nm, nc), Xq3(nc, Nm);
      nda::array<ComplexType, 2> Gsp(npq, B);
      nda::array<ComplexType, 2> Xp1(nc, Nm), Xqc(Nm, nc), A2s(nc * B, nc);
      for (long iL = 0; iL < ker.nL; ++iL) {
        Gsp() = ComplexType(0.0);
        // ---- forward sweep: the T1 map gemm, then per kept pair an nc-length dot ----
        for (long ik = 0; ik < nk; ++ik) {
          const long ikpq = kpq(iq, ik);
          const double kL = kpts(ik, 0) * ker.Lcart(iL, 0) +
                            kpts(ik, 1) * ker.Lcart(iL, 1) +
                            kpts(ik, 2) * ker.Lcart(iL, 2);
          const ComplexType php = std::exp(ComplexType(0.0, kL));
          Xw() = X(nda::range(ik * nc2, (ik + 1) * nc2), all);
          auto X3 = nda::reshape(Xw, std::array<long, 2>{nc, nc * B});  // p1' x (p3, b)
          for (long P = 0; P < Nm; ++P)
            for (long p = 0; p < nc; ++p) Xkc(P, p) = std::conj(Xb(is, ik, P, p));
          nda::blas::gemm(Xkc, X3, T1);                  // P x (p3, b)
          for (long p3 = 0; p3 < nc; ++p3)
            for (long Q = 0; Q < Nm; ++Q) Xq3(p3, Q) = Xb(is, ikpq, Q, p3);
          for (long ip = 0; ip < npq; ++ip) {
            const long P = ker.pq_P(ip), Q = ker.pq_Q(ip);
            for (long b = 0; b < B; ++b) {
              ComplexType g(0.0);
              for (long p3 = 0; p3 < nc; ++p3) g += T1(P, p3 * B + b) * Xq3(p3, Q);
              Gsp(ip, b) += php * g;
            }
          }
        }
        // ---- the diagonal kernel on the kept list -----------------------------------
        for (long ip = 0; ip < npq; ++ip) {
          const ComplexType wv = ker.w_pq(iL, ip);
          for (long b = 0; b < B; ++b) Gsp(ip, b) *= wv;
        }
        // ---- backward sweep: rank-1 (p1 x p3') scatter per kept pair ----------------
        for (long ikp = 0; ikp < nk; ++ikp) {
          const long ikppq = kpq(iq, ikp);
          const double kL = kpts(ikp, 0) * ker.Lcart(iL, 0) +
                            kpts(ikp, 1) * ker.Lcart(iL, 1) +
                            kpts(ikp, 2) * ker.Lcart(iL, 2);
          const ComplexType phm = std::exp(ComplexType(0.0, -kL));
          for (long p1 = 0; p1 < nc; ++p1)
            for (long P = 0; P < Nm; ++P) Xp1(p1, P) = Xb(is, ikp, P, p1);
          for (long Q = 0; Q < Nm; ++Q)
            for (long p3p = 0; p3p < nc; ++p3p)
              Xqc(Q, p3p) = std::conj(Xb(is, ikppq, Q, p3p));
          A2s() = ComplexType(0.0);
          for (long ip = 0; ip < npq; ++ip) {
            const long P = ker.pq_P(ip), Q = ker.pq_Q(ip);
            for (long b = 0; b < B; ++b) {
              const ComplexType c = Gsp(ip, b);
              for (long p1 = 0; p1 < nc; ++p1) {
                const ComplexType t = Xp1(p1, P) * c;
                for (long p3p = 0; p3p < nc; ++p3p)
                  A2s(p1 * B + b, p3p) += t * Xqc(Q, p3p);
              }
            }
          }
          for (long p1 = 0; p1 < nc; ++p1)
            for (long p3p = 0; p3p < nc; ++p3p)
              for (long b = 0; b < B; ++b)
                Y(ikp * nc2 + p1 * nc + p3p, b) += phm * A2s(p1 * B + b, p3p);
        }
      }
    }

    /**
     * The chain-native K~-apply (K~ = K^T, the verified Kbig orientation):
     *   out_{(p1 nc + p3', k'), b} = sum_L e^{-i k'.L} sum_{PQ} X_P,p1(k') X*_Q,p3'(k'+q)
     *       [w_PQ(L)/w_L] sum_k e^{+i k.L} sum_{p1' p3} X*_P,p1'(k) X_Q,p3(k+q) x_{(p1' nc + p3, k), b}
     * Dense-w v1: gemms + small permute copies only. Y is OVERWRITTEN. A sampled
     * kernel (tau_PQ > 0) dispatches to apply_kernel_rs_sampled.
     */
    inline void apply_kernel_rs(ladder_kernel_rs const &ker,
                                nda::array<ComplexType, 4> const &Xb, long is,
                                nda::array<long, 2> const &kpq, long iq,
                                nda::array<double, 2> const &kpts,
                                nda::MemoryArrayOfRank<2> auto const &X,   // (D, B)
                                nda::MemoryArrayOfRank<2> auto &&Y) {      // (D, B)
      if (ker.sampled) {
        apply_kernel_rs_sampled(ker, Xb, is, kpq, iq, kpts, X, Y);
        return;
      }
      decltype(nda::range::all) all;
      const long nk = kpq.shape(1), nc = Xb.shape(3), Nm = ker.Nm;
      const long nc2 = nc * nc, B = X.shape(1);
      utils::check(X.shape(0) == nc2 * nk and Y.shape(0) == nc2 * nk and
                   Y.shape(1) == B, "apply_kernel_rs: block shape mismatch.");
      Y() = ComplexType(0.0);
      nda::array<ComplexType, 2> Xw(nc2, B), T1(Nm, nc * B), T1p(Nm * B, nc);
      nda::array<ComplexType, 2> Xkc(Nm, nc), Xq3(nc, Nm), T2p(Nm * B, Nm);
      nda::array<ComplexType, 2> G(Nm * Nm, B);
      nda::array<ComplexType, 2> Xp1(nc, Nm), A1(nc, Nm * B), A1p(nc * B, Nm);
      nda::array<ComplexType, 2> Xqc(Nm, nc), A2(nc * B, nc);
      for (long iL = 0; iL < ker.nL; ++iL) {
        G() = ComplexType(0.0);
        // ---- forward sweep (contract the R_L side with the input rows) ---------------
        for (long ik = 0; ik < nk; ++ik) {
          const long ikpq = kpq(iq, ik);
          const double kL = kpts(ik, 0) * ker.Lcart(iL, 0) +
                            kpts(ik, 1) * ker.Lcart(iL, 1) +
                            kpts(ik, 2) * ker.Lcart(iL, 2);
          const ComplexType php = std::exp(ComplexType(0.0, kL));
          Xw() = X(nda::range(ik * nc2, (ik + 1) * nc2), all);
          auto X3 = nda::reshape(Xw, std::array<long, 2>{nc, nc * B});  // p1' x (p3, b)
          for (long P = 0; P < Nm; ++P)
            for (long p = 0; p < nc; ++p) Xkc(P, p) = std::conj(Xb(is, ik, P, p));
          nda::blas::gemm(Xkc, X3, T1);                    // P x (p3, b)
          for (long P = 0; P < Nm; ++P)
            for (long p3 = 0; p3 < nc; ++p3)
              for (long b = 0; b < B; ++b) T1p(P * B + b, p3) = T1(P, p3 * B + b);
          for (long p3 = 0; p3 < nc; ++p3)
            for (long Q = 0; Q < Nm; ++Q) Xq3(p3, Q) = Xb(is, ikpq, Q, p3);
          nda::blas::gemm(T1p, Xq3, T2p);                  // (P, b) x Q
          for (long P = 0; P < Nm; ++P)
            for (long Q = 0; Q < Nm; ++Q)
              for (long b = 0; b < B; ++b)
                G(P * Nm + Q, b) += php * T2p(P * B + b, Q);
        }
        // ---- the diagonal (P,Q)-channel kernel --------------------------------------
        for (long P = 0; P < Nm; ++P)
          for (long Q = 0; Q < Nm; ++Q) {
            const ComplexType wv = ker.w(iL, P, Q);
            for (long b = 0; b < B; ++b) G(P * Nm + Q, b) *= wv;
          }
        // ---- backward sweep (emit on the C_L side) ----------------------------------
        for (long ikp = 0; ikp < nk; ++ikp) {
          const long ikppq = kpq(iq, ikp);
          const double kL = kpts(ikp, 0) * ker.Lcart(iL, 0) +
                            kpts(ikp, 1) * ker.Lcart(iL, 1) +
                            kpts(ikp, 2) * ker.Lcart(iL, 2);
          const ComplexType phm = std::exp(ComplexType(0.0, -kL));
          for (long p1 = 0; p1 < nc; ++p1)
            for (long P = 0; P < Nm; ++P) Xp1(p1, P) = Xb(is, ikp, P, p1);
          auto Gv = nda::reshape(G, std::array<long, 2>{Nm, Nm * B});   // P x (Q, b)
          nda::blas::gemm(Xp1, Gv, A1);                    // p1 x (Q, b)
          for (long p1 = 0; p1 < nc; ++p1)
            for (long Q = 0; Q < Nm; ++Q)
              for (long b = 0; b < B; ++b) A1p(p1 * B + b, Q) = A1(p1, Q * B + b);
          for (long Q = 0; Q < Nm; ++Q)
            for (long p3p = 0; p3p < nc; ++p3p)
              Xqc(Q, p3p) = std::conj(Xb(is, ikppq, Q, p3p));
          nda::blas::gemm(A1p, Xqc, A2);                   // (p1, b) x p3'
          for (long p1 = 0; p1 < nc; ++p1)
            for (long p3p = 0; p3p < nc; ++p3p)
              for (long b = 0; b < B; ++b)
                Y(ikp * nc2 + p1 * nc + p3p, b) += phm * A2(p1 * B + b, p3p);
        }
      }
    }

    /**
     * P4b: the truncated-NEUMANN pair-space ladder on the R-space kernel (design note
     * section 4b.1): S_{j+1} = M(V + S_j), M = Xh K~ (apply-only), V = Xh D; the
     * truncation order j IS the explicit rung count, and the j = 1 observable with an
     * untruncated kernel is the anchor BITWISE (gate G-P4a). The (s, iq) pairs
     * round-robin over (rank, nproc) exactly as pair_space_ladder (the caller
     * all_reduces). The Dmat/Cb builders are duplicated from pair_space_ladder
     * verbatim (deliberate: that function is gate-green and untouched; the two are
     * pinned against each other by G-P4b).
     */
    inline void pair_space_ladder_rs(nda::MemoryArrayOfRank<5> auto const &G_CC,
                                     nda::array<ComplexType, 4> const &Xb,
                                     ladder_kernel_rs const &ker,
                                     nda::array<long, 2> const &kpq,
                                     nda::array<double, 2> const &kpts,
                                     vertex_pi::iaft_tools const &tools,
                                     std::vector<long> const &nu_list,
                                     double neu_tol, long max_rungs,
                                     nda::array<ComplexType, 4> *Pi_onerung,
                                     nda::array<ComplexType, 4> *Pi_ladder,
                                     long rank = 0, long nproc = 1,
                                     long *max_rungs_used = nullptr) {
      decltype(nda::range::all) all;
      const long nt = G_CC.shape(0), ns = G_CC.shape(1), nk = G_CC.shape(2);
      const long nc = G_CC.shape(3), Nm = Xb.shape(2);
      const long nq = kpq.shape(0);
      const long nw_b = tools.nw_b;
      const long nc2 = nc * nc, Dsz = nc2 * nk;
      const long nnu = long(nu_list.size());
      const double spinfac = (ns == 1) ? 2.0 : 1.0;
      if (Pi_onerung != nullptr) (*Pi_onerung)() = ComplexType(0.0);
      if (Pi_ladder != nullptr) (*Pi_ladder)() = ComplexType(0.0);
      if (max_rungs_used != nullptr) *max_rungs_used = 0;

      nda::array<ComplexType, 3> Dmat(nk, nc2, Nm), Dcj(nk, nc2, Nm);
      nda::array<ComplexType, 4> Cb(nk, nnu, nc2, nc2);
      nda::array<ComplexType, 2> Pf(nt, nc2 * nc2), Bf(nw_b, nc2 * nc2);
      nda::array<ComplexType, 2> Dstack_c(Dsz, Nm);
      nda::array<ComplexType, 2> V(Dsz, Nm), S(Dsz, Nm), term(Dsz, Nm);
      nda::array<ComplexType, 2> KX(Dsz, Nm), termn(Dsz, Nm);

      for (long sq = rank; sq < ns * nq; sq += nproc) {
        const long is = sq / nq;
        const long iq = sq % nq;
        // --- d(k) and the chi0 blocks (pair_space_ladder verbatim) --------------------
        for (long ik = 0; ik < nk; ++ik) {
          const long ikpq = kpq(iq, ik);
          for (long a = 0; a < nc; ++a)
            for (long b = 0; b < nc; ++b)
              for (long N = 0; N < Nm; ++N) {
                Dmat(ik, a * nc + b, N) =
                    Xb(is, ik, N, a) * std::conj(Xb(is, ikpq, N, b));
                Dcj(ik, a * nc + b, N) = std::conj(Dmat(ik, a * nc + b, N));
              }
          for (long s = 0; s < nt; ++s) {
            const long sm = tools.t_mirror(s);
            for (long p1p = 0; p1p < nc; ++p1p)
              for (long p3 = 0; p3 < nc; ++p3)
                for (long a = 0; a < nc; ++a)
                  for (long b = 0; b < nc; ++b)
                    Pf(s, (p1p * nc + p3) * nc2 + (a * nc + b)) =
                        G_CC(sm, is, ik, a, p1p) * G_CC(s, is, ikpq, p3, b);
          }
          nda::blas::gemm(ComplexType(-1.0), tools.Twt_bb, Pf, ComplexType(0.0), Bf);
          for (long jn = 0; jn < nnu; ++jn)
            for (long r = 0; r < nc2; ++r)
              for (long c = 0; c < nc2; ++c)
                Cb(ik, jn, r, c) = Bf(nu_list[jn], r * nc2 + c);
        }
        for (long ik = 0; ik < nk; ++ik)
          for (long r = 0; r < nc2; ++r) Dstack_c(ik * nc2 + r, all) = Dcj(ik, r, all);

        for (long jn = 0; jn < nnu; ++jn) {
          // V = Xh D
          for (long ik = 0; ik < nk; ++ik) {
            auto Vr = V(nda::range(ik * nc2, (ik + 1) * nc2), all);
            nda::blas::gemm(ComplexType(1.0 / nk), Cb(ik, jn, all, all),
                            Dmat(ik, all, all), ComplexType(0.0), Vr);
          }
          S() = ComplexType(0.0);
          term() = V;
          double s_nrm2 = 0.0;
          for (long j = 1; j <= max_rungs; ++j) {
            vertex_ladder_detail::apply_kernel_rs(ker, Xb, is, kpq, iq, kpts, term, KX);
            for (long ik = 0; ik < nk; ++ik) {
              auto Tr = termn(nda::range(ik * nc2, (ik + 1) * nc2), all);
              auto Kr = KX(nda::range(ik * nc2, (ik + 1) * nc2), all);
              nda::blas::gemm(ComplexType(1.0 / nk), Cb(ik, jn, all, all), Kr,
                              ComplexType(0.0), Tr);
            }
            S += termn;
            if (j == 1 and Pi_onerung != nullptr) {
              auto Po = (*Pi_onerung)(jn, iq, all, all);
              nda::blas::gemm(ComplexType(-spinfac), nda::transpose(Dstack_c), termn,
                              ComplexType(1.0), Po);
            }
            double t2 = 0.0;
            s_nrm2 = 0.0;
            for (auto const &v : termn) t2 += std::norm(v);
            for (auto const &v : S) s_nrm2 += std::norm(v);
            term() = termn;
            if (max_rungs_used != nullptr) *max_rungs_used = std::max(*max_rungs_used, j);
            if (std::sqrt(t2) < neu_tol * std::max(std::sqrt(s_nrm2), 1e-300)) break;
          }
          if (Pi_ladder != nullptr) {
            auto Pl = (*Pi_ladder)(jn, iq, all, all);
            nda::blas::gemm(ComplexType(-spinfac), nda::transpose(Dstack_c), S,
                            ComplexType(1.0), Pl);
          }
        }
      }
    }

  } // vertex_ladder_detail

  /**
   * L1: the C-window COINCIDENT pair bubble Pi-bar^0_MN(q, tau_pos) in the SECONDARY
   * aux basis, (nt_half, nq, N_m, N_m), replicated -- house RPA conventions
   * (rpa_pi.icc Hadamard pairing, -spin/Nk, PH-sym tau half grid). This is the
   * pair-density-projected chi0 (gate L1-a compares its upfold against the C-masked
   * global bubble); the LADDER composition does NOT use it -- see the file header.
   */
  nda::array<ComplexType, 4> vertex_t::eval_pol_pi0(MBState &mb_state, THC_ERI auto &thc) {
    decltype(nda::range::all) all;
    utils::check(active() and secondary(),
                 "vertex_t::eval_pol_pi0: requires an ACTIVE secondary-basis vertex "
                 "(the L1 gate configuration).");
    utils::check(not _wannier, "vertex_t::eval_pol_pi0: window mode only at L1.");
    auto MF = thc.MF();
    utils::check(MF->nkpts() == MF->nkpts_ibz(),
                 "vertex_t::eval_pol_pi0: symmetry-free meshes only at L1 (nkpts = {} "
                 "vs nkpts_ibz = {}).", MF->nkpts(), MF->nkpts_ibz());
    utils::check(mb_state.sG_tskij.has_value(),
                 "vertex_t::eval_pol_pi0: mb_state carries no G.");
    ensure_secondary_basis(mb_state, thc);

    auto G_tskij = mb_state.sG_tskij.value().local();
    const long nt = G_tskij.shape(0), ns = G_tskij.shape(1), nk = G_tskij.shape(2);
    const long nc = subspace_rank(), Nm = _Xb_skma.shape(2);
    const long nq = MF->nqpts_ibz();
    const long nt_half = (nt % 2 == 0) ? nt / 2 : nt / 2 + 1;
    auto mpi = thc.mpi();

    // C-window block of G on the full mesh (window mode, nosym: a plain slice)
    nda::array<ComplexType, 5> G_CC(nt, ns, nk, nc, nc);
    G_CC = G_tskij(all, all, all, _band_window, _band_window);
    auto Gc = vertex_ladder_detail::build_Gc_aux(G_CC, _Xb_skma);

    // the RPA Hadamard pairing on the PH-sym half grid (rpa_pi.icc:312, 323-334):
    // factor -spin/Nk; Gp = conj(Gc(k-q, tau_pos)); Gn = Gc(k, beta - tau_pos)
    const double factor = (ns == 2) ? -1.0 / double(nk) : -2.0 / double(nk);
    nda::array<ComplexType, 4> Pi0(nt_half, nq, Nm, Nm);
    Pi0() = ComplexType(0.0);
    const long rank = mpi->comm.rank(), size = mpi->comm.size();
    for (long qsk = rank; qsk < nq * ns * nk; qsk += size) {
      const long iq = qsk / (ns * nk);
      const long is = (qsk / nk) % ns;
      const long ik = qsk % nk;
      const long ikmq = MF->qk_to_k2(iq, ik);
      for (long it = 0; it < nt_half; ++it) {
        auto Gp = Gc(is, ikmq, it, all, all);
        auto Gn = Gc(is, ik, nt - it - 1, all, all);
        auto P = Pi0(it, iq, all, all);
        for (long m = 0; m < Nm; ++m)
          for (long n = 0; n < Nm; ++n)
            P(m, n) += factor * std::conj(Gp(m, n)) * Gn(m, n);
      }
    }
    mpi->comm.all_reduce_in_place_n(Pi0.data(), Pi0.size(), std::plus<>{});
    return Pi0;
  }

  /**
   * L2: the resummed pair-space ladder at inu = 0, (nq_ibz, N_m, N_m) in THIS vertex's
   * secondary aux basis (all rungs >= 1). See the file header; the n = 1 term is the
   * static-rung Pi^C, pinned by gate L1-b. Requires build_w0 to have run this
   * iteration (W0bar present). Replicated.
   * C.2: symmetry-capable -- on IBZ-reduced meshes the external q axis is nq_ibz, the
   * internal transfers run the full mesh through the secondary sym ctx (the
   * pi_c_accumulate_w contract; pair_space_ladder header).
   */
  nda::array<ComplexType, 3> vertex_t::eval_pol_ladder_nu0(MBState &mb_state,
                                                           THC_ERI auto &thc) {
    decltype(nda::range::all) all;
    utils::check(active() and secondary(),
                 "vertex_t::eval_pol_ladder_nu0: requires an ACTIVE secondary-basis "
                 "vertex (the readout instance).");
    utils::check(not _wannier, "vertex_t::eval_pol_ladder_nu0: window mode only at L2.");
    utils::check(_W0b_qmm.has_value(),
                 "vertex_t::eval_pol_ladder_nu0: W0bar is absent -- build_w0 must run "
                 "first (same iteration).");
    auto MF = thc.MF();
    utils::check(mb_state.sG_tskij.has_value(),
                 "vertex_t::eval_pol_ladder_nu0: mb_state carries no G.");
    ensure_secondary_basis(mb_state, thc);

    auto G_tskij = mb_state.sG_tskij.value().local();
    const long nt = G_tskij.shape(0), ns = G_tskij.shape(1);
    const long nk = MF->nkpts();                    // FULL BZ (the ladder's k axis)
    const long nc = subspace_rank(), Nm = _Xb_skma.shape(2);
    const long nq_ext = MF->nqpts_ibz(), nq_full = MF->nqpts();
    const bool sym_mesh = (MF->nkpts() != MF->nkpts_ibz()) or (nq_full != nq_ext);
    nda::array<ComplexType, 5> G_CC(nt, ns, nk, nc, nc);
    vertex_ladder_detail::expand_G_CC_fullbz(G_tskij, _band_window, sym_mesh,
                                             MF->kp_to_ibz(), MF->kp_trev(), G_CC);
    // momentum maps on the FULL transfer mesh (the external IBZ q's are its leading rows)
    nda::array<long, 2> kmq(nq_full, nk), kpq(nq_full, nk);
    auto qmin = MF->qminus();
    for (long iq = 0; iq < nq_full; ++iq)
      for (long ik = 0; ik < nk; ++ik) {
        kmq(iq, ik) = MF->qk_to_k2(iq, ik);
        kpq(iq, ik) = MF->qk_to_k2(qmin(iq), ik);
      }
    // C.2: the secondary-basis symmetry context (rung reads at q_star with Xhat legs)
    vertex_sym::sym_ctx const *symc = nullptr;
    if (sym_mesh) {
      build_sym_ctx(thc, _Xb_skma, _band_window.first(), _sym_secondary);
      symc = &_sym_secondary.value();
    }

    vertex_pi::iaft_tools tools(*_ft);
    std::vector<long> nu0 = {tools.nw_b / 2};   // the inu = 0 node of the full mesh
    nda::array<ComplexType, 4> Pl(1, nq_ext, Nm, Nm);
    auto mpi = thc.mpi();
    vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, _W0b_qmm.value(), kmq, kpq,
                                            tools, nu0, nullptr, &Pl,
                                            mpi->comm.rank(), mpi->comm.size(), symc);
    mpi->comm.all_reduce_in_place_n(Pl.data(), Pl.size(), std::plus<>{});
    nda::array<ComplexType, 3> out(nq_ext, Nm, Nm);
    out = Pl(0, all, all, all);
    return out;
  }

  /**
   * The C.2 IBZ-symmetry gate: the pair-space one-rung rebuild vs the implemented
   * static-rung Pi^C (pi_c_accumulate_w phase 1) with the SAME symmetry context
   * threaded through BOTH kernels -- the L1-b bit-anchor identity with the Xhat leg
   * rotations and the q_star/trev rung reads LIVE. Still an algebraic rearrangement
   * of identical sums (shared leg builder), so machine precision with no fitted
   * scale, on sym and nosym meshes alike.
   */
  vertex_t::ladder_sym_diag vertex_t::ladder_sym_gate(MBState &mb_state, THC_ERI auto &thc) {
    decltype(nda::range::all) all;
    ladder_sym_diag out;
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    utils::check(active() and secondary(),
                 "vertex_t::ladder_sym_gate: requires an ACTIVE secondary-basis vertex.");
    utils::check(not _wannier, "vertex_t::ladder_sym_gate: window mode only.");
    utils::check(_W0b_qmm.has_value(),
                 "vertex_t::ladder_sym_gate: W0bar is absent -- run after an update_w "
                 "with an active static-rung secondary vertex (build_w0).");
    utils::check(mb_state.sG_tskij.has_value(),
                 "vertex_t::ladder_sym_gate: mb_state carries no G.");
    ensure_secondary_basis(mb_state, thc);

    auto G_tskij = mb_state.sG_tskij.value().local();
    const long nt = G_tskij.shape(0), ns = G_tskij.shape(1);
    const long nk = MF->nkpts();
    const long nc = subspace_rank(), Nm = _Xb_skma.shape(2);
    const long nq_ext = MF->nqpts_ibz(), nq_full = MF->nqpts();
    const bool sym_mesh = (MF->nkpts() != MF->nkpts_ibz()) or (nq_full != nq_ext);
    out.sym_active = sym_mesh;
    nda::array<ComplexType, 5> G_CC(nt, ns, nk, nc, nc);
    vertex_ladder_detail::expand_G_CC_fullbz(G_tskij, _band_window, sym_mesh,
                                             MF->kp_to_ibz(), MF->kp_trev(), G_CC);
    nda::array<long, 2> kmq(nq_full, nk), kpq(nq_full, nk);
    auto qmin = MF->qminus();
    for (long iq = 0; iq < nq_full; ++iq)
      for (long ik = 0; ik < nk; ++ik) {
        kmq(iq, ik) = MF->qk_to_k2(iq, ik);
        kpq(iq, ik) = MF->qk_to_k2(qmin(iq), ik);
      }
    vertex_sym::sym_ctx const *symc = nullptr;
    if (sym_mesh) {
      build_sym_ctx(thc, _Xb_skma, _band_window.first(), _sym_secondary);
      symc = &_sym_secondary.value();
    }

    // the anchor with the SAME context: pi_c_accumulate_w phase 1 (rung = W0bar)
    vertex_pi::iaft_tools tools(*_ft);
    const long nw_b = tools.nw_b;
    nda::array<ComplexType, 4> PiC(nw_b, nq_ext, Nm, Nm);
    PiC() = ComplexType(0.0);
    vertex_pi::pi_c_accumulate_w(*_ft, tools, G_CC, _Xb_skma, _W0b_qmm.value(),
                                 static_cast<nda::array<ComplexType, 4> const *>(nullptr),
                                 kmq, kpq, nda::range(0, nc), PiC,
                                 mpi->comm.rank(), mpi->comm.size(),
                                 false, nullptr, symc);
    mpi->comm.all_reduce_in_place_n(PiC.data(), PiC.size(), std::plus<>{});

    std::vector<long> nu_all(nw_b);
    for (long m = 0; m < nw_b; ++m) nu_all[m] = m;
    nda::array<ComplexType, 4> Pi_rebuild(nw_b, nq_ext, Nm, Nm), Pi_ladder(nw_b, nq_ext, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, _W0b_qmm.value(), kmq, kpq,
                                            tools, nu_all, &Pi_rebuild, &Pi_ladder,
                                            mpi->comm.rank(), mpi->comm.size(), symc);
    mpi->comm.all_reduce_in_place_n(Pi_rebuild.data(), Pi_rebuild.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(Pi_ladder.data(), Pi_ladder.size(), std::plus<>{});

    double r2 = 0.0, a2 = 0.0, l2 = 0.0, pmax = 0.0, lmax = 0.0;
    for (long m = 0; m < nw_b; ++m)
      for (long iq = 0; iq < nq_ext; ++iq)
        for (long M = 0; M < Nm; ++M)
          for (long N = 0; N < Nm; ++N) {
            r2 += std::norm(Pi_rebuild(m, iq, M, N) - PiC(m, iq, M, N));
            a2 += std::norm(PiC(m, iq, M, N));
            l2 += std::norm(Pi_ladder(m, iq, M, N) - Pi_rebuild(m, iq, M, N));
            pmax = std::max(pmax, std::abs(Pi_rebuild(m, iq, M, N)));
            lmax = std::max(lmax, std::abs(Pi_ladder(m, iq, M, N)));
          }
    out.l1b_resid = std::sqrt(r2 / std::max(a2, 1e-300));
    out.ladder_frac = std::sqrt(l2 / std::max(a2, 1e-300));
    out.onerung_max = pmax;
    out.ladder_max = lmax;

    app_log(1, "  [scGW-tilde C.2] IBZ gate (sym {}): one-rung rebuild vs the Pi^C "
               "anchor rel resid = {:.3e}; >= 2-rung content = {:.3e} "
               "(max one-rung {:.3e}, max ladder {:.3e})",
            sym_mesh ? "ACTIVE" : "inactive", out.l1b_resid, out.ladder_frac,
            out.onerung_max, out.ladder_max);
    return out;
  }

  /**
   * The L1 gate harness (notes/scgwt_implementation_plan.md; file header for the
   * derivation):
   *
   *  L1-a  C-window RPA consistency: upfold(Pi-bar^0) = t^dag Pi-bar^0 t against the
   *        SAME Hadamard bubble built in the GLOBAL aux basis from the C-masked G --
   *        eta-class agreement (the secondary representation error).
   *  L1-b  THE BIT-ANCHOR: the pair-space one-rung rebuild against the implemented
   *        static-rung Pi^C (pi_c_accumulate_w phase 1). An algebraic rearrangement
   *        of identical sums: MACHINE precision, no fitted scale.
   *  L2 preview: the resummed ladder (all rungs >= 1) in the same pair space;
   *        ladder_frac = the relative size of the >= 2-rung content.
   */
  vertex_t::ladder_l1_diag vertex_t::ladder_l1_gates(MBState &mb_state, THC_ERI auto &thc) {
    decltype(nda::range::all) all;
    ladder_l1_diag out;
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    utils::check(_W0b_qmm.has_value(),
                 "vertex_t::ladder_l1_gates: W0bar is absent -- run after an update_w "
                 "with an active static-rung secondary vertex (build_w0).");
    auto Pi0_t = eval_pol_pi0(mb_state, thc);            // (nt_half, nq, Nm, Nm)
    const long nt_half = Pi0_t.shape(0), nq = Pi0_t.shape(1), Nm = Pi0_t.shape(2);
    const long nk = MF->nkpts(), ns = mb_state.sG_tskij.value().local().shape(1);
    const long nt = mb_state.sG_tskij.value().local().shape(0);
    const long nc = subspace_rank();
    const long Np = thc.Np();

    // shared inputs: the C-window G on the full mesh + the momentum maps
    auto G_tskij = mb_state.sG_tskij.value().local();
    nda::array<ComplexType, 5> G_CC(nt, ns, nk, nc, nc);
    G_CC = G_tskij(all, all, all, _band_window, _band_window);
    nda::array<long, 2> kmq(nq, nk), kpq(nq, nk);
    auto qmin = MF->qminus();
    for (long iq = 0; iq < nq; ++iq)
      for (long ik = 0; ik < nk; ++ik) {
        kmq(iq, ik) = MF->qk_to_k2(iq, ik);
        kpq(iq, ik) = MF->qk_to_k2(qmin(iq), ik);
      }

    // ---- L1-a: global-basis C-masked reference + upfold --------------------------------
    {
      nda::array<ComplexType, 4> XC(ns, nk, Np, nc);
      for (long is = 0; is < ns; ++is)
        for (long ik = 0; ik < nk; ++ik)
          XC(is, ik, all, all) = thc.X(is, 0, ik)(all, _band_window);
      auto Gg = vertex_ladder_detail::build_Gc_aux(G_CC, XC);   // (ns, nk, nt, Np, Np)
      const double factor = (ns == 2) ? -1.0 / double(nk) : -2.0 / double(nk);
      double num2 = 0.0, den2 = 0.0;
      nda::array<ComplexType, 2> ref(Np, Np), up(Np, Np), tmp(Nm, Np);
      for (long iq = 0; iq < nq; ++iq) {
        auto tq = _t_qmP(iq, all, all);                          // (Nm, Np)
        nda::array<ComplexType, 2> td(Np, Nm);
        for (long m = 0; m < Nm; ++m)
          for (long P = 0; P < Np; ++P) td(P, m) = std::conj(tq(m, P));
        for (long it = 0; it < nt_half; ++it) {
          ref() = ComplexType(0.0);
          for (long is = 0; is < ns; ++is)
            for (long ik = 0; ik < nk; ++ik) {
              const long ikmq = MF->qk_to_k2(iq, ik);
              auto Gp = Gg(is, ikmq, it, all, all);
              auto Gn = Gg(is, ik, nt - it - 1, all, all);
              for (long P = 0; P < Np; ++P)
                for (long Q = 0; Q < Np; ++Q)
                  ref(P, Q) += factor * std::conj(Gp(P, Q)) * Gn(P, Q);
            }
          nda::blas::gemm(Pi0_t(it, iq, all, all), tq, tmp);     // Pi0 . t
          nda::blas::gemm(td, tmp, up);                          // t^dag Pi0 t
          for (long P = 0; P < Np; ++P)
            for (long Q = 0; Q < Np; ++Q) {
              num2 += std::norm(up(P, Q) - ref(P, Q));
              den2 += std::norm(ref(P, Q));
            }
        }
      }
      out.l1a_eta = std::sqrt(num2 / std::max(den2, 1e-300));
    }

    // ---- the anchor: pi_c_accumulate_w PHASE 1 (instantaneous rung = W0bar) ------------
    vertex_pi::iaft_tools tools(*_ft);
    const long nw_b = tools.nw_b;
    nda::array<ComplexType, 4> PiC(nw_b, nq, Nm, Nm);
    PiC() = ComplexType(0.0);
    vertex_pi::pi_c_accumulate_w(*_ft, tools, G_CC, _Xb_skma, _W0b_qmm.value(),
                                 static_cast<nda::array<ComplexType, 4> const *>(nullptr),
                                 kmq, kpq, nda::range(0, nc), PiC,
                                 mpi->comm.rank(), mpi->comm.size(),
                                 false, nullptr, nullptr);
    mpi->comm.all_reduce_in_place_n(PiC.data(), PiC.size(), std::plus<>{});

    // ---- L1-b + L2 preview: the pair-space core over the FULL bosonic grid -------------
    std::vector<long> nu_all(nw_b);
    for (long m = 0; m < nw_b; ++m) nu_all[m] = m;
    nda::array<ComplexType, 4> Pi_rebuild(nw_b, nq, Nm, Nm), Pi_ladder(nw_b, nq, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, _W0b_qmm.value(), kmq, kpq,
                                            tools, nu_all, &Pi_rebuild, &Pi_ladder,
                                            mpi->comm.rank(), mpi->comm.size());
    mpi->comm.all_reduce_in_place_n(Pi_rebuild.data(), Pi_rebuild.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(Pi_ladder.data(), Pi_ladder.size(), std::plus<>{});

    double r2 = 0.0, a2 = 0.0, l2 = 0.0, pmax = 0.0, lmax = 0.0;
    for (long m = 0; m < nw_b; ++m)
      for (long iq = 0; iq < nq; ++iq)
        for (long M = 0; M < Nm; ++M)
          for (long N = 0; N < Nm; ++N) {
            r2 += std::norm(Pi_rebuild(m, iq, M, N) - PiC(m, iq, M, N));
            a2 += std::norm(PiC(m, iq, M, N));
            l2 += std::norm(Pi_ladder(m, iq, M, N) - Pi_rebuild(m, iq, M, N));
            pmax = std::max(pmax, std::abs(Pi_rebuild(m, iq, M, N)));
            lmax = std::max(lmax, std::abs(Pi_ladder(m, iq, M, N)));
          }
    out.l1b_resid = std::sqrt(r2 / std::max(a2, 1e-300));
    out.ladder_frac = std::sqrt(l2 / std::max(a2, 1e-300));
    out.onerung_max = pmax;
    out.ladder_max = lmax;

    app_log(1, "  [scGW-tilde L1] gates: L1-a eta(upfold vs C-masked global RPA bubble) "
               "= {:.3e}\n"
               "    L1-b one-rung pair-space rebuild vs the Pi^C anchor: rel resid = "
               "{:.3e} (machine-precision identity, no fitted scale)\n"
               "    L2 preview: ||Pi_ladder - Pi_onerung||/||Pi^C|| = {:.3e} "
               "(the >= 2-rung content); max|Pi_onerung| = {:.3e}, max|Pi_ladder| = {:.3e}",
            out.l1a_eta, out.l1b_resid, out.ladder_frac, out.onerung_max, out.ladder_max);
    return out;
  }

  /**
   * The P4 gate harness (design note sections 4b/4b.1):
   *   G-P4a  the R-space kernel at tol_L = 0 is EXACT (the WS round trip on the mesh):
   *          the rs j = 1 observable must reproduce the direct one-rung (== the L1-b
   *          anchor) at machine precision;
   *   G-P4b  the converged Neumann ladder must reproduce the direct resolvent;
   *   meter  a deliberately truncated kernel (tol_L = 0.5) must show a NONZERO dropped
   *          fraction and a larger j = 1 error (the monotone truncation meter).
   * Runs at the inu = 0 node (the readout node); (s, q) distributed as elsewhere.
   */
  vertex_t::ladder_p4_diag vertex_t::ladder_p4_gates(MBState &mb_state, THC_ERI auto &thc) {
    decltype(nda::range::all) all;
    ladder_p4_diag out;
    auto MF = thc.MF();
    auto mpi = thc.mpi();
    utils::check(MF->nkpts() == MF->nkpts_ibz(),
                 "vertex_t::ladder_p4_gates: the R-space kernel path is nosym-only "
                 "(the diagonal (P,Q) channel does not survive the Xhat leg "
                 "rotations; C.2 lifts the EXACT path only).");
    utils::check(_W0b_qmm.has_value(),
                 "vertex_t::ladder_p4_gates: W0bar is absent -- run after an update_w "
                 "with an active static-rung secondary vertex (build_w0).");
    ensure_secondary_basis(mb_state, thc);
    auto G_tskij = mb_state.sG_tskij.value().local();
    const long nt = G_tskij.shape(0), ns = G_tskij.shape(1), nk = G_tskij.shape(2);
    const long nc = subspace_rank(), Nm = _Xb_skma.shape(2);
    const long nq = MF->nqpts_ibz();
    nda::array<ComplexType, 5> G_CC(nt, ns, nk, nc, nc);
    G_CC = G_tskij(all, all, all, _band_window, _band_window);
    nda::array<long, 2> kmq(nq, nk), kpq(nq, nk);
    auto qmin = MF->qminus();
    for (long iq = 0; iq < nq; ++iq)
      for (long ik = 0; ik < nk; ++ik) {
        kmq(iq, ik) = MF->qk_to_k2(iq, ik);
        kpq(iq, ik) = MF->qk_to_k2(qmin(iq), ik);
      }
    nda::array<double, 2> kpts(nk, 3), Qpts(nq, 3);
    kpts() = MF->kpts();
    for (long iq = 0; iq < nq; ++iq) {
      auto qp = MF->Qpts_ibz(iq);
      for (int a = 0; a < 3; ++a) Qpts(iq, a) = qp(a);
    }

    vertex_pi::iaft_tools tools(*_ft);
    std::vector<long> nu0 = {tools.nw_b / 2};
    const long rank = mpi->comm.rank(), size = mpi->comm.size();

    // direct reference (one rung + resolvent) at nu = 0
    nda::array<ComplexType, 4> P1d(1, nq, Nm, Nm), Pld(1, nq, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder(G_CC, _Xb_skma, _W0b_qmm.value(), kmq, kpq,
                                            tools, nu0, &P1d, &Pld, rank, size);
    mpi->comm.all_reduce_in_place_n(P1d.data(), P1d.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(Pld.data(), Pld.size(), std::plus<>{});

    // rs kernel, EXACT (tol_L = 0): j = 1 and converged Neumann
    auto ker0 = vertex_ladder_detail::build_kernel_rs(_W0b_qmm.value(), Qpts,
                                                      MF->lattv(), MF->kp_grid(), 0.0);
    nda::array<ComplexType, 4> P1r(1, nq, Nm, Nm), Plr(1, nq, Nm, Nm);
    long ju = 0;
    vertex_ladder_detail::pair_space_ladder_rs(G_CC, _Xb_skma, ker0, kpq, kpts, tools,
                                               nu0, 1e-12, 200, &P1r, &Plr, rank, size,
                                               &ju);
    mpi->comm.all_reduce_in_place_n(P1r.data(), P1r.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(Plr.data(), Plr.size(), std::plus<>{});
    out.rungs_used = mpi->comm.all_reduce_value(ju, boost::mpi3::max<>{});

    auto rel = [&](auto const &A, auto const &Bref) {
      double n2 = 0.0, d2 = 0.0;
      for (long i = 0; i < long(A.size()); ++i) {
        n2 += std::norm(*(A.data() + i) - *(Bref.data() + i));
        d2 += std::norm(*(Bref.data() + i));
      }
      return std::sqrt(n2 / std::max(d2, 1e-300));
    };
    out.j1_resid = rel(P1r, P1d);
    out.neumann_resid = rel(Plr, Pld);

    // truncated-kernel meter: dropped fraction + the j = 1 error. tol_L = 0.9999 so
    // shells drop even on 2^3 fixtures (no R-decay room there: each outer L shell
    // carries an O(1) norm fraction, so moderate tolerances drop NOTHING at 2^3 --
    // measured 2026-08-11; production meshes use physical tolerances).
    auto ker5 = vertex_ladder_detail::build_kernel_rs(_W0b_qmm.value(), Qpts,
                                                      MF->lattv(), MF->kp_grid(), 0.9999);
    out.dropped_frac_test = ker5.dropped_frac;
    nda::array<ComplexType, 4> P1t(1, nq, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder_rs(G_CC, _Xb_skma, ker5, kpq, kpts, tools,
                                               nu0, 1e-12, 1, &P1t, nullptr, rank, size);
    mpi->comm.all_reduce_in_place_n(P1t.data(), P1t.size(), std::plus<>{});
    out.j1_resid_trunc = rel(P1t, P1d);

    // ---- the sampled kept-(P,Q) apply (design 4b.1 step (ii)) ------------------------
    // all-kept sampled kernel (tau_PQ = tiny, nothing dropped): pins the sampled
    // contraction arithmetic against the dense-w apply (the T2/A1 gemms become
    // nc-length dots -- FP-accumulation class) and against the direct anchor.
    auto kers = vertex_ladder_detail::build_kernel_rs(_W0b_qmm.value(), Qpts,
                                                      MF->lattv(), MF->kp_grid(), 0.0,
                                                      1e-300);
    nda::array<ComplexType, 4> P1s(1, nq, Nm, Nm), Pls(1, nq, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder_rs(G_CC, _Xb_skma, kers, kpq, kpts, tools,
                                               nu0, 1e-12, 200, &P1s, &Pls, rank, size);
    mpi->comm.all_reduce_in_place_n(P1s.data(), P1s.size(), std::plus<>{});
    mpi->comm.all_reduce_in_place_n(Pls.data(), Pls.size(), std::plus<>{});
    out.pq_all_j1_resid = rel(P1s, P1d);
    out.pq_all_neumann_resid = rel(Pls, Pld);
    {
      double mxd = 0.0, mxv = 0.0;
      for (long i = 0; i < long(P1s.size()); ++i) {
        mxd = std::max(mxd, std::abs(*(P1s.data() + i) - *(P1r.data() + i)));
        mxv = std::max(mxv, std::abs(*(P1r.data() + i)));
      }
      out.pq_all_max_reldiff = mxd / std::max(mxv, 1e-300);
    }
    // truncated pair list (tau_PQ = 0.5): the kept fraction must genuinely shrink and
    // the j=1 error must sit above the all-kept floor (the monotone pair meter).
    auto kert = vertex_ladder_detail::build_kernel_rs(_W0b_qmm.value(), Qpts,
                                                      MF->lattv(), MF->kp_grid(), 0.0,
                                                      0.5);
    out.pq_kept_frac_test = kert.pq_kept_frac;
    out.pq_dropped_wfrac_test = kert.pq_dropped_wfrac;
    nda::array<ComplexType, 4> P1u(1, nq, Nm, Nm);
    vertex_ladder_detail::pair_space_ladder_rs(G_CC, _Xb_skma, kert, kpq, kpts, tools,
                                               nu0, 1e-12, 1, &P1u, nullptr, rank, size);
    mpi->comm.all_reduce_in_place_n(P1u.data(), P1u.size(), std::plus<>{});
    out.pq_j1_resid_trunc = rel(P1u, P1d);

    app_log(1, "  [scGW-tilde P4] gates: G-P4a rs(tol=0) j=1 vs direct one-rung = "
               "{:.3e}; G-P4b Neumann ({} rungs) vs direct resolvent = {:.3e};\n"
               "    truncation meter (tol_L = 0.5): dropped ||w(L)|| = {:.3e}, "
               "j=1 resid = {:.3e}",
            out.j1_resid, out.rungs_used, out.neumann_resid, out.dropped_frac_test,
            out.j1_resid_trunc);
    app_log(1, "  [scGW-tilde P4] sampled (P,Q) gates: all-kept j=1 vs direct = {:.3e}, "
               "Neumann vs direct = {:.3e}, max reldiff vs dense-rs = {:.3e};\n"
               "    pair meter (tau_PQ = 0.5): kept frac = {:.3e}, dropped pair ||w|| "
               "= {:.3e}, j=1 resid = {:.3e}",
            out.pq_all_j1_resid, out.pq_all_neumann_resid, out.pq_all_max_reldiff,
            out.pq_kept_frac_test, out.pq_dropped_wfrac_test, out.pq_j1_resid_trunc);
    return out;
  }

} // solvers
} // methods

#endif // COQUI_VERTEX_LADDER_ICC
