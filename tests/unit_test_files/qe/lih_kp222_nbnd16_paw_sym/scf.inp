 &control
    calculation = 'scf', verbosity = 'high', outdir = './', prefix = 'pwscf', pseudo_dir = './'
 /
 &system
    ibrav=2, A=4.083, nat=2, ntyp=2, nbnd=16, ecutwfc=100,
    occupations='smearing', degauss=0.0015, smearing='m-p'
 /
 &electrons
    conv_thr=1e-14, mixing_beta=0.3, electron_maxstep=200,
 /
ATOMIC_SPECIES
 Li   0.0 Li.pbe-sl-kjpaw_psl.1.0.0.UPF
 H    0.0 H.pbe-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS {alat}
 Li 0.00 0.00 0.00
 H  0.50 0.50 0.50
K_POINTS {automatic}
 2 2 2 0 0 0
