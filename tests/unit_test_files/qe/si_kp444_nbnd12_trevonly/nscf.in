&CONTROL
   calculation      = 'nscf'
   outdir           = './out'
   prefix           = 'si'
   pseudo_dir       = './out/si.save'
/
&SYSTEM
   ibrav            = 0
   nat              = 2
   ntyp             = 1
   nbnd             = 12
   ecutwfc          = 15.0
   force_symmorphic = .true.
   nosym            = .true.
   noinv            = .false.
   occupations      = 'smearing'
   degauss          = 0.0015
   smearing         = 'm-p'
   input_dft        = 'pbe'
/
&ELECTRONS
   conv_thr         = 1e-10
   mixing_beta      = 0.7
   diagonalization  = 'david'
   diago_full_acc   = .true.
/
ATOMIC_SPECIES
Si 28.0850 Si_ONCV_PBE-1.2.upf

